[
 {
  "t": 0.0,
  "end": 6.97,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 12화: 물에 녹을까, 녹지 않을까?"
 },
 {
  "t": 6.97,
  "end": 15.73,
  "section": "궁금해요",
  "sub": "물에 소금과 후춧가루를 넣으면 어떻게 될까요?"
 },
 {
  "t": 15.73,
  "end": 24.0,
  "section": "궁금해요",
  "sub": "소금은 바닥으로 내려가고, 후춧가루는 물 위에 떠 있어요"
 },
 {
  "t": 24.0,
  "end": 30.0,
  "section": "궁금해요",
  "sub": "저은 뒤 어떻게 되었을까요?"
 },
 {
  "t": 30.0,
  "end": 41.17,
  "section": "궁금해요",
  "sub": "소금은 물에 녹고, 후춧가루는 물에 녹지 않아요"
 },
 {
  "t": 41.17,
  "end": 54.23,
  "section": "실험해요",
  "sub": "설탕, 가루 바이타민, 탄산 칼슘을 물에 넣으면?"
 },
 {
  "t": 54.23,
  "end": 61.07,
  "section": "실험해요",
  "sub": "① 유리병에 물을 2/3씩 넣고 ② 한 숟가락씩 넣어요"
 },
 {
  "t": 61.07,
  "end": 71.93,
  "section": "실험해요",
  "sub": "③ 뚜껑을 닫고 흔들어요"
 },
 {
  "t": 71.93,
  "end": 83.23,
  "section": "실험해요",
  "sub": "흔든 직후: 바이타민 물은 노란색, 탄산 칼슘 물은 뿌옇게 흐려졌어요"
 },
 {
  "t": 83.23,
  "end": 86.13,
  "section": "실험해요",
  "sub": "④ 내려놓고 5분 기다려요"
 },
 {
  "t": 86.13,
  "end": 93.33,
  "section": "실험해요",
  "sub": "5분 뒤 세 유리병은 어떻게 될까요?"
 },
 {
  "t": 93.33,
  "end": 106.33,
  "section": "실험해요",
  "sub": "5분 뒤: 탄산 칼슘은 흰색 물질이 바닥에 가라앉았어요"
 },
 {
  "t": 106.33,
  "end": 116.23,
  "section": "실험해요",
  "sub": "설탕과 가루 바이타민은 녹고, 탄산 칼슘은 녹지 않아요"
 },
 {
  "t": 116.23,
  "end": 119.2,
  "section": "용해와 용액",
  "sub": "설탕이 물에 녹아 설탕물이 되었어요"
 },
 {
  "t": 119.2,
  "end": 125.73,
  "section": "용해와 용액",
  "sub": "녹아 골고루 섞이는 현상 → 용해"
 },
 {
  "t": 125.73,
  "end": 129.5,
  "section": "용해와 용액",
  "sub": "다른 물질을 녹이는 물질 → 용매"
 },
 {
  "t": 129.5,
  "end": 133.13,
  "section": "용해와 용액",
  "sub": "용매에 녹는 물질 → 용질"
 },
 {
  "t": 133.13,
  "end": 139.23,
  "section": "용해와 용액",
  "sub": "용매와 용질이 골고루 섞여 있는 물질 → 용액"
 },
 {
  "t": 139.23,
  "end": 146.23,
  "section": "용해와 용액",
  "sub": "용액은 성질이 일정하고, 뜨거나 가라앉는 것이 없어요"
 },
 {
  "t": 146.23,
  "end": 149.73,
  "section": "생활 속 용액",
  "sub": "용액인 것과 용액이 아닌 것을 나누어 봐요"
 },
 {
  "t": 149.73,
  "end": 155.23,
  "section": "생활 속 용액",
  "sub": "어느 것이 용액일까요?"
 },
 {
  "t": 155.23,
  "end": 162.47,
  "section": "생활 속 용액",
  "sub": "설탕물, 소금물, 바이타민 용액, 식초는 용액이에요"
 },
 {
  "t": 162.47,
  "end": 173.4,
  "section": "생활 속 용액",
  "sub": "흙탕물처럼 뜨거나 가라앉는 것이 있으면 용액이 아니에요"
 },
 {
  "t": 173.4,
  "end": 175.73,
  "section": "생각 바로잡기",
  "sub": "용액은 모두 액체일까요?"
 },
 {
  "t": 175.73,
  "end": 186.2,
  "section": "생각 바로잡기",
  "sub": "아니요, 공기처럼 기체로 된 용액도 있어요"
 },
 {
  "t": 186.2,
  "end": 191.57,
  "section": "한눈에 쏙",
