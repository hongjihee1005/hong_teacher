 },
 {
  "t": 106.63,
  "end": 109.7,
  "section": "조사해요",
  "sub": "물이 흐르면 어떻게 될까요?"
 },
 {
  "t": 109.7,
  "end": 118.63,
  "section": "조사해요",
  "sub": "가는 줄기가 물의 흐름을 따라 잘 휘어요"
 },
 {
  "t": 118.63,
  "end": 125.87,
  "section": "정리해요",
  "sub": "한눈에 쏙 정리해요"
 },
 {
  "t": 125.87,
  "end": 132.8,
  "section": "정리해요",
  "sub": "물에서 살기에 알맞은 생김새와 생활 방식"
 },
 {
  "t": 132.8,
  "end": 137.2,
