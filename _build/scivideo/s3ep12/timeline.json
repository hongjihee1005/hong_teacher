 },
 {
  "t": 49.53,
  "end": 54.7,
  "section": "실험해요",
  "sub": "동글동글한 작은 공기주머니가 벌집처럼 빽빽해요"
 },
 {
  "t": 54.7,
  "end": 58.6,
  "section": "실험해요",
  "sub": "자른 잎자루를 물속에 넣고 손가락으로 눌러요"
 },
 {
  "t": 58.6,
  "end": 64.2,
  "section": "실험해요",
  "sub": "어떤 일이 일어날까요?"
 },
 {
  "t": 64.2,
  "end": 69.63,
  "section": "실험해요",
  "sub": "공기 방울이 나와 위로 올라가요"
 },
 {
  "t": 69.63,
  "end": 77.37,
  "section": "정리해요",
  "sub": "잎자루 속 공기주머니 덕분에 물에 쉽게 떠요"
 },
 {
  "t": 77.37,
  "end": 87.03,
  "section": "정리해요",
