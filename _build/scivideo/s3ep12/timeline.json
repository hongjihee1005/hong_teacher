[
 {
  "t": 0.0,
  "end": 6.77,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 12화: 물에 사는 식물과 부레옥잠"
 },
 {
  "t": 6.77,
  "end": 9.83,
  "section": "궁금해요",
  "sub": "강이나 연못에서 식물을 본 적이 있나요?"
 },
 {
  "t": 9.83,
  "end": 15.3,
  "section": "궁금해요",
  "sub": "물에 사는 식물은 땅에 사는 식물과 어떤 점이 다를까요?"
 },
 {
  "t": 15.3,
  "end": 23.97,
  "section": "관찰해요",
  "sub": "부레옥잠을 관찰해요"
 },
 {
  "t": 23.97,
  "end": 26.87,
  "section": "관찰해요",
  "sub": "잎몸은 물 위에서 위를 향해요"
 },
 {
  "t": 26.87,
  "end": 32.47,
  "section": "관찰해요",
  "sub": "잎자루가 풍선처럼 부풀어 있어요"
 },
 {
  "t": 32.47,
  "end": 37.27,
  "section": "관찰해요",
  "sub": "뿌리는 수염처럼 빽빽하고 물속에 있어요"
 },
 {
  "t": 37.27,
  "end": 40.9,
  "section": "관찰해요",
  "sub": "줄기는 잎자루 아래에 있어요"
 },
 {
  "t": 40.9,
  "end": 46.0,
  "section": "실험해요",
  "sub": "부레옥잠의 잎자루를 잘라요"
 },
 {
  "t": 46.0,
  "end": 48.73,
  "section": "실험해요",
  "sub": "잘린 면을 돋보기로 관찰해요"
 },
 {
  "t": 48.73,
  "end": 54.53,
  "section": "실험해요",
  "sub": "잘린 면의 속 모양은 어떨까요?"
 },
 {
  "t": 54.53,
  "end": 59.6,
  "section": "실험해요",
  "sub": "동글동글한 작은 공기주머니가 벌집처럼 빽빽해요"
 },
 {
  "t": 59.6,
  "end": 63.43,
  "section": "실험해요",
  "sub": "자른 잎자루를 물속에 넣고 손가락으로 눌러요"
 },
 {
  "t": 63.43,
  "end": 69.03,
  "section": "실험해요",
  "sub": "어떤 일이 일어날까요?"
 },
 {
  "t": 69.03,
  "end": 74.1,
  "section": "실험해요",
  "sub": "공기 방울이 나와 위로 올라가요"
 },
 {
  "t": 74.1,
  "end": 82.17,
  "section": "정리해요",
  "sub": "잎자루 속 공기주머니 덕분에 물에 쉽게 떠요"
 },
 {
  "t": 82.17,
  "end": 93.2,
  "section": "정리해요",
  "sub": "생각 바로잡기: 부푼 부분은 줄기가 아니라 잎자루예요"
 },
 {
  "t": 93.2,
  "end": 99.2,
  "section": "조사해요",
  "sub": "잎이 물 위로 높이 — 연꽃 · 갈대"
 },
 {
  "t": 99.2,
  "end": 103.77,
  "section": "조사해요",
  "sub": "잎이 물 위에 떠 — 수련 · 마름"
 },
 {
  "t": 103.77,
  "end": 109.63,
  "section": "조사해요",
  "sub": "물에 떠서 — 부레옥잠 · 개구리밥"
 },
 {
  "t": 109.63,
  "end": 114.07,
  "section": "조사해요",
  "sub": "물속에 잠겨서 — 검정말 · 붕어마름"
 },
 {
  "t": 114.07,
  "end": 117.27,
  "section": "조사해요",
  "sub": "물이 흐르면 어떻게 될까요?"
 },
 {
  "t": 117.27,
  "end": 126.77,
  "section": "조사해요",
  "sub": "가는 줄기가 물의 흐름을 따라 잘 휘어요"
 },
 {
  "t": 126.77,
  "end": 134.47,
  "section": "정리해요",
  "sub": "한눈에 쏙 정리해요"
 },
 {
  "t": 134.47,
  "end": 141.13,
  "section": "정리해요",
  "sub": "물에서 살기에 알맞은 생김새와 생활 방식"
 },
 {
  "t": 141.13,
  "end": 145.43,
  "section": "생각해요",
  "sub": "부레옥잠을 물속에 집어넣고 손을 떼면?"
 },
 {
  "t": 145.43,
  "end": 152.13,
  "section": "생각해요",
  "sub": "떠오를까요, 가라앉을까요?"
 },
 {
  "t": 152.13,
  "end": 159.0,
  "section": "생각해요",
  "sub": "물 위로 떠올라요 — 잎자루 속 공기 덕분이에요"
 },
 {
  "t": 159.0,
  "end": 166.28,
  "section": "마무리",
  "sub": "부레옥잠은 잎자루 속 공기주머니 덕분에 물에 뜨고, 검정말은 줄기가 가늘어 잘 휘어요"
 },
 {
  "t": 166.28,
  "end": 173.1,
  "section": "마무리",
  "sub": "다음 영상: 3학년 13화 · 사막과 높은 산의 식물"
 }
