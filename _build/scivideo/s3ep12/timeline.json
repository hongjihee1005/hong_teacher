 },
 {
  "t": 137.2,
  "end": 143.9,
  "section": "생각해요",
  "sub": "떠오를까요, 가라앉을까요?"
 },
 {
  "t": 143.9,
  "end": 150.4,
  "section": "생각해요",
  "sub": "물 위로 떠올라요 — 잎자루 속 공기 덕분이에요"
