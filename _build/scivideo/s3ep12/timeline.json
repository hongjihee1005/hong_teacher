[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 12화: 물에 사는 식물과 부레옥잠"
 },
 {
  "t": 5.47,
  "end": 8.67,
  "section": "궁금해요",
  "sub": "강이나 연못에서 식물을 본 적이 있나요?"
 },
 {
  "t": 8.67,
  "end": 14.07,
  "section": "궁금해요",
  "sub": "물에 사는 식물은 땅에 사는 식물과 어떤 점이 다를까요?"
 },
 {
  "t": 14.07,
  "end": 20.93,
  "section": "관찰해요",
  "sub": "부레옥잠을 관찰해요"
 },
 {
  "t": 20.93,
  "end": 24.0,
  "section": "관찰해요",
  "sub": "잎몸은 물 위에서 위를 향해요"
 },
 {
  "t": 24.0,
  "end": 28.73,
  "section": "관찰해요",
  "sub": "잎자루가 풍선처럼 부풀어 있어요"
 },
 {
  "t": 28.73,
  "end": 32.8,
  "section": "관찰해요",
  "sub": "뿌리는 수염처럼 빽빽하고 물속에 있어요"
 },
 {
  "t": 32.8,
  "end": 36.53,
  "section": "관찰해요",
  "sub": "줄기는 잎자루 아래에 있어요"
 },
 {
  "t": 36.53,
  "end": 40.87,
  "section": "실험해요",
  "sub": "부레옥잠의 잎자루를 잘라요"
 },
 {
  "t": 40.87,
  "end": 43.53,
  "section": "실험해요",
  "sub": "잘린 면을 돋보기로 관찰해요"
 },
 {
  "t": 43.53,
  "end": 49.33,
  "section": "실험해요",
  "sub": "잘린 면의 속 모양은 어떨까요?"
 },
 {
  "t": 49.33,
  "end": 54.47,
  "section": "실험해요",
  "sub": "동글동글한 작은 공기주머니가 벌집처럼 빽빽해요"
 },
 {
  "t": 54.47,
  "end": 58.33,
  "section": "실험해요",
  "sub": "자른 잎자루를 물속에 넣고 손가락으로 눌러요"
 },
 {
  "t": 58.33,
  "end": 63.93,
  "section": "실험해요",
  "sub": "어떤 일이 일어날까요?"
 },
 {
  "t": 63.93,
  "end": 69.33,
  "section": "실험해요",
  "sub": "공기 방울이 나와 위로 올라가요"
 },
 {
  "t": 69.33,
  "end": 77.07,
  "section": "정리해요",
  "sub": "잎자루 속 공기주머니 덕분에 물에 쉽게 떠요"
 },
 {
  "t": 77.07,
  "end": 86.73,
  "section": "정리해요",
  "sub": "생각 바로잡기: 부푼 부분은 줄기가 아니라 잎자루예요"
 },
 {
  "t": 86.73,
  "end": 91.8,
  "section": "조사해요",
  "sub": "잎이 물 위로 높이 — 연꽃 · 갈대"
 },
 {
  "t": 91.8,
  "end": 96.53,
  "section": "조사해요",
  "sub": "잎이 물 위에 떠 — 수련 · 마름"
 },
 {
  "t": 96.53,
  "end": 102.07,
  "section": "조사해요",
  "sub": "물에 떠서 — 부레옥잠 · 개구리밥"
 },
 {
  "t": 102.07,
  "end": 106.27,
  "section": "조사해요",
  "sub": "물속에 잠겨서 — 검정말 · 붕어마름"
 },
 {
  "t": 106.27,
  "end": 109.33,
  "section": "조사해요",
  "sub": "물이 흐르면 어떻게 될까요?"
 },
 {
  "t": 109.33,
  "end": 118.27,
  "section": "조사해요",
  "sub": "가는 줄기가 물의 흐름을 따라 잘 휘어요"
 },
 {
  "t": 118.27,
  "end": 125.47,
  "section": "정리해요",
  "sub": "한눈에 쏙 정리해요"
 },
 {
  "t": 125.47,
  "end": 132.4,
  "section": "정리해요",
  "sub": "물에서 살기에 알맞은 생김새와 생활 방식"
 },
 {
  "t": 132.4,
  "end": 136.8,
  "section": "생각해요",
  "sub": "부레옥잠을 물속에 집어넣고 손을 떼면?"
 },
 {
  "t": 136.8,
  "end": 143.53,
  "section": "생각해요",
  "sub": "떠오를까요, 가라앉을까요?"
 },
 {
  "t": 143.53,
  "end": 150.0,
  "section": "생각해요",
  "sub": "물 위로 떠올라요 — 잎자루 속 공기 덕분이에요"
 },
 {
  "t": 150.0,
  "end": 154.5,
  "section": "마무리",
  "sub": "부레옥잠은 잎자루 속 공기주머니 덕분에 물에 뜨고, 검정말은 줄기가 가늘어 잘 휘어요"
 },
 {
  "t": 154.5,
  "end": 160.47,
  "section": "마무리",
  "sub": "다음 영상: 3학년 13화 · 사막과 높은 산의 식물"
 }
]