[
 {
  "t": 0.0,
  "end": 6.57,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 22화: 혼합물을 왜 분리할까?"
 },
 {
  "t": 6.57,
  "end": 13.77,
  "section": "궁금해요",
  "sub": "재활용품을 분리배출하면 무엇이 좋을까요?"
 },
 {
  "t": 13.77,
  "end": 28.9,
  "section": "궁금해요",
  "sub": "플라스틱, 철, 종이, 유리처럼 물질별로 나누어요"
 },
 {
  "t": 28.9,
  "end": 37.4,
  "section": "궁금해요",
  "sub": "필요한 물질을 얻고, 다시 써서 환경오염을 줄여요"
 },
 {
  "t": 37.4,
  "end": 43.43,
  "section": "혼합물이란?",
  "sub": "두 가지 이상의 물질이 섞여 있는 것 → 혼합물"
 },
 {
  "t": 43.43,
  "end": 57.9,
  "section": "혼합물이란?",
  "sub": "소금물, 설탕물 같은 용액이나 공기, 사탕수수도 혼합물이에요"
 },
 {
  "t": 57.9,
  "end": 64.8,
  "section": "나누어 봐요",
  "sub": "한 가지 물질일까요, 혼합물일까요?"
 },
 {
  "t": 64.8,
  "end": 70.3,
  "section": "나누어 봐요",
  "sub": "어느 것이 혼합물일까요?"
 },
 {
  "t": 70.3,
  "end": 79.2,
  "section": "나누어 봐요",
  "sub": "금관·산소·못·얼음은 한 가지 물질로만 이루어져 있어요"
 },
 {
  "t": 79.2,
  "end": 92.4,
  "section": "나누어 봐요",
  "sub": "소금물은 소금과 물, 공기는 질소·산소 등이 섞여 있어요"
 },
 {
  "t": 92.4,
  "end": 102.17,
  "section": "분리해 얻어요",
  "sub": "혼합물을 분리하면 무엇을 얻을 수 있을까요?"
 },
 {
  "t": 102.17,
  "end": 107.17,
  "section": "분리해 얻어요",
  "sub": "무엇을 얻을 수 있을까요?"
 },
 {
  "t": 107.17,
  "end": 111.8,
  "section": "분리해 얻어요",
  "sub": "바닷물에서 소금, 금광석에서 금을 얻어요"
 },
 {
  "t": 111.8,
  "end": 118.93,
  "section": "분리해 얻어요",
  "sub": "고무나무에서 천연고무액, 사탕수수에서 설탕을 얻어요"
 },
 {
  "t": 118.93,
  "end": 122.07,
  "section": "정리해요",
  "sub": "혼합물을 분리하는 까닭은 무엇일까요?"
 },
 {
  "t": 122.07,
  "end": 130.33,
  "section": "정리해요",
  "sub": "분리해야 필요한 물질을 얻을 수 있기 때문이에요"
 },
 {
  "t": 130.33,
  "end": 134.4,
  "section": "생각 바로잡기",
  "sub": "소금물에서 분리한 소금은 성질이 바뀔까요?"
 },
 {
  "t": 134.4,
  "end": 145.53,
  "section": "생각 바로잡기",
  "sub": "아니요, 소금의 성질은 그대로예요"
 },
 {
  "t": 145.53,
  "end": 149.37,
  "section": "얻은 물질 이용",
  "sub": "분리해 얻은 물질은 어떻게 이용할까요?"
 },
 {
  "t": 149.37,
  "end": 157.07,
  "section": "얻은 물질 이용",
  "sub": "설탕으로 사탕, 콩 단백질로 두부를 만들어요"
 },
 {
  "t": 157.07,
  "end": 167.57,
  "section": "얻은 물질 이용",
  "sub": "목화솜으로 옷을, 천연고무액으로 지우개를 만들어요"
 },
 {
  "t": 167.57,
  "end": 173.73,
  "section": "더 알아보기",
  "sub": "옛날 사람들도 농기구로 혼합물을 분리했어요"
 },
 {
  "t": 173.73,
  "end": 180.23,
  "section": "더 알아보기",
  "sub": "섞여 있는 것에서 필요한 곡식만 골라냈어요"
 },
 {
  "t": 180.23,
  "end": 186.87,
  "section": "한눈에 쏙",
  "sub": "성질이 변하지 않은 채 섞여 있는 것 → 혼합물"
 },
 {
  "t": 186.87,
  "end": 194.38,
  "section": "마무리",
  "sub": "두 가지 이상의 물질이 성질이 변하지 않은 채 섞여 있는 것이 혼합물, 분리하면 필요한 물질을 얻어요"
 },
 {
  "t": 194.38,
  "end": 201.73,
  "section": "마무리",
  "sub": "다음 영상: 5학년 23화 · 알갱이 크기가 다른 고체 혼합물"
 }
