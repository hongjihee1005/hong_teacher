[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 22화: 혼합물을 왜 분리할까?"
 },
 {
  "t": 5.5,
  "end": 12.23,
  "section": "궁금해요",
  "sub": "재활용품을 분리배출하면 무엇이 좋을까요?"
 },
 {
  "t": 12.23,
  "end": 24.13,
  "section": "궁금해요",
  "sub": "플라스틱, 철, 종이, 유리처럼 물질별로 나누어요"
 },
 {
  "t": 24.13,
  "end": 32.37,
  "section": "궁금해요",
  "sub": "필요한 물질을 얻고, 다시 써서 환경오염을 줄여요"
 },
 {
  "t": 32.37,
  "end": 38.77,
  "section": "혼합물이란?",
  "sub": "두 가지 이상의 물질이 섞여 있는 것 → 혼합물"
 },
 {
  "t": 38.77,
  "end": 51.37,
  "section": "혼합물이란?",
  "sub": "소금물, 설탕물 같은 용액이나 공기, 사탕수수도 혼합물이에요"
 },
 {
  "t": 51.37,
  "end": 57.77,
  "section": "나누어 봐요",
  "sub": "한 가지 물질일까요, 혼합물일까요?"
 },
 {
  "t": 57.77,
  "end": 63.27,
  "section": "나누어 봐요",
  "sub": "어느 것이 혼합물일까요?"
 },
 {
  "t": 63.27,
  "end": 70.0,
  "section": "나누어 봐요",
  "sub": "금관·산소·못·얼음은 한 가지 물질로만 이루어져 있어요"
 },
 {
  "t": 70.0,
  "end": 80.93,
  "section": "나누어 봐요",
  "sub": "소금물은 소금과 물, 공기는 질소·산소 등이 섞여 있어요"
 },
 {
  "t": 80.93,
  "end": 88.67,
  "section": "분리해 얻어요",
  "sub": "혼합물을 분리하면 무엇을 얻을 수 있을까요?"
 },
 {
  "t": 88.67,
  "end": 93.67,
  "section": "분리해 얻어요",
  "sub": "무엇을 얻을 수 있을까요?"
 },
 {
  "t": 93.67,
  "end": 98.23,
  "section": "분리해 얻어요",
  "sub": "바닷물에서 소금, 금광석에서 금을 얻어요"
 },
 {
  "t": 98.23,
  "end": 105.0,
  "section": "분리해 얻어요",
  "sub": "고무나무에서 천연고무액, 사탕수수에서 설탕을 얻어요"
 },
 {
  "t": 105.0,
  "end": 108.23,
  "section": "정리해요",
  "sub": "혼합물을 분리하는 까닭은 무엇일까요?"
 },
 {
  "t": 108.23,
  "end": 116.33,
  "section": "정리해요",
  "sub": "분리해야 필요한 물질을 얻을 수 있기 때문이에요"
 },
 {
  "t": 116.33,
  "end": 120.57,
  "section": "생각 바로잡기",
  "sub": "소금물에서 분리한 소금은 성질이 바뀔까요?"
 },
 {
  "t": 120.57,
  "end": 130.67,
  "section": "생각 바로잡기",
  "sub": "아니요, 소금의 성질은 그대로예요"
 },
 {
  "t": 130.67,
  "end": 134.57,
  "section": "얻은 물질 이용",
  "sub": "분리해 얻은 물질은 어떻게 이용할까요?"
 },
 {
  "t": 134.57,
  "end": 141.97,
  "section": "얻은 물질 이용",
  "sub": "설탕으로 사탕, 콩 단백질로 두부를 만들어요"
 },
 {
  "t": 141.97,
  "end": 151.23,
  "section": "얻은 물질 이용",
  "sub": "목화솜으로 옷을, 천연고무액으로 지우개를 만들어요"
 },
 {
  "t": 151.23,
  "end": 156.63,
  "section": "더 알아보기",
  "sub": "옛날 사람들도 농기구로 혼합물을 분리했어요"
 },
 {
  "t": 156.63,
  "end": 163.57,
  "section": "더 알아보기",
  "sub": "섞여 있는 것에서 필요한 곡식만 골라냈어요"
 },
 {
  "t": 163.57,
  "end": 170.57,
  "section": "한눈에 쏙",
  "sub": "성질이 변하지 않은 채 섞여 있는 것 → 혼합물"
 },
 {
  "t": 170.57,
  "end": 175.07,
  "section": "마무리",
  "sub": "두 가지 이상의 물질이 성질이 변하지 않은 채 섞여 있는 것이 혼합물, 분리하면 필요한 물질을 얻어요"
 },
 {
  "t": 175.07,
  "end": 181.07,
  "section": "마무리",
  "sub": "다음 영상: 5학년 23화 · 알갱이 크기가 다른 고체 혼합물"
 }
