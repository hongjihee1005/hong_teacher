  "end": 6.77,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 16화: 잎에서 양분이 만들어진다고?"
 },
 {
  "t": 6.77,
  "end": 10.63,
  "section": "궁금해요",
  "sub": "교실에서 식물을 어디에 두는 것이 좋을까요?"
 },
 {
  "t": 10.63,
  "end": 19.5,
  "section": "궁금해요",
  "sub": "대부분의 식물은 햇빛이 잘 드는 곳에서 잘 자라요"
 },
 {
  "t": 19.5,
  "end": 30.3,
  "section": "잎의 생김새",
  "sub": "잎은 대부분 잎몸과 잎자루로 이루어져 있어요"
 },
 {
  "t": 30.3,
  "end": 34.37,
  "section": "실험 준비",
  "sub": "하루 전, 잎 하나에만 알루미늄 포일을 씌워요"
 },
 {
  "t": 34.37,
  "end": 45.3,
  "section": "실험 준비",
  "sub": "햇빛을 받은 잎과 받지 못한 잎을 비교하려고요"
 },
 {
  "t": 45.3,
  "end": 55.1,
  "section": "실험해요",
  "sub": "다음 날 오후, 두 잎을 따서 실험해요"
 },
 {
  "t": 55.1,
  "end": 62.27,
  "section": "실험해요",
  "sub": "에탄올에서 잎의 초록색 색소가 빠져 색이 연해져요"
 },
 {
  "t": 62.27,
  "end": 70.53,
  "section": "실험해요",
  "sub": "시험관 입구는 사람이 없는 쪽으로, 창문을 열어 환기해요"
 },
 {
  "t": 70.53,
  "end": 75.87,
  "section": "실험해요",
  "sub": "아이오딘-아이오딘화 칼륨 용액을 떨어뜨려요"
 },
 {
  "t": 75.87,
  "end": 80.87,
  "section": "실험해요",
  "sub": "두 잎의 색깔은 어떻게 될까요?"
 },
 {
  "t": 80.87,
  "end": 88.37,
  "section": "실험해요",
  "sub": "포일을 씌우지 않은 잎만 청람색으로 변해요"
 },
 {
  "t": 88.37,
  "end": 100.8,
  "section": "실험해요",
  "sub": "햇빛을 받은 잎에서 녹말이 만들어졌어요"
 },
 {
  "t": 100.8,
  "end": 106.37,
  "section": "광합성",
  "sub": "빛을 이용해 이산화 탄소와 물로 양분을 만들어요 — 광합성"
 },
 {
  "t": 106.37,
  "end": 111.23,
  "section": "광합성",
  "sub": "광합성은 주로 잎에서 가장 활발하게 일어나요"
 },
 {
  "t": 111.23,
  "end": 114.47,
  "section": "양분의 이동",
  "sub": "잎에서 만들어진 양분은 어떻게 될까요?"
 },
 {
  "t": 114.47,
  "end": 125.5,
  "section": "양분의 이동",
  "sub": "녹말로 저장되었다가 줄기를 통해 식물 전체로 이동해요"
 },
 {
  "t": 125.5,
  "end": 133.47,
  "section": "양분의 이동",
  "sub": "잎이 넓으면 빛을 받는 면적이 넓어 광합성이 잘 일어나요"
 },
 {
  "t": 133.47,
  "end": 136.47,
  "section": "생각 바로잡기",
  "sub": "이 말은 맞을까요?"
 },
 {
  "t": 136.47,
  "end": 147.53,
  "section": "생각 바로잡기",
  "sub": "광합성은 주로 잎에서 — 양분은 식물 전체에서 쓰여요"
 },
 {
  "t": 147.53,
  "end": 153.7,
  "section": "한눈에 쏙",
  "sub": "빛을 이용해 양분을 만드는 것을 광합성이라고 해요"
 },
 {
  "t": 153.7,
  "end": 159.62,
  "section": "마무리",
  "sub": "식물은 빛을 이용해 이산화 탄소와 물로 양분을 만들어요 — 광합성"
 },
 {
