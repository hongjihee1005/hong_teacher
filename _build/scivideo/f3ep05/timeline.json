[
 {
  "t": 0.0,
  "end": 6.8,
  "section": "오프닝",
  "sub": "「처음 배우는 과학」 3학년 5화: 동물을 어떻게 분류할까?"
 },
 {
  "t": 6.8,
  "end": 10.53,
  "section": "궁금해요",
  "sub": "빨래를 개다가 양말이 뒤죽박죽 섞였어요"
 },
 {
  "t": 10.53,
  "end": 18.03,
  "section": "궁금해요",
  "sub": "양말의 색깔도, 무늬도, 길이도 모두 달라요"
 },
 {
  "t": 18.03,
  "end": 21.33,
  "section": "궁금해요",
  "sub": "양말을 어떻게 나누면 좋을까요?"
 },
 {
  "t": 21.33,
  "end": 27.93,
  "section": "궁금해요",
  "sub": "양말을 어떻게 나눌까요?"
 },
 {
  "t": 27.93,
  "end": 35.27,
  "section": "궁금해요",
  "sub": "색깔을 기준으로 나누어 봐요"
 },
 {
  "t": 35.27,
  "end": 42.43,
  "section": "궁금해요",
  "sub": "모양을 기준으로 나누어 봐요"
 },
 {
  "t": 42.43,
  "end": 47.9,
  "section": "궁금해요",
  "sub": "같은 양말도 기준에 따라 다르게 나뉘어요"
 },
 {
  "t": 47.9,
  "end": 56.8,
  "section": "궁금해요",
  "sub": "분류: 공통점이 있는 것끼리 묶는 활동"
 },
 {
  "t": 56.8,
  "end": 65.63,
  "section": "궁금해요",
  "sub": "나누는 까닭이 되는 것은 분류 기준이에요"
 },
 {
  "t": 65.63,
  "end": 73.67,
  "section": "새 낱말",
  "sub": "동물을 나누려면 동물의 몸을 잘 보아야 해요"
 },
 {
  "t": 73.67,
  "end": 75.67,
  "section": "새 낱말",
  "sub": "하늘을 나는 제비예요"
 },
 {
  "t": 75.67,
  "end": 81.2,
  "section": "새 낱말",
  "sub": "양쪽으로 펼친 이것이 날개예요"
 },
 {
  "t": 81.2,
  "end": 83.47,
  "section": "새 낱말",
  "sub": "풀밭에 앉은 토끼예요"
 },
 {
  "t": 83.47,
  "end": 89.2,
  "section": "새 낱말",
  "sub": "몸을 받치고 걷거나 뛰는 이것이 다리예요"
 },
 {
  "t": 89.2,
  "end": 95.93,
  "section": "새 낱말",
  "sub": "토끼의 긴 귀는 더듬이가 아니에요"
 },
 {
  "t": 95.93,
  "end": 99.0,
  "section": "새 낱말",
  "sub": "잎 위를 기어가는 달팽이예요"
 },
 {
  "t": 99.0,
  "end": 106.37,
  "section": "새 낱말",
  "sub": "머리에 뿔처럼 생긴 것이 더듬이예요"
 },
 {
  "t": 106.37,
  "end": 111.47,
  "section": "새 낱말",
  "sub": "달팽이는 다리가 없어요"
 },
 {
  "t": 111.47,
  "end": 114.1,
  "section": "새 낱말",
  "sub": "물속에서 헤엄치는 붕어예요"
 },
 {
  "t": 114.1,
  "end": 119.9,
  "section": "새 낱말",
  "sub": "몸에 붙은 얇은 막 같은 것이 지느러미예요"
 },
 {
  "t": 119.9,
  "end": 126.07,
  "section": "새 낱말",
  "sub": "붕어는 지느러미로 헤엄쳐요. 다리는 없어요"
 },
 {
  "t": 126.07,
  "end": 128.4,
  "section": "새 낱말",
  "sub": "바닷속에 사는 문어예요"
 },
 {
  "t": 128.4,
  "end": 135.7,
  "section": "새 낱말",
  "sub": "문어의 길쭉한 여덟 개를 다리라고 해요"
 },
 {
  "t": 135.7,
  "end": 140.1,
  "section": "관찰해요",
  "sub": "동물 카드 12장을 관찰해요"
 },
 {
  "t": 140.1,
  "end": 147.53,
  "section": "관찰해요",
  "sub": "날개·다리·더듬이·지느러미가 있는지 살펴봐요"
 },
 {
  "t": 147.53,
  "end": 151.03,
  "section": "관찰해요",
  "sub": "관찰한 내용으로 옳은 것을 골라요"
 },
 {
  "t": 151.03,
  "end": 157.83,
  "section": "관찰해요",
  "sub": "옳은 것 세 개를 찾아봐요"
 },
 {
  "t": 157.83,
  "end": 162.33,
  "section": "관찰해요",
  "sub": "옳은 것은 ①, ③, ⑤예요"
 },
 {
  "t": 162.33,
  "end": 169.07,
  "section": "관찰해요",
  "sub": "같은 점은 공통점, 다른 점은 차이점이에요"
 },
 {
  "t": 169.07,
  "end": 179.47,
  "section": "분류해요",
  "sub": "분류 기준을 날개가 있는가?로 정해요"
 },
 {
  "t": 179.47,
  "end": 187.37,
  "section": "분류해요",
  "sub": "날개가 있는 동물은 어느 것일까요?"
 },
 {
  "t": 187.37,
  "end": 194.43,
  "section": "분류해요",
  "sub": "날개가 있는 동물은 제비와 나비예요"
 },
 {
  "t": 194.43,
  "end": 199.8,
  "section": "분류해요",
  "sub": "이번에는 다리가 있는가?로 나누어 봐요"
 },
 {
  "t": 199.8,
  "end": 207.1,
  "section": "분류해요",
  "sub": "다리가 있는 동물은 몇 마리일까요?"
 },
 {
  "t": 207.1,
  "end": 223.43,
  "section": "분류해요",
  "sub": "다리가 있는 동물 7마리, 없는 동물 5마리"
 },
 {
  "t": 223.43,
  "end": 229.73,
  "section": "분류해요",
  "sub": "같은 동물도 기준에 따라 다르게 분류돼요"
 },
 {
  "t": 229.73,
  "end": 236.97,
  "section": "생각해요",
  "sub": "세 친구가 같은 기준으로 동물 6마리를 분류했어요"
 },
 {
  "t": 236.97,
  "end": 240.33,
  "section": "생각해요",
  "sub": "먼저 생김새가 귀여운가?로 분류해요"
 },
 {
  "t": 240.33,
  "end": 246.93,
  "section": "생각해요",
  "sub": "세 친구의 결과가 같을까요?"
 },
 {
  "t": 246.93,
  "end": 253.87,
  "section": "생각해요",
  "sub": "세 친구의 결과가 모두 달라요"
 },
 {
  "t": 253.87,
  "end": 257.3,
  "section": "생각해요",
  "sub": "이번에는 다리가 있는가?로 분류해요"
 },
 {
  "t": 257.3,
  "end": 269.27,
  "section": "생각해요",
  "sub": "세 친구의 결과가 모두 같아요"
 },
 {
  "t": 269.27,
  "end": 276.77,
  "section": "생각해요",
  "sub": "'예쁘다' 같은 주관적인 표현은 기준이 될 수 없어요"
 },
 {
  "t": 276.77,
  "end": 289.57,
  "section": "생각해요",
  "sub": "'짧다' 같은 상대적인 표현도 마찬가지예요"
 },
 {
  "t": 289.57,
  "end": 292.47,
  "section": "정리해요",
  "sub": "나비를 다시 자세히 볼까요?"
 },
 {
  "t": 292.47,
  "end": 300.67,
  "section": "정리해요",
  "sub": "나비는 날개·다리·더듬이가 모두 있어요"
 },
 {
  "t": 300.67,
  "end": 310.3,
  "section": "정리해요",
  "sub": "동물은 특징에 따라 기준을 정해 분류할 수 있어요"
 },
 {
  "t": 310.3,
  "end": 316.17,
  "section": "정리해요",
  "sub": "이렇게 분류하면 동물을 이해하는 데 도움이 돼요"
 },
 {
  "t": 316.17,
  "end": 320.67,
  "section": "확인해요",
  "sub": "동물을 분류하는 기준으로 옳지 않은 것은?"
 },
 {
  "t": 320.67,
  "end": 326.67,
  "section": "확인해요",
  "sub": "옳지 않은 기준은 몇 번일까요?"
 },
 {
  "t": 326.67,
  "end": 335.03,
  "section": "확인해요",
  "sub": "정답은 ④ — 무서운지는 사람마다 달라요"
 },
 {
  "t": 335.03,
  "end": 340.43,
  "section": "확인해요",
  "sub": "맞으면 ○, 틀리면 ×를 골라요"
 },
 {
  "t": 340.43,
  "end": 346.43,
  "section": "확인해요",
  "sub": "○일까요, ×일까요?"
 },
 {
  "t": 346.43,
  "end": 355.3,
  "section": "확인해요",
  "sub": "정답은 ○ — 누가 해도 같은 결과가 나와야 해요"
 },
 {
  "t": 355.3,
  "end": 361.77,
  "section": "더 알아보기",
  "sub": "다른 기준으로도 분류할 수 있어요"
 },
 {
  "t": 361.77,
  "end": 363.43,
  "section": "더 알아보기",
  "sub": "부리가 있는가?"
 },
 {
  "t": 363.43,
  "end": 368.37,
  "section": "더 알아보기",
  "sub": "몸이 털로 덮여 있는가?"
 },
 {
  "t": 368.37,
  "end": 375.43,
  "section": "더 알아보기",
  "sub": "누가 보아도 똑같이 알 수 있는 기준을 골라요"
 },
 {
  "t": 375.43,
  "end": 383.06,
  "section": "마무리",
  "sub": "동물은 날개·다리처럼 특징에 따라 분류해요 분류 기준은 누가 분류해도 같은 결과가 나와야 해요"
 },
 {
  "t": 383.06,
  "end": 391.77,
  "section": "마무리",
  "sub": "다음 영상: 처음 배우는 과학 3학년 6화 · 우리 주변·땅속에 사는 동물"
 }
