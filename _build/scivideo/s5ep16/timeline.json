[
 {
  "t": 0.0,
  "end": 6.9,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 16화: 우리 몸은 어떻게 움직일까?"
 },
 {
  "t": 6.9,
  "end": 15.37,
  "section": "궁금해요",
  "sub": "박물관에 전시된 동물의 뼈예요. 어떤 동물일까요?"
 },
 {
  "t": 15.37,
  "end": 24.1,
  "section": "궁금해요",
  "sub": "단서: 긴 목뼈, 길고 네 개인 다리뼈, 꼬리뼈"
 },
 {
  "t": 24.1,
  "end": 29.1,
  "section": "궁금해요",
  "sub": "이 뼈는 어떤 동물의 뼈일까요?"
 },
 {
  "t": 29.1,
  "end": 39.3,
  "section": "궁금해요",
  "sub": "기린의 뼈예요. 뼈의 모습은 동물의 생김새와 비슷해요"
 },
 {
  "t": 39.3,
  "end": 47.47,
  "section": "우리 몸의 뼈",
  "sub": "머리뼈는 동그랗고, 갈비뼈는 둥근 활 모양이에요"
 },
 {
  "t": 47.47,
  "end": 51.7,
  "section": "우리 몸의 뼈",
  "sub": "목뼈와 척추뼈는 뼈 여러 개가 세로로 이어져 있어요"
 },
 {
  "t": 51.7,
  "end": 55.13,
  "section": "우리 몸의 뼈",
  "sub": "팔뼈와 다리뼈는 길어요"
 },
 {
  "t": 55.13,
  "end": 57.23,
  "section": "뼈와 근육이 하는 일",
  "sub": "뼈는 어떤 일을 할까요?"
 },
 {
  "t": 57.23,
  "end": 61.57,
  "section": "뼈와 근육이 하는 일",
  "sub": "뼈는 몸의 형태를 만들고, 몸을 지탱해요"
 },
 {
  "t": 61.57,
  "end": 70.7,
  "section": "뼈와 근육이 하는 일",
  "sub": "갈비뼈는 심장과 폐를, 머리뼈는 뇌를 감싸 보호해요"
 },
 {
  "t": 70.7,
  "end": 80.1,
  "section": "뼈와 근육이 하는 일",
  "sub": "근육은 뼈에 연결되어 있고, 부위마다 모양과 크기가 달라요"
 },
 {
  "t": 80.1,
  "end": 86.97,
  "section": "모형 만들기",
  "sub": "뼈와 근육 모형을 만들어 봐요"
 },
 {
  "t": 86.97,
  "end": 95.67,
  "section": "모형 만들기",
  "sub": "①② 위팔뼈·아래팔뼈를 잇고, 아래팔뼈와 손잡이를 안쪽 근육에"
 },
 {
  "t": 95.67,
  "end": 105.5,
  "section": "모형 만들기",
  "sub": "③④ 위팔뼈를 안쪽 근육에, 바깥쪽 근육을 두 뼈에 연결해요"
 },
 {
  "t": 105.5,
  "end": 111.13,
  "section": "모형 관찰",
  "sub": "손잡이를 잡아당기면 근육과 뼈는 어떻게 될까요?"
 },
 {
  "t": 111.13,
  "end": 117.13,
  "section": "모형 관찰",
  "sub": "손잡이를 당기면 안쪽 근육은?"
 },
 {
  "t": 117.13,
  "end": 126.57,
  "section": "모형 관찰",
  "sub": "안쪽 근육이 줄어들고 바깥쪽 근육이 늘어나 아래팔뼈가 올라가요"
 },
 {
  "t": 126.57,
  "end": 135.8,
  "section": "모형 관찰",
  "sub": "밀면 반대로, 아래팔뼈가 내려가요"
 },
 {
  "t": 135.8,
  "end": 145.2,
  "section": "내 팔",
  "sub": "팔을 구부리면 안쪽 근육이 줄어들고 바깥쪽 근육이 늘어나요"
 },
 {
  "t": 145.2,
  "end": 156.9,
  "section": "내 팔",
  "sub": "팔을 펴면 바깥쪽 근육이 줄어들고 안쪽 근육이 늘어나요"
 },
 {
  "t": 156.9,
  "end": 160.03,
  "section": "생각 바로잡기",
  "sub": "두 문장 가운데 옳은 것은 무엇일까요?"
 },
 {
  "t": 160.03,
  "end": 165.03,
  "section": "생각 바로잡기",
  "sub": "뼈는 스스로 움직일까요?"
 },
 {
  "t": 165.03,
  "end": 173.93,
  "section": "생각 바로잡기",
  "sub": "뼈는 스스로 움직이지 못해요. 근육이 뼈를 움직여요"
 },
 {
  "t": 173.93,
  "end": 181.33,
  "section": "생활 속에서",
  "sub": "의자에 앉을 때는 뒤쪽 근육이 줄어들어 다리가 구부러져요"
 },
 {
  "t": 181.33,
  "end": 188.6,
  "section": "생활 속에서",
  "sub": "일어설 때는 앞쪽 근육이 줄어들어 다리가 펴져요"
 },
 {
  "t": 188.6,
  "end": 196.6,
  "section": "한눈에 쏙",
  "sub": "근육이 줄어들거나 늘어나면서 뼈를 움직여 몸이 움직여요"
 },
 {
  "t": 196.6,
  "end": 201.1,
  "section": "마무리",
  "sub": "근육이 줄어들거나 늘어나면서 뼈를 움직여 몸이 움직여요"
 },
 {
  "t": 201.1,
  "end": 207.73,
  "section": "마무리",
  "sub": "다음 영상: 5학년 17화 · 음식물은 어떻게 될까?"
 }
