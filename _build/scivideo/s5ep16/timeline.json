[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 16화: 우리 몸은 어떻게 움직일까?"
 },
 {
  "t": 5.47,
  "end": 12.67,
  "section": "궁금해요",
  "sub": "박물관에 전시된 동물의 뼈예요. 어떤 동물일까요?"
 },
 {
  "t": 12.67,
  "end": 19.4,
  "section": "궁금해요",
  "sub": "단서: 긴 목뼈, 길고 네 개인 다리뼈, 꼬리뼈"
 },
 {
  "t": 19.4,
  "end": 24.4,
  "section": "궁금해요",
  "sub": "이 뼈는 어떤 동물의 뼈일까요?"
 },
 {
  "t": 24.4,
  "end": 33.6,
  "section": "궁금해요",
  "sub": "기린의 뼈예요. 뼈의 모습은 동물의 생김새와 비슷해요"
 },
 {
  "t": 33.6,
  "end": 41.13,
  "section": "우리 몸의 뼈",
  "sub": "머리뼈는 동그랗고, 갈비뼈는 둥근 활 모양이에요"
 },
 {
  "t": 41.13,
  "end": 45.47,
  "section": "우리 몸의 뼈",
  "sub": "목뼈와 척추뼈는 뼈 여러 개가 세로로 이어져 있어요"
 },
 {
  "t": 45.47,
  "end": 48.87,
  "section": "우리 몸의 뼈",
  "sub": "팔뼈와 다리뼈는 길어요"
 },
 {
  "t": 48.87,
  "end": 50.87,
  "section": "뼈와 근육이 하는 일",
  "sub": "뼈는 어떤 일을 할까요?"
 },
 {
  "t": 50.87,
  "end": 54.2,
  "section": "뼈와 근육이 하는 일",
  "sub": "뼈는 몸의 형태를 만들고, 몸을 지탱해요"
 },
 {
  "t": 54.2,
  "end": 61.53,
  "section": "뼈와 근육이 하는 일",
  "sub": "갈비뼈는 심장과 폐를, 머리뼈는 뇌를 감싸 보호해요"
 },
 {
  "t": 61.53,
  "end": 69.73,
  "section": "뼈와 근육이 하는 일",
  "sub": "근육은 뼈에 연결되어 있고, 부위마다 모양과 크기가 달라요"
 },
 {
  "t": 69.73,
  "end": 75.6,
  "section": "모형 만들기",
  "sub": "뼈와 근육 모형을 만들어 봐요"
 },
 {
  "t": 75.6,
  "end": 84.0,
  "section": "모형 만들기",
  "sub": "①② 위팔뼈·아래팔뼈를 잇고, 아래팔뼈와 손잡이를 안쪽 근육에"
 },
 {
  "t": 84.0,
  "end": 93.13,
  "section": "모형 만들기",
  "sub": "③④ 위팔뼈를 안쪽 근육에, 바깥쪽 근육을 두 뼈에 연결해요"
 },
 {
  "t": 93.13,
  "end": 98.67,
  "section": "모형 관찰",
  "sub": "손잡이를 잡아당기면 근육과 뼈는 어떻게 될까요?"
 },
 {
  "t": 98.67,
  "end": 104.67,
  "section": "모형 관찰",
  "sub": "손잡이를 당기면 안쪽 근육은?"
 },
 {
  "t": 104.67,
  "end": 112.53,
  "section": "모형 관찰",
  "sub": "안쪽 근육이 줄어들고 바깥쪽 근육이 늘어나 아래팔뼈가 올라가요"
 },
 {
  "t": 112.53,
  "end": 121.0,
  "section": "모형 관찰",
  "sub": "밀면 반대로, 아래팔뼈가 내려가요"
 },
 {
  "t": 121.0,
  "end": 129.2,
  "section": "내 팔",
  "sub": "팔을 구부리면 안쪽 근육이 줄어들고 바깥쪽 근육이 늘어나요"
 },
 {
  "t": 129.2,
  "end": 139.27,
  "section": "내 팔",
  "sub": "팔을 펴면 바깥쪽 근육이 줄어들고 안쪽 근육이 늘어나요"
 },
 {
  "t": 139.27,
  "end": 142.33,
  "section": "생각 바로잡기",
  "sub": "두 문장 가운데 옳은 것은 무엇일까요?"
 },
 {
  "t": 142.33,
  "end": 147.33,
  "section": "생각 바로잡기",
  "sub": "뼈는 스스로 움직일까요?"
 },
 {
  "t": 147.33,
  "end": 155.47,
  "section": "생각 바로잡기",
  "sub": "뼈는 스스로 움직이지 못해요. 근육이 뼈를 움직여요"
 },
 {
  "t": 155.47,
  "end": 162.2,
  "section": "생활 속에서",
  "sub": "의자에 앉을 때는 뒤쪽 근육이 줄어들어 다리가 구부러져요"
 },
 {
  "t": 162.2,
  "end": 168.8,
  "section": "생활 속에서",
  "sub": "일어설 때는 앞쪽 근육이 줄어들어 다리가 펴져요"
 },
 {
  "t": 168.8,
  "end": 176.6,
  "section": "한눈에 쏙",
  "sub": "근육이 줄어들거나 늘어나면서 뼈를 움직여 몸이 움직여요"
 },
 {
  "t": 176.6,
  "end": 181.1,
  "section": "마무리",
  "sub": "근육이 줄어들거나 늘어나면서 뼈를 움직여 몸이 움직여요"
 },
 {
