  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 16화: 씨가 싹 트려면?"
 },
 {
  "t": 6.07,
  "end": 11.4,
  "section": "궁금해요",
  "sub": "봄이 되면 많은 식물의 싹이 터요. 왜 그럴까요?"
 },
 {
  "t": 11.4,
  "end": 16.07,
  "section": "궁금해요",
  "sub": "봄에 싹이 많이 트는 까닭은?"
 },
 {
  "t": 16.07,
  "end": 20.1,
  "section": "궁금해요",
  "sub": "날씨가 따뜻해지고 비가 내리기 때문이에요"
 },
 {
  "t": 20.1,
  "end": 31.97,
  "section": "궁금해요",
  "sub": "씨가 싹 트고 자라 다시 씨를 만드는 과정 = 식물의 한살이"
 },
 {
  "t": 31.97,
  "end": 36.03,
  "section": "실험 계획",
  "sub": "씨가 싹 트는 데 물이 필요한지 실험해요"
 },
 {
  "t": 36.03,
  "end": 44.47,
  "section": "실험 계획",
  "sub": "다르게 할 조건은 물의 양 하나뿐이에요"
 },
 {
  "t": 44.47,
  "end": 56.43,
  "section": "실험 계획",
  "sub": "나머지는 모두 같게 해요"
 },
 {
  "t": 56.43,
  "end": 62.53,
  "section": "실험해요",
  "sub": "작은 컵에 부직포 심지와 원 모양 부직포를 끼워요"
 },
 {
  "t": 62.53,
  "end": 71.03,
  "section": "실험해요",
  "sub": "한쪽 큰 컵에만 물을 담고, 작은 컵을 끼워요"
 },
 {
  "t": 71.03,
  "end": 79.23,
  "section": "실험해요",
  "sub": "무씨를 골고루 올리고, 두 컵을 같은 곳에 두어요"
 },
 {
  "t": 79.23,
  "end": 85.13,
  "section": "실험해요",
  "sub": "두 컵의 무씨는 어떻게 될까요?"
 },
 {
  "t": 85.13,
  "end": 90.13,
  "section": "실험해요",
  "sub": "두 컵의 무씨는 어떻게 될까요?"
 },
 {
  "t": 90.13,
  "end": 93.83,
  "section": "실험해요",
  "sub": "물을 담은 컵: 물을 머금고 부풀었어요"
 },
 {
  "t": 93.83,
  "end": 97.87,
  "section": "실험해요",
  "sub": "물을 담은 컵: 껍질이 벗겨지고 하얀 뿌리가 나와요"
 },
 {
  "t": 97.87,
  "end": 104.1,
  "section": "실험해요",
  "sub": "물을 담은 컵: 싹이 텄어요!"
 },
 {
  "t": 104.1,
  "end": 111.47,
  "section": "실험해요",
  "sub": "큰 컵의 물이 줄면 보충해 부직포가 늘 젖어 있게 해요"
 },
 {
  "t": 111.47,
  "end": 119.97,
