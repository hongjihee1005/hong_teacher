[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 18화: 꽃의 생김새와 하는 일"
 },
 {
  "t": 5.5,
  "end": 9.73,
  "section": "궁금해요",
  "sub": "내가 좋아하는 꽃은 어떻게 생겼나요?"
 },
 {
  "t": 9.73,
  "end": 18.5,
  "section": "궁금해요",
  "sub": "색깔·크기·모양은 다양하지만 공통된 구조도 있어요"
 },
 {
  "t": 18.5,
  "end": 20.8,
  "section": "꽃의 구조",
  "sub": "꽃은 암술·수술·꽃잎·꽃받침으로 이루어져 있어요"
 },
 {
  "t": 20.8,
  "end": 29.7,
  "section": "꽃의 구조",
  "sub": "암술 둘레를 수술이 둘러싸고, 바깥에 꽃잎이 있어요"
 },
 {
  "t": 29.7,
  "end": 34.4,
  "section": "관찰해요",
  "sub": "달맞이꽃을 분리해 흰 종이 위에 놓아요"
 },
 {
  "t": 34.4,
  "end": 40.97,
  "section": "관찰해요",
  "sub": "암술 1개, 수술 8개, 꽃잎 4장, 꽃받침 4개"
 },
 {
  "t": 40.97,
  "end": 48.73,
  "section": "관찰해요",
  "sub": "꽃받침은 2개씩 합쳐지며 뒤로 젖혀져요"
 },
 {
  "t": 48.73,
  "end": 52.8,
  "section": "꽃가루받이",
  "sub": "수술의 꽃가루가 암술로 어떻게 옮겨 갈까요?"
 },
 {
  "t": 52.8,
  "end": 60.3,
  "section": "꽃가루받이",
  "sub": "꽃가루가 암술에 옮겨 붙는 것을 꽃가루받이라고 해요"
 },
 {
  "t": 60.3,
  "end": 64.7,
  "section": "꽃가루받이",
  "sub": "꽃가루가 옮겨 가도록 돕는 것은 무엇일까요?"
 },
 {
  "t": 64.7,
  "end": 69.7,
  "section": "꽃가루받이",
  "sub": "도와주는 것을 모두 골라요"
 },
 {
  "t": 69.7,
  "end": 78.3,
  "section": "꽃가루받이",
  "sub": "곤충·새·바람·물이 도와요 — 흙은 아니에요"
 },
 {
  "t": 78.3,
  "end": 81.7,
  "section": "씨와 열매",
  "sub": "복숭아꽃이 열매가 되는 과정을 봐요"
 },
 {
  "t": 81.7,
  "end": 85.6,
  "section": "씨와 열매",
  "sub": "꽃가루받이가 되면 암술 속에 씨가 생겨요"
 },
 {
  "t": 85.6,
  "end": 90.0,
  "section": "씨와 열매",
  "sub": "씨를 둘러싼 부분도 함께 자라 열매가 돼요"
 },
 {
  "t": 90.0,
  "end": 100.1,
  "section": "씨와 열매",
  "sub": "열매는 씨를 보호하고, 익으면 멀리 퍼지게 해요"
 },
 {
  "t": 100.1,
  "end": 105.0,
  "section": "생각 바로잡기",
  "sub": "모든 꽃에 네 부분이 다 있을까요?"
 },
 {
  "t": 105.0,
  "end": 111.57,
  "section": "생각 바로잡기",
  "sub": "아니요, 종류에 따라 일부가 없는 꽃도 있어요"
 },
 {
  "t": 111.57,
  "end": 124.0,
  "section": "생각 바로잡기",
  "sub": "꽃잎이 화려하면 곤충을 불러들이기 좋아요"
 },
 {
  "t": 124.0,
  "end": 130.33,
  "section": "한눈에 쏙",
  "sub": "꽃은 씨를 만들고, 씨를 둘러싼 부분이 자라 열매가 돼요"
 },
 {
  "t": 130.33,
  "end": 134.83,
  "section": "마무리",
  "sub": "꽃가루받이가 이루어지면 씨가 생기고, 씨를 둘러싼 부분이 자라 열매가 돼요"
 },
 {
  "t": 134.83,
  "end": 140.83,
  "section": "마무리",
  "sub": "다음 영상: 6학년 19화 · 식물의 기관은 연결되어 있어요"
 }
