[
 {
  "t": 0.0,
  "end": 6.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 18화: 꽃의 생김새와 하는 일"
 },
 {
  "t": 6.47,
  "end": 10.57,
  "section": "궁금해요",
  "sub": "내가 좋아하는 꽃은 어떻게 생겼나요?"
 },
 {
  "t": 10.57,
  "end": 20.07,
  "section": "궁금해요",
  "sub": "색깔·크기·모양은 다양하지만 공통된 구조도 있어요"
 },
 {
  "t": 20.07,
  "end": 22.37,
  "section": "꽃의 구조",
  "sub": "꽃은 암술·수술·꽃잎·꽃받침으로 이루어져 있어요"
 },
 {
  "t": 22.37,
  "end": 32.7,
  "section": "꽃의 구조",
  "sub": "암술 둘레를 수술이 둘러싸고, 바깥에 꽃잎이 있어요"
 },
 {
  "t": 32.7,
  "end": 37.0,
  "section": "관찰해요",
  "sub": "달맞이꽃을 분리해 흰 종이 위에 놓아요"
 },
 {
  "t": 37.0,
  "end": 44.13,
  "section": "관찰해요",
  "sub": "암술 1개, 수술 8개, 꽃잎 4장, 꽃받침 4개"
 },
 {
  "t": 44.13,
  "end": 52.9,
  "section": "관찰해요",
  "sub": "꽃받침은 2개씩 합쳐지며 뒤로 젖혀져요"
 },
 {
  "t": 52.9,
  "end": 56.87,
  "section": "꽃가루받이",
  "sub": "수술의 꽃가루가 암술로 어떻게 옮겨 갈까요?"
 },
 {
  "t": 56.87,
  "end": 64.57,
  "section": "꽃가루받이",
  "sub": "꽃가루가 암술에 옮겨 붙는 것을 꽃가루받이라고 해요"
 },
 {
  "t": 64.57,
  "end": 68.83,
  "section": "꽃가루받이",
  "sub": "꽃가루가 옮겨 가도록 돕는 것은 무엇일까요?"
 },
 {
  "t": 68.83,
  "end": 73.83,
  "section": "꽃가루받이",
  "sub": "도와주는 것을 모두 골라요"
 },
 {
  "t": 73.83,
  "end": 84.27,
  "section": "꽃가루받이",
  "sub": "곤충·새·바람·물이 도와요 — 흙은 아니에요"
 },
 {
  "t": 84.27,
  "end": 87.67,
  "section": "씨와 열매",
  "sub": "복숭아꽃이 열매가 되는 과정을 봐요"
 },
 {
  "t": 87.67,
  "end": 91.4,
  "section": "씨와 열매",
  "sub": "꽃가루받이가 되면 암술 속에 씨가 생겨요"
 },
 {
  "t": 91.4,
  "end": 95.8,
  "section": "씨와 열매",
  "sub": "씨를 둘러싼 부분도 함께 자라 열매가 돼요"
 },
 {
  "t": 95.8,
  "end": 107.07,
  "section": "씨와 열매",
  "sub": "열매는 씨를 보호하고, 익으면 멀리 퍼지게 해요"
 },
 {
  "t": 107.07,
  "end": 113.33,
  "section": "생각 바로잡기",
  "sub": "모든 꽃에 네 부분이 다 있을까요?"
 },
 {
  "t": 113.33,
  "end": 121.63,
  "section": "생각 바로잡기",
  "sub": "아니요, 종류에 따라 일부가 없는 꽃도 있어요"
 },
 {
  "t": 121.63,
  "end": 134.03,
  "section": "생각 바로잡기",
  "sub": "꽃잎이 화려하면 곤충을 불러들이기 좋아요"
 },
 {
  "t": 134.03,
  "end": 140.53,
  "section": "한눈에 쏙",
  "sub": "꽃은 씨를 만들고, 씨를 둘러싼 부분이 자라 열매가 돼요"
 },
 {
  "t": 140.53,
  "end": 146.93,
  "section": "마무리",
  "sub": "꽃가루받이가 이루어지면 씨가 생기고, 씨를 둘러싼 부분이 자라 열매가 돼요"
 },
 {
  "t": 146.93,
  "end": 153.97,
  "section": "마무리",
  "sub": "다음 영상: 6학년 19화 · 식물의 기관은 연결되어 있어요"
 }
]