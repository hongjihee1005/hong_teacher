  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 29화: 바람은 어느 방향으로 불까?"
 },
 {
  "t": 6.9,
  "end": 14.4,
  "section": "궁금해요",
  "sub": "바람자루를 보면 바람은 어디에서 어디로 불까요?"
 },
 {
  "t": 14.4,
  "end": 19.07,
  "section": "궁금해요",
  "sub": "바람은 어디에서 어디로 불까요?"
 },
 {
  "t": 19.07,
  "end": 29.73,
  "section": "궁금해요",
  "sub": "바람자루가 육지 쪽을 가리켜요 → 바다에서 육지 쪽으로"
 },
 {
  "t": 29.73,
  "end": 43.7,
  "section": "궁금해요",
  "sub": "온도에 따라 공기의 무게는 어떻게 다를까요?"
 },
 {
  "t": 43.7,
  "end": 51.23,
  "section": "궁금해요",
  "sub": "기압 차이로 공기가 이동하는 것이 바람이에요"
 },
 {
  "t": 51.23,
  "end": 63.93,
  "section": "실험해요",
  "sub": "바람 발생 모형실험 장치를 만들어요"
 },
 {
  "t": 63.93,
  "end": 73.43,
  "section": "실험해요",
  "sub": "향 연기를 모은 작은 그릇을 두 그릇 사이에 넣어요"
 },
 {
  "t": 73.43,
  "end": 78.73,
  "section": "실험해요",
  "sub": "향 연기는 어느 쪽으로 움직일까요?"
 },
 {
  "t": 78.73,
  "end": 86.33,
  "section": "실험해요",
  "sub": "뚜껑을 열고 향 연기의 움직임을 관찰해요"
 },
 {
  "t": 86.33,
  "end": 96.27,
  "section": "실험해요",
  "sub": "향 연기는 모래 쪽에서 따뜻한 물 쪽으로 움직였어요"
 },
 {
  "t": 96.27,
  "end": 105.63,
  "section": "실험해요",
  "sub": "모래 위는 고기압, 따뜻한 물 위는 저기압이에요"
 },
 {
  "t": 105.63,
  "end": 117.13,
  "section": "실험해요",
  "sub": "공기는 고기압에서 저기압으로 이동해요"
 },
 {
  "t": 117.13,
  "end": 128.53,
  "section": "해풍과 육풍",
  "sub": "육지는 바다보다 빨리 가열되고, 빨리 식어요"
 },
 {
  "t": 128.53,
  "end": 137.6,
  "section": "해풍과 육풍",
  "sub": "낮: 육지가 더 따뜻해 저기압, 바다는 고기압"
 },
 {
  "t": 137.6,
  "end": 142.27,
  "section": "해풍과 육풍",
  "sub": "낮에는 바람이 어느 쪽으로 불까요?"
 },
 {
  "t": 142.27,
  "end": 152.5,
  "section": "해풍과 육풍",
  "sub": "낮에는 바다에서 육지로 해풍이 불어요"
 },
 {
  "t": 152.5,
  "end": 161.27,
  "section": "해풍과 육풍",
  "sub": "밤: 육지가 빨리 식어 고기압, 바다는 저기압"
 },
 {
  "t": 161.27,
  "end": 168.33,
  "section": "해풍과 육풍",
  "sub": "밤에는 육지에서 바다로 육풍이 불어요"
 },
 {
  "t": 168.33,
  "end": 177.7,
  "section": "해풍과 육풍",
  "sub": "낮에는 해풍, 밤에는 육풍"
 },
 {
  "t": 177.7,
  "end": 181.23,
  "section": "한눈에 쏙",
  "sub": "바람은 고기압에서 저기압으로 불어요"
 },
 {
