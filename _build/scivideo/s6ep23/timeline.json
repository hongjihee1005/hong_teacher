[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 23화: 지구의 공전"
 },
 {
  "t": 5.47,
  "end": 9.2,
  "section": "궁금해요",
  "sub": "회전목마의 말은 무엇을 중심으로 돌고 있나요?"
 },
 {
  "t": 9.2,
  "end": 16.07,
  "section": "궁금해요",
  "sub": "가운데 세워진 기둥을 중심으로 돌아요 — 말의 위치가 계속 달라져요"
 },
 {
  "t": 16.07,
  "end": 24.73,
  "section": "궁금해요",
  "sub": "회전하는 모습이 비슷한 것끼리 나누어요"
 },
 {
  "t": 24.73,
  "end": 35.33,
  "section": "궁금해요",
  "sub": "한 천체가 다른 천체의 둘레를 주기적으로 도는 일 = 공전"
 },
 {
  "t": 35.33,
  "end": 44.33,
  "section": "실험 준비",
  "sub": "지구본·관측자 모형·갓 없는 전등·면장갑을 준비해요"
 },
 {
  "t": 44.33,
  "end": 52.53,
  "section": "실험 준비",
  "sub": "전등을 등지고 서서 우리나라가 한밤이 되게 해요"
 },
 {
  "t": 52.53,
  "end": 60.6,
  "section": "실험 준비",
  "sub": "자전축 방향은 같게, 전등과의 거리는 일정하게"
 },
 {
  "t": 60.6,
  "end": 68.47,
  "section": "실험해요",
  "sub": "지구본을 가 → 나 → 다 → 라 위치로 옮기며 관찰해요"
 },
 {
  "t": 68.47,
  "end": 72.2,
  "section": "실험해요",
  "sub": "가 위치: 칠판, 시계, 시간표가 보여요"
 },
 {
  "t": 72.2,
  "end": 75.4,
  "section": "실험해요",
  "sub": "나 위치: 창문, 화분"
 },
 {
  "t": 75.4,
  "end": 78.6,
  "section": "실험해요",
  "sub": "다 위치: 사물함, 거울"
 },
 {
  "t": 78.6,
  "end": 81.8,
  "section": "실험해요",
  "sub": "라 위치: 창문, 출입문"
 },
 {
  "t": 81.8,
  "end": 86.8,
  "section": "실험해요",
  "sub": "보이는 모습은 어땠나요?"
 },
 {
  "t": 86.8,
  "end": 98.4,
  "section": "실험해요",
  "sub": "위치에 따라 보이는 모습이 달라져요 — 지구도 공전하며 밤하늘이 달라져요"
 },
 {
  "t": 98.4,
  "end": 102.47,
  "section": "지구의 공전",
  "sub": "지구는 태양을 중심으로 일정한 길을 따라 돌아요"
 },
 {
  "t": 102.47,
  "end": 111.2,
  "section": "지구의 공전",
  "sub": "일 년에 한 바퀴, 서쪽에서 동쪽으로 — 지구의 공전"
 },
 {
  "t": 111.2,
  "end": 115.73,
  "section": "지구의 공전",
  "sub": "지구는 하루에 한 바퀴씩 자전하면서 공전해요"
 },
 {
  "t": 115.73,
  "end": 123.8,
  "section": "지구의 공전",
  "sub": "지구의 위치에 따라 밤하늘에 보이는 모습이 달라져요"
 },
 {
  "t": 123.8,
  "end": 126.67,
  "section": "자전과 공전",
  "sub": "자전일까요, 공전일까요?"
 },
 {
  "t": 126.67,
  "end": 134.67,
  "section": "자전과 공전",
  "sub": "자전: 자전축 중심·하루에 한 바퀴·낮과 밤"
 },
 {
  "t": 134.67,
  "end": 142.67,
  "section": "자전과 공전",
  "sub": "공전: 태양 중심·일 년에 한 바퀴·밤하늘이 달라져요"
 },
 {
  "t": 142.67,
  "end": 147.73,
  "section": "자전과 공전",
  "sub": "둘 다 서쪽에서 동쪽으로 회전해요"
 },
 {
  "t": 147.73,
  "end": 153.6,
  "section": "생각해요",
  "sub": "지구 주위를 공전하는 것을 모두 골라요"
 },
 {
  "t": 153.6,
  "end": 160.33,
  "section": "생각해요",
  "sub": "달과 인공위성은 지구 주위를 공전해요"
 },
 {
  "t": 160.33,
  "end": 168.93,
  "section": "한눈에 쏙",
  "sub": "지구의 공전"
 },
 {
  "t": 168.93,
  "end": 174.8,
  "section": "확인해요",
  "sub": "지구의 공전 — 옳으면 ○, 옳지 않으면 ×"
 },
 {
  "t": 174.8,
  "end": 179.8,
  "section": "확인해요",
  "sub": "○일까요, ×일까요?"
 },
 {
  "t": 179.8,
  "end": 187.27,
  "section": "확인해요",
  "sub": "⑵ × — 공전은 일 년에 한 바퀴, 하루에 한 바퀴는 자전"
 },
 {
  "t": 187.27,
  "end": 191.77,
  "section": "마무리",
  "sub": "지구는 태양을 중심으로 일 년에 한 바퀴씩 서쪽에서 동쪽으로 공전해요"
 },
 {
  "t": 191.77,
  "end": 197.73,
  "section": "마무리",
  "sub": "다음 영상: 6학년 24화 · 계절마다 다른 별자리"
 }
]