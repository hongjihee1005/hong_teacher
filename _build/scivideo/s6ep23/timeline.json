[
 {
  "t": 0.0,
  "end": 6.27,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 23화: 지구의 공전"
 },
 {
  "t": 6.27,
  "end": 9.8,
  "section": "궁금해요",
  "sub": "회전목마의 말은 무엇을 중심으로 돌고 있나요?"
 },
 {
  "t": 9.8,
  "end": 16.4,
  "section": "궁금해요",
  "sub": "가운데 세워진 기둥을 중심으로 돌아요"
 },
 {
  "t": 16.4,
  "end": 24.17,
  "section": "궁금해요",
  "sub": "회전하는 모습이 비슷한 것끼리 나누어요"
 },
 {
  "t": 24.17,
  "end": 33.93,
  "section": "궁금해요",
  "sub": "다른 천체의 둘레를 주기적으로 도는 일 = 공전"
 },
 {
  "t": 33.93,
  "end": 39.93,
  "section": "실험 준비",
  "sub": "지구본·관측자 모형·갓 없는 전등·면장갑을 준비해요"
 },
 {
  "t": 39.93,
  "end": 48.0,
  "section": "실험 준비",
  "sub": "전등을 등지고 서서 우리나라가 한밤이 되게 해요"
 },
 {
  "t": 48.0,
  "end": 55.13,
  "section": "실험 준비",
  "sub": "자전축 방향은 같게, 전등과의 거리는 일정하게"
 },
 {
  "t": 55.13,
  "end": 62.4,
  "section": "실험해요",
  "sub": "지구본을 가 → 나 → 다 → 라 위치로 옮기며 관찰해요"
 },
 {
  "t": 62.4,
  "end": 67.83,
  "section": "실험해요",
  "sub": "가 위치: 칠판, 시계, 시간표가 보여요"
 },
 {
  "t": 67.83,
  "end": 71.43,
  "section": "실험해요",
  "sub": "나 위치: 창문, 화분"
 },
 {
  "t": 71.43,
  "end": 75.07,
  "section": "실험해요",
  "sub": "다 위치: 사물함, 거울"
 },
 {
  "t": 75.07,
  "end": 78.17,
  "section": "실험해요",
  "sub": "라 위치: 창문, 출입문"
 },
 {
  "t": 78.17,
  "end": 83.17,
  "section": "실험해요",
  "sub": "보이는 모습은 어땠나요?"
 },
 {
  "t": 83.17,
  "end": 92.67,
  "section": "실험해요",
  "sub": "위치에 따라 보이는 모습이 달라져요"
 },
 {
  "t": 92.67,
  "end": 96.57,
  "section": "지구의 공전",
  "sub": "지구는 태양을 중심으로 일정한 길을 따라 돌아요"
 },
 {
  "t": 96.57,
  "end": 102.93,
  "section": "지구의 공전",
  "sub": "일 년에 한 바퀴, 서쪽에서 동쪽으로 — 지구의 공전"
 },
 {
  "t": 102.93,
  "end": 107.37,
  "section": "지구의 공전",
  "sub": "지구는 하루에 한 바퀴씩 자전하면서 공전해요"
 },
 {
  "t": 107.37,
  "end": 113.97,
  "section": "지구의 공전",
  "sub": "지구의 위치에 따라 밤하늘에 보이는 모습이 달라져요"
 },
 {
  "t": 113.97,
  "end": 116.67,
  "section": "자전과 공전",
  "sub": "자전일까요, 공전일까요?"
 },
 {
  "t": 116.67,
  "end": 123.63,
  "section": "자전과 공전",
  "sub": "자전: 자전축 중심·하루에 한 바퀴·낮과 밤"
 },
 {
  "t": 123.63,
  "end": 130.47,
  "section": "자전과 공전",
  "sub": "공전: 태양 중심·일 년에 한 바퀴·밤하늘이 달라져요"
 },
 {
  "t": 130.47,
  "end": 135.57,
  "section": "자전과 공전",
  "sub": "둘 다 서쪽에서 동쪽으로 회전해요"
 },
 {
  "t": 135.57,
  "end": 138.77,
  "section": "생각해요",
  "sub": "지구 주위를 공전하는 것을 모두 골라요"
 },
 {
  "t": 138.77,
  "end": 146.13,
  "section": "생각해요",
  "sub": "달과 인공위성은 지구 주위를 공전해요"
 },
 {
  "t": 146.13,
  "end": 154.37,
  "section": "한눈에 쏙",
  "sub": "지구의 공전"
 },
 {
  "t": 154.37,
  "end": 158.53,
  "section": "확인해요",
  "sub": "지구의 공전 — 옳으면 ○, 옳지 않으면 ×"
 },
 {
  "t": 158.53,
  "end": 163.53,
  "section": "확인해요",
  "sub": "○일까요, ×일까요?"
 },
 {
  "t": 163.53,
  "end": 172.3,
  "section": "확인해요",
  "sub": "⑵ × — 공전은 일 년에 한 바퀴, 하루에 한 바퀴는 자전"
 },
 {
  "t": 172.3,
  "end": 177.69,
  "section": "마무리",
  "sub": "지구는 태양을 중심으로 일 년에 한 바퀴씩 서쪽에서 동쪽으로 공전해요"
 },
 {
  "t": 177.69,
  "end": 184.47,
  "section": "마무리",
  "sub": "다음 영상: 6학년 24화 · 계절마다 다른 별자리"
 }
