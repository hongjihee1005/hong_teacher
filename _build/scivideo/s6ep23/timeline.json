  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 23화: 지구의 공전"
 },
 {
  "t": 5.5,
  "end": 9.23,
  "section": "궁금해요",
  "sub": "회전목마의 말은 무엇을 중심으로 돌고 있나요?"
 },
 {
  "t": 9.23,
  "end": 14.97,
  "section": "궁금해요",
  "sub": "가운데 세워진 기둥을 중심으로 돌아요"
 },
 {
  "t": 14.97,
  "end": 22.43,
  "section": "궁금해요",
  "sub": "회전하는 모습이 비슷한 것끼리 나누어요"
 },
 {
  "t": 22.43,
  "end": 31.83,
  "section": "궁금해요",
  "sub": "다른 천체의 둘레를 주기적으로 도는 일 = 공전"
 },
 {
  "t": 31.83,
  "end": 36.4,
  "section": "실험 준비",
  "sub": "지구본·관측자 모형·갓 없는 전등·면장갑을 준비해요"
 },
 {
  "t": 36.4,
  "end": 43.13,
  "section": "실험 준비",
  "sub": "전등을 등지고 서서 우리나라가 한밤이 되게 해요"
 },
 {
  "t": 43.13,
  "end": 49.4,
  "section": "실험 준비",
  "sub": "자전축 방향은 같게, 전등과의 거리는 일정하게"
 },
 {
  "t": 49.4,
  "end": 55.47,
  "section": "실험해요",
  "sub": "지구본을 가 → 나 → 다 → 라 위치로 옮기며 관찰해요"
 },
 {
  "t": 55.47,
  "end": 59.7,
  "section": "실험해요",
  "sub": "가 위치: 칠판, 시계, 시간표가 보여요"
 },
 {
  "t": 59.7,
  "end": 63.43,
  "section": "실험해요",
  "sub": "나 위치: 창문, 화분"
 },
 {
  "t": 63.43,
  "end": 67.17,
  "section": "실험해요",
  "sub": "다 위치: 사물함, 거울"
 },
 {
  "t": 67.17,
  "end": 70.4,
  "section": "실험해요",
  "sub": "라 위치: 창문, 출입문"
 },
 {
  "t": 70.4,
  "end": 75.4,
  "section": "실험해요",
  "sub": "보이는 모습은 어땠나요?"
 },
 {
  "t": 75.4,
  "end": 84.5,
  "section": "실험해요",
  "sub": "위치에 따라 보이는 모습이 달라져요"
 },
 {
  "t": 84.5,
  "end": 88.57,
  "section": "지구의 공전",
  "sub": "지구는 태양을 중심으로 일정한 길을 따라 돌아요"
 },
 {
  "t": 88.57,
  "end": 94.3,
  "section": "지구의 공전",
  "sub": "일 년에 한 바퀴, 서쪽에서 동쪽으로 — 지구의 공전"
 },
 {
  "t": 94.3,
  "end": 98.87,
  "section": "지구의 공전",
  "sub": "지구는 하루에 한 바퀴씩 자전하면서 공전해요"
 },
 {
  "t": 98.87,
  "end": 105.47,
  "section": "지구의 공전",
  "sub": "지구의 위치에 따라 밤하늘에 보이는 모습이 달라져요"
 },
 {
  "t": 105.47,
  "end": 107.87,
  "section": "자전과 공전",
  "sub": "자전일까요, 공전일까요?"
 },
 {
  "t": 107.87,
  "end": 114.07,
  "section": "자전과 공전",
  "sub": "자전: 자전축 중심·하루에 한 바퀴·낮과 밤"
 },
 {
  "t": 114.07,
  "end": 120.23,
  "section": "자전과 공전",
  "sub": "공전: 태양 중심·일 년에 한 바퀴·밤하늘이 달라져요"
 },
 {
  "t": 120.23,
  "end": 125.33,
  "section": "자전과 공전",
  "sub": "둘 다 서쪽에서 동쪽으로 회전해요"
 },
 {
  "t": 125.33,
  "end": 128.57,
  "section": "생각해요",
  "sub": "지구 주위를 공전하는 것을 모두 골라요"
 },
 {
  "t": 128.57,
  "end": 135.33,
  "section": "생각해요",
  "sub": "달과 인공위성은 지구 주위를 공전해요"
 },
 {
  "t": 135.33,
  "end": 143.93,
  "section": "한눈에 쏙",
  "sub": "지구의 공전"
 },
 {
  "t": 143.93,
  "end": 147.83,
  "section": "확인해요",
  "sub": "지구의 공전 — 옳으면 ○, 옳지 않으면 ×"
 },
 {
  "t": 147.83,
  "end": 152.83,
  "section": "확인해요",
  "sub": "○일까요, ×일까요?"
 },
 {
  "t": 152.83,
  "end": 160.33,
  "section": "확인해요",
  "sub": "⑵ × — 공전은 일 년에 한 바퀴, 하루에 한 바퀴는 자전"
 },
 {
  "t": 160.33,
  "end": 164.83,
  "section": "마무리",
  "sub": "지구는 태양을 중심으로 일 년에 한 바퀴씩 서쪽에서 동쪽으로 공전해요"
 },
 {
  "t": 164.83,
  "end": 170.83,
