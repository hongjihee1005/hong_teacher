[
 {
  "t": 0.0,
  "end": 6.93,
  "section": "오프닝",
  "sub": "「처음 배우는 과학」 3학년 8화: 극지방과 사막에 사는 동물"
 },
 {
  "t": 6.93,
  "end": 11.53,
  "section": "궁금해요",
  "sub": "추운 겨울날, 우리는 어떻게 추위를 견디나요?"
 },
 {
  "t": 11.53,
  "end": 19.0,
  "section": "궁금해요",
  "sub": "따뜻한 옷, 모자와 장갑, 목도리로 견뎌요"
 },
 {
  "t": 19.0,
  "end": 24.73,
  "section": "새 낱말",
  "sub": "극지방은 눈과 빙하로 덮여 있고 매우 추워요"
 },
 {
  "t": 24.73,
  "end": 32.2,
  "section": "새 낱말",
  "sub": "사막은 비가 적게 내려 건조하고, 낮과 밤의 온도 차이가 커요"
 },
 {
  "t": 32.2,
  "end": 37.5,
  "section": "새 낱말",
  "sub": "몹시 춥거나 건조한 곳에도 동물이 살까요?"
 },
 {
  "t": 37.5,
  "end": 45.17,
  "section": "실험해요",
  "sub": "극지방 동물은 추위를 어떻게 견딜까요?"
 },
 {
  "t": 45.17,
  "end": 49.23,
  "section": "실험해요",
  "sub": "① 큰 지퍼 백에 바셀린을 1/3 정도 넣어요"
 },
 {
  "t": 49.23,
  "end": 54.93,
  "section": "실험해요",
  "sub": "② ③ 두 큰 지퍼 백에 작은 지퍼 백을 하나씩 넣어요"
 },
 {
  "t": 54.93,
  "end": 62.87,
  "section": "실험해요",
  "sub": "④ 양손을 넣고 얼음물에 담가요"
 },
 {
  "t": 62.87,
  "end": 68.97,
  "section": "실험해요",
  "sub": "어느 쪽 손이 덜 차가울까요?"
 },
 {
  "t": 68.97,
  "end": 77.43,
  "section": "실험해요",
  "sub": "바셀린이 든 쪽 손이 덜 차가워요"
 },
 {
  "t": 77.43,
  "end": 81.5,
  "section": "정리해요",
  "sub": "얼음물은 극지방의 추운 환경이에요"
 },
 {
  "t": 81.5,
  "end": 87.93,
  "section": "정리해요",
  "sub": "바셀린은 동물의 두꺼운 지방이에요"
 },
 {
  "t": 87.93,
  "end": 95.83,
  "section": "정리해요",
  "sub": "두꺼운 지방은 추위를 견디게 도와줘요"
 },
 {
  "t": 95.83,
  "end": 99.37,
  "section": "생각 바로잡기",
  "sub": "지방이 스스로 열을 내서 따뜻해질까요?"
 },
 {
  "t": 99.37,
  "end": 111.23,
  "section": "생각 바로잡기",
  "sub": "따뜻함이 빠져나가는 것을 막아 체온을 유지해요"
 },
 {
  "t": 111.23,
  "end": 119.93,
  "section": "조사해요",
  "sub": "극지방에 사는 동물을 살펴봐요"
 },
 {
  "t": 119.93,
  "end": 123.47,
  "section": "조사해요",
  "sub": "북극곰은 몸이 촘촘한 털로 덮여 있어요"
 },
 {
  "t": 123.47,
  "end": 127.83,
  "section": "조사해요",
  "sub": "두꺼운 지방이 있어 체온을 유지해요"
 },
 {
  "t": 127.83,
  "end": 130.23,
  "section": "조사해요",
  "sub": "눈 위에 서 있는 순록이에요"
 },
 {
  "t": 130.23,
  "end": 135.07,
  "section": "조사해요",
  "sub": "발굽이 넓고 편평해요"
 },
 {
  "t": 135.07,
  "end": 140.1,
  "section": "조사해요",
  "sub": "그래서 눈에 발이 잘 빠지지 않아요"
 },
 {
  "t": 140.1,
  "end": 142.8,
  "section": "조사해요",
  "sub": "펭귄은 몸이 털로 덮여 있어요"
 },
 {
  "t": 142.8,
  "end": 146.27,
  "section": "조사해요",
  "sub": "여러 펭귄이 몸을 맞대 추위를 견뎌요"
 },
 {
  "t": 146.27,
  "end": 152.87,
  "section": "조사해요",
  "sub": "하프물범은 새끼 때 털이 흰색이고 빙하 위에서 살아요"
 },
 {
  "t": 152.87,
  "end": 162.3,
  "section": "조사해요",
  "sub": "사막에 사는 동물을 살펴봐요"
 },
 {
  "t": 162.3,
  "end": 169.37,
  "section": "조사해요",
  "sub": "낙타는 등의 혹에 지방을 저장해요"
 },
 {
  "t": 169.37,
  "end": 175.73,
  "section": "조사해요",
  "sub": "긴 눈썹과 귀 주위 털이 모래로부터 보호해요"
 },
 {
  "t": 175.73,
  "end": 180.0,
  "section": "조사해요",
  "sub": "사막여우는 몸에 비해 귀가 커요"
 },
 {
  "t": 180.0,
  "end": 185.0,
  "section": "조사해요",
  "sub": "큰 귀는 어떤 점이 좋을까요?"
 },
 {
  "t": 185.0,
  "end": 188.53,
  "section": "조사해요",
  "sub": "큰 귀로 몸속의 열을 내보내요"
 },
 {
  "t": 188.53,
  "end": 191.83,
  "section": "조사해요",
  "sub": "그리고 작은 소리도 잘 들어요"
 },
 {
  "t": 191.83,
  "end": 198.23,
  "section": "조사해요",
  "sub": "이집트땅거북은 등껍질이 돔 모양으로 높이 솟아 있어요"
 },
 {
  "t": 198.23,
  "end": 203.63,
  "section": "조사해요",
  "sub": "사막전갈은 돌 아래나 틈 사이에 숨어 살아요"
 },
 {
  "t": 203.63,
  "end": 209.5,
  "section": "분류해요",
  "sub": "어디에 살까요? 사는 곳에 따라 나누어 봐요"
 },
 {
  "t": 209.5,
  "end": 216.5,
  "section": "분류해요",
  "sub": "극지방? 사막?"
 },
 {
  "t": 216.5,
  "end": 222.37,
  "section": "분류해요",
  "sub": "북극곰·순록·하프물범·펭귄은 극지방에 살아요"
 },
 {
  "t": 222.37,
  "end": 229.07,
  "section": "분류해요",
  "sub": "낙타·사막여우·사막전갈·이집트땅거북은 사막에 살아요"
 },
 {
  "t": 229.07,
  "end": 234.5,
  "section": "분류해요",
  "sub": "몹시 춥거나 건조한 곳에도 여러 동물이 살아요"
 },
 {
  "t": 234.5,
  "end": 241.0,
  "section": "정리해요",
  "sub": "극지방 동물은 지방·털로 추위를 견뎌요"
 },
 {
  "t": 241.0,
  "end": 248.53,
  "section": "정리해요",
  "sub": "사막 동물은 큰 귀·혹으로 건조한 환경을 견뎌요"
 },
 {
  "t": 248.53,
  "end": 256.3,
  "section": "정리해요",
  "sub": "빛이 거의 없는 곳에 사는 동물은 어떤 특징이 있을까요?"
 },
 {
  "t": 256.3,
  "end": 261.3,
  "section": "정리해요",
  "sub": "친구와 이야기해 봐요"
 },
 {
  "t": 261.3,
  "end": 273.4,
  "section": "정리해요",
  "sub": "박쥐는 초음파로, 초롱아귀는 빛을 내는 촉수로 먹이를 찾아요"
 },
 {
  "t": 273.4,
  "end": 277.13,
  "section": "확인해요",
  "sub": "다음 설명에 해당하는 동물은?"
 },
 {
  "t": 277.13,
  "end": 283.13,
  "section": "확인해요",
  "sub": "어느 동물일까요?"
 },
 {
  "t": 283.13,
  "end": 291.1,
  "section": "확인해요",
  "sub": "정답은 ② 북극곰이에요"
 },
 {
  "t": 291.1,
  "end": 295.1,
  "section": "확인해요",
  "sub": "맞으면 ○, 틀리면 ×를 골라요"
 },
 {
  "t": 295.1,
  "end": 300.9,
  "section": "확인해요",
  "sub": "○일까요, ×일까요?"
 },
 {
  "t": 300.9,
  "end": 310.17,
  "section": "확인해요",
  "sub": "1번 ○, 2번 × — 사막여우는 큰 귀로 열을 내보내요"
 },
 {
  "t": 310.17,
  "end": 320.5,
  "section": "마무리",
  "sub": "극지방 동물은 두꺼운 지방·촘촘한 털로 추위를 견디고 사막 동물은 큰 귀·혹으로 건조한 환경을 견뎌요"
 },
 {
  "t": 320.5,
  "end": 328.97,
  "section": "마무리",
  "sub": "다음 영상: 처음 배우는 과학 3학년 9화 · 동물의 특징을 본뜬 생활용품"
 }
