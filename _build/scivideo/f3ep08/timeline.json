[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「처음 배우는 과학」 3학년 8화: 극지방과 사막에 사는 동물"
 },
 {
  "t": 5.47,
  "end": 9.67,
  "section": "궁금해요",
  "sub": "추운 겨울날, 우리는 어떻게 추위를 견디나요?"
 },
 {
  "t": 9.67,
  "end": 15.73,
  "section": "궁금해요",
  "sub": "따뜻한 옷, 모자와 장갑, 목도리로 견뎌요"
 },
 {
  "t": 15.73,
  "end": 19.93,
  "section": "새 낱말",
  "sub": "극지방은 눈과 빙하로 덮여 있고 매우 추워요"
 },
 {
  "t": 19.93,
  "end": 25.13,
  "section": "새 낱말",
  "sub": "사막은 비가 적게 내려 건조하고, 낮과 밤의 온도 차이가 커요"
 },
 {
  "t": 25.13,
  "end": 30.2,
  "section": "새 낱말",
  "sub": "몹시 춥거나 건조한 곳에도 동물이 살까요?"
 },
 {
  "t": 30.2,
  "end": 36.93,
  "section": "실험해요",
  "sub": "극지방 동물은 추위를 어떻게 견딜까요?"
 },
 {
  "t": 36.93,
  "end": 40.8,
  "section": "실험해요",
  "sub": "① 큰 지퍼 백에 바셀린을 1/3 정도 넣어요"
 },
 {
  "t": 40.8,
  "end": 46.0,
  "section": "실험해요",
  "sub": "② ③ 두 큰 지퍼 백에 작은 지퍼 백을 하나씩 넣어요"
 },
 {
  "t": 46.0,
  "end": 52.67,
  "section": "실험해요",
  "sub": "④ 양손을 넣고 얼음물에 담가요"
 },
 {
  "t": 52.67,
  "end": 58.8,
  "section": "실험해요",
  "sub": "어느 쪽 손이 덜 차가울까요?"
 },
 {
  "t": 58.8,
  "end": 66.0,
  "section": "실험해요",
  "sub": "바셀린이 든 쪽 손이 덜 차가워요"
 },
 {
  "t": 66.0,
  "end": 69.87,
  "section": "정리해요",
  "sub": "얼음물은 극지방의 추운 환경이에요"
 },
 {
  "t": 69.87,
  "end": 75.27,
  "section": "정리해요",
  "sub": "바셀린은 동물의 두꺼운 지방이에요"
 },
 {
  "t": 75.27,
  "end": 82.87,
  "section": "정리해요",
  "sub": "두꺼운 지방은 추위를 견디게 도와줘요"
 },
 {
  "t": 82.87,
  "end": 86.4,
  "section": "생각 바로잡기",
  "sub": "지방이 스스로 열을 내서 따뜻해질까요?"
 },
 {
  "t": 86.4,
  "end": 97.13,
  "section": "생각 바로잡기",
  "sub": "따뜻함이 빠져나가는 것을 막아 체온을 유지해요"
 },
 {
  "t": 97.13,
  "end": 103.0,
  "section": "조사해요",
  "sub": "극지방에 사는 동물을 살펴봐요"
 },
 {
  "t": 103.0,
  "end": 106.2,
  "section": "조사해요",
  "sub": "북극곰은 몸이 촘촘한 털로 덮여 있어요"
 },
 {
  "t": 106.2,
  "end": 110.67,
  "section": "조사해요",
  "sub": "두꺼운 지방이 있어 체온을 유지해요"
 },
 {
  "t": 110.67,
  "end": 113.07,
  "section": "조사해요",
  "sub": "눈 위에 서 있는 순록이에요"
 },
 {
  "t": 113.07,
  "end": 116.6,
  "section": "조사해요",
  "sub": "발굽이 넓고 편평해요"
 },
 {
  "t": 116.6,
  "end": 121.4,
  "section": "조사해요",
  "sub": "그래서 눈에 발이 잘 빠지지 않아요"
 },
 {
  "t": 121.4,
  "end": 123.93,
  "section": "조사해요",
  "sub": "펭귄은 몸이 털로 덮여 있어요"
 },
 {
  "t": 123.93,
  "end": 127.33,
  "section": "조사해요",
  "sub": "여러 펭귄이 몸을 맞대 추위를 견뎌요"
 },
 {
  "t": 127.33,
  "end": 133.0,
  "section": "조사해요",
  "sub": "하프물범은 새끼 때 털이 흰색이고 빙하 위에서 살아요"
 },
 {
  "t": 133.0,
  "end": 139.87,
  "section": "조사해요",
  "sub": "사막에 사는 동물을 살펴봐요"
 },
 {
  "t": 139.87,
  "end": 145.6,
  "section": "조사해요",
  "sub": "낙타는 등의 혹에 지방을 저장해요"
 },
 {
  "t": 145.6,
  "end": 150.93,
  "section": "조사해요",
  "sub": "긴 눈썹과 귀 주위 털이 모래로부터 보호해요"
 },
 {
  "t": 150.93,
  "end": 154.33,
  "section": "조사해요",
  "sub": "사막여우는 몸에 비해 귀가 커요"
 },
 {
  "t": 154.33,
  "end": 159.33,
  "section": "조사해요",
  "sub": "큰 귀는 어떤 점이 좋을까요?"
 },
 {
  "t": 159.33,
  "end": 162.73,
  "section": "조사해요",
  "sub": "큰 귀로 몸속의 열을 내보내요"
 },
 {
  "t": 162.73,
  "end": 165.87,
  "section": "조사해요",
  "sub": "그리고 작은 소리도 잘 들어요"
 },
 {
  "t": 165.87,
  "end": 171.07,
  "section": "조사해요",
  "sub": "이집트땅거북은 등껍질이 돔 모양으로 높이 솟아 있어요"
 },
 {
  "t": 171.07,
  "end": 176.33,
  "section": "조사해요",
  "sub": "사막전갈은 돌 아래나 틈 사이에 숨어 살아요"
 },
 {
  "t": 176.33,
  "end": 181.07,
  "section": "분류해요",
  "sub": "어디에 살까요? 사는 곳에 따라 나누어 봐요"
 },
 {
  "t": 181.07,
  "end": 188.07,
  "section": "분류해요",
  "sub": "극지방? 사막?"
 },
 {
  "t": 188.07,
  "end": 192.27,
  "section": "분류해요",
  "sub": "북극곰·순록·하프물범·펭귄은 극지방에 살아요"
 },
 {
  "t": 192.27,
  "end": 197.13,
  "section": "분류해요",
  "sub": "낙타·사막여우·사막전갈·이집트땅거북은 사막에 살아요"
 },
 {
  "t": 197.13,
  "end": 202.4,
  "section": "분류해요",
  "sub": "몹시 춥거나 건조한 곳에도 여러 동물이 살아요"
 },
 {
  "t": 202.4,
  "end": 208.8,
  "section": "정리해요",
  "sub": "극지방 동물은 지방·털로 추위를 견뎌요"
 },
 {
  "t": 208.8,
  "end": 216.13,
  "section": "정리해요",
  "sub": "사막 동물은 큰 귀·혹으로 건조한 환경을 견뎌요"
 },
 {
  "t": 216.13,
  "end": 222.67,
  "section": "정리해요",
  "sub": "빛이 거의 없는 곳에 사는 동물은 어떤 특징이 있을까요?"
 },
 {
  "t": 222.67,
  "end": 227.67,
  "section": "정리해요",
  "sub": "친구와 이야기해 봐요"
 },
 {
  "t": 227.67,
  "end": 238.93,
  "section": "정리해요",
  "sub": "박쥐는 초음파로, 초롱아귀는 빛을 내는 촉수로 먹이를 찾아요"
 },
 {
  "t": 238.93,
  "end": 242.47,
  "section": "확인해요",
  "sub": "다음 설명에 해당하는 동물은?"
 },
 {
  "t": 242.47,
  "end": 248.47,
  "section": "확인해요",
  "sub": "어느 동물일까요?"
 },
 {
  "t": 248.47,
  "end": 255.47,
  "section": "확인해요",
  "sub": "정답은 ② 북극곰이에요"
 },
 {
  "t": 255.47,
  "end": 259.0,
  "section": "확인해요",
  "sub": "맞으면 ○, 틀리면 ×를 골라요"
 },
 {
  "t": 259.0,
  "end": 264.8,
  "section": "확인해요",
  "sub": "○일까요, ×일까요?"
 },
 {
  "t": 264.8,
  "end": 272.27,
  "section": "확인해요",
  "sub": "1번 ○, 2번 × — 사막여우는 큰 귀로 열을 내보내요"
 },
 {
  "t": 272.27,
  "end": 276.77,
  "section": "마무리",
  "sub": "극지방 동물은 두꺼운 지방·촘촘한 털로 추위를 견디고 사막 동물은 큰 귀·혹으로 건조한 환경을 견뎌요"
 },
 {
  "t": 276.77,
  "end": 282.73,
  "section": "마무리",
  "sub": "다음 영상: 처음 배우는 과학 3학년 9화 · 동물의 특징을 본뜬 생활용품"
 }
]