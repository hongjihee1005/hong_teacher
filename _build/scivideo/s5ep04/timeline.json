 {
  "t": 63.87,
  "end": 70.93,
  "section": "관찰해요",
  "sub": "은행잎 화석은 은행잎, 새 발자국 화석은 새의 발자국과 닮았어요"
 },
 {
  "t": 70.93,
  "end": 78.33,
  "section": "관찰해요",
  "sub": "오늘날의 생물과 생김새가 비슷한 화석도 있어요"
 },
 {
  "t": 78.33,
  "end": 88.87,
  "section": "몸체와 흔적",
  "sub": "생물의 몸체뿐만 아니라 흔적도 화석이 될 수 있어요"
 },
 {
  "t": 88.87,
  "end": 95.4,
  "section": "몸체와 흔적",
