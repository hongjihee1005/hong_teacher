 },
 {
  "t": 69.23,
  "end": 74.0,
  "section": "실험해요",
  "sub": "펌프를 쥐었다 펴면 붉은 색소 물은 어떻게 이동할까요?"
 },
 {
  "t": 74.0,
  "end": 79.0,
  "section": "실험해요",
  "sub": "붉은 색소 물은 어느 쪽으로 갈까요?"
 },
 {
  "t": 79.0,
  "end": 83.83,
  "section": "실험해요",
  "sub": "쥐면 잠기지 않은 호스 쪽으로 물이 나가요"
 },
 {
  "t": 83.83,
  "end": 88.63,
  "section": "실험해요",
  "sub": "펴면 잠긴 호스 쪽 물이 펌프로 들어와요"
 },
 {
  "t": 88.63,
  "end": 94.7,
  "section": "실험해요",
  "sub": "붉은 색소 물은 한 방향으로만 이동해요"
 },
 {
  "t": 94.7,
  "end": 103.27,
  "section": "실험해요",
  "sub": "펌프를 빠르게 쥐었다 펴면 물이 더 빨리 이동해요"
 },
 {
  "t": 103.27,
  "end": 107.87,
  "section": "모형과 우리 몸",
  "sub": "모형의 각 부분은 우리 몸의 어떤 부분과 같을까요?"
 },
 {
  "t": 107.87,
  "end": 114.33,
  "section": "모형과 우리 몸",
  "sub": "붉은 색소 물은 혈액, 호스는 혈관, 펌프는 심장이에요"
