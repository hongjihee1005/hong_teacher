 {
  "t": 141.0,
  "end": 146.07,
  "section": "혈액 순환",
  "sub": "붉은 혈관과 푸른 혈관은 서로 연결되어 있지 않을까요?"
 },
 {
  "t": 146.07,
  "end": 158.43,
  "section": "혈액 순환",
  "sub": "아니에요. 두 혈관은 아주 가는 혈관으로 이어져 있어요"
 },
 {
  "t": 158.43,
  "end": 164.5,
  "section": "생활 속에서",
  "sub": "심장이 멈추면 왜 빨리 심폐 소생술을 해야 할까요?"
 },
 {
  "t": 164.5,
  "end": 169.17,
  "section": "생활 속에서",
  "sub": "심장이 하는 일을 떠올려 봐요"
