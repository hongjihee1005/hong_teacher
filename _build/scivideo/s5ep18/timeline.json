  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 18화: 혈액은 어떻게 온몸을 돌까?"
 },
 {
  "t": 6.9,
  "end": 13.8,
  "section": "궁금해요",
  "sub": "응급 상황에 쓰는 도구의 표시예요. 무엇을 뜻할까요?"
 },
 {
  "t": 13.8,
  "end": 18.8,
  "section": "궁금해요",
  "sub": "하트 모양은 무엇을 뜻할까요?"
 },
 {
  "t": 18.8,
  "end": 27.13,
  "section": "궁금해요",
  "sub": "하트와 번개 모양은 심장을 뜻해요"
 },
 {
  "t": 27.13,
  "end": 39.2,
  "section": "궁금해요",
  "sub": "혈액이 온몸을 도는 것이 혈액 순환, 담당 기관이 순환기관이에요"
 },
 {
  "t": 39.2,
  "end": 42.53,
