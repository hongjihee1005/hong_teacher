[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 33화: 소리는 무엇을 통해 전달될까?"
 },
 {
  "t": 5.5,
  "end": 10.1,
  "section": "궁금해요",
  "sub": "새가 지저귀는 소리는 무엇을 통해 전달될까요?"
 },
 {
  "t": 10.1,
  "end": 14.1,
  "section": "궁금해요",
  "sub": "무엇을 통해 전달될까요?"
 },
 {
  "t": 14.1,
  "end": 18.9,
  "section": "궁금해요",
  "sub": "새소리는 공기를 통해 우리 귀까지 전달돼요"
 },
 {
  "t": 18.9,
  "end": 22.8,
  "section": "공기",
  "sub": "통 안에 탈지면을 깔고 스피커를 넣은 뒤 뚜껑을 닫아요"
 },
 {
  "t": 22.8,
  "end": 27.2,
  "section": "공기",
  "sub": "스피커를 켜면 소리가 잘 들려요"
 },
 {
  "t": 27.2,
  "end": 32.77,
  "section": "공기",
  "sub": "손잡이를 당겨 공기를 빼면 어떻게 될까요?"
 },
 {
  "t": 32.77,
  "end": 38.67,
  "section": "공기",
  "sub": "공기를 빼면 소리는?"
 },
 {
  "t": 38.67,
  "end": 42.1,
  "section": "공기",
  "sub": "공기를 거의 빼면 소리가 아주 작게 들려요"
 },
 {
  "t": 42.1,
  "end": 45.53,
  "section": "공기",
  "sub": "공기를 다시 넣으면 다시 잘 들려요"
 },
 {
  "t": 45.53,
  "end": 54.17,
  "section": "공기",
  "sub": "소리는 공기(기체)를 통해 전달돼요"
 },
 {
  "t": 54.17,
  "end": 59.6,
  "section": "물",
  "sub": "수조의 물속에서 캐스터네츠를 부딪쳐요"
 },
 {
  "t": 59.6,
  "end": 64.0,
  "section": "물",
  "sub": "물 밖에서 들릴까요?"
 },
 {
  "t": 64.0,
  "end": 68.27,
  "section": "물",
  "sub": "물속에서 부딪쳐도 소리가 들려요"
 },
 {
  "t": 68.27,
  "end": 76.73,
  "section": "물",
  "sub": "소리가 물(액체)을 통해 전달된 뒤 공기를 거쳐 귀까지 와요"
 },
 {
  "t": 76.73,
  "end": 83.33,
  "section": "나무",
  "sub": "친구가 연필로 책상을 살짝 두드려요"
 },
 {
  "t": 83.33,
  "end": 90.17,
  "section": "나무",
  "sub": "다른 책상에서는 두드리는 소리가 거의 들리지 않아요"
 },
 {
  "t": 90.17,
  "end": 94.93,
  "section": "나무",
  "sub": "같은 책상에 귀를 대면 어떨까요?"
 },
 {
  "t": 94.93,
  "end": 100.03,
  "section": "나무",
  "sub": "같은 책상에서는?"
 },
 {
  "t": 100.03,
  "end": 105.13,
  "section": "나무",
  "sub": "같은 책상에서는 소리가 또렷하게 들려요"
 },
 {
  "t": 105.13,
  "end": 111.77,
  "section": "나무",
  "sub": "소리는 나무(고체)를 통해 전달돼요"
 },
 {
  "t": 111.77,
  "end": 114.2,
  "section": "실 전화기",
  "sub": "실 전화기로 이야기해요"
 },
 {
  "t": 114.2,
  "end": 120.97,
  "section": "실 전화기",
  "sub": "실을 팽팽하게 하면 소리가 잘 전달돼요"
 },
 {
  "t": 120.97,
  "end": 125.57,
  "section": "실 전화기",
  "sub": "실이 느슨하면 거의 들리지 않아요"
 },
 {
  "t": 125.57,
  "end": 132.53,
  "section": "실 전화기",
  "sub": "실(고체)을 통해서도 소리가 전달돼요"
 },
 {
  "t": 132.53,
  "end": 138.27,
  "section": "정리해요",
  "sub": "여러 가지 예를 고체·액체·기체로 나눠 봐요"
 },
 {
  "t": 138.27,
  "end": 142.27,
  "section": "정리해요",
  "sub": "소리를 전달한 물질은?"
 },
 {
  "t": 142.27,
  "end": 151.5,
  "section": "정리해요",
  "sub": "목소리·종소리는 기체, 물속 스피커는 액체, 철봉·실은 고체"
 },
 {
  "t": 151.5,
  "end": 157.77,
  "section": "정리해요",
  "sub": "소리는 여러 가지 물질을 통해 전달돼요"
 },
 {
  "t": 157.77,
  "end": 160.33,
  "section": "더 알아보기",
  "sub": "우주에서는 소리가 들릴까요?"
 },
 {
  "t": 160.33,
  "end": 168.73,
  "section": "더 알아보기",
  "sub": "우주에는 소리를 전달할 공기가 거의 없어요"
 },
 {
  "t": 168.73,
  "end": 172.23,
  "section": "더 알아보기",
  "sub": "공기를 뺀 장치에서 소리가 작아진 것과 같은 까닭이에요"
 },
 {
  "t": 172.23,
  "end": 176.73,
  "section": "마무리",
  "sub": "소리는 고체, 액체, 기체 상태인 여러 가지 물질을 통해 전달돼요"
 },
 {
  "t": 176.73,
  "end": 182.73,
  "section": "마무리",
  "sub": "다음 영상: 3학년 34화 · 소음을 줄이려면?"
 }
]