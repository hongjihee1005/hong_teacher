[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 33화: 소리는 무엇을 통해 전달될까?"
 },
 {
  "t": 5.47,
  "end": 10.07,
  "section": "궁금해요",
  "sub": "새가 지저귀는 소리는 무엇을 통해 전달될까요?"
 },
 {
  "t": 10.07,
  "end": 14.07,
  "section": "궁금해요",
  "sub": "무엇을 통해 전달될까요?"
 },
 {
  "t": 14.07,
  "end": 22.07,
  "section": "궁금해요",
  "sub": "새소리는 공기를 통해 우리 귀까지 전달돼요"
 },
 {
  "t": 22.07,
  "end": 27.33,
  "section": "공기",
  "sub": "통 안에 탈지면을 깔고 스피커를 넣은 뒤 뚜껑을 닫아요"
 },
 {
  "t": 27.33,
  "end": 31.8,
  "section": "공기",
  "sub": "스피커를 켜면 소리가 잘 들려요"
 },
 {
  "t": 31.8,
  "end": 37.4,
  "section": "공기",
  "sub": "손잡이를 당겨 공기를 빼면 어떻게 될까요?"
 },
 {
  "t": 37.4,
  "end": 43.4,
  "section": "공기",
  "sub": "공기를 빼면 소리는?"
 },
 {
  "t": 43.4,
  "end": 46.8,
  "section": "공기",
  "sub": "공기를 거의 빼면 소리가 아주 작게 들려요"
 },
 {
  "t": 46.8,
  "end": 50.2,
  "section": "공기",
  "sub": "공기를 다시 넣으면 다시 잘 들려요"
 },
 {
  "t": 50.2,
  "end": 60.13,
  "section": "공기",
  "sub": "소리는 공기(기체)를 통해 전달돼요"
 },
 {
  "t": 60.13,
  "end": 67.07,
  "section": "물",
  "sub": "수조의 물속에서 캐스터네츠를 부딪쳐요"
 },
 {
  "t": 67.07,
  "end": 71.47,
  "section": "물",
  "sub": "물 밖에서 들릴까요?"
 },
 {
  "t": 71.47,
  "end": 75.73,
  "section": "물",
  "sub": "물속에서 부딪쳐도 소리가 들려요"
 },
 {
  "t": 75.73,
  "end": 86.07,
  "section": "물",
  "sub": "소리가 물(액체)을 통해 전달된 뒤 공기를 거쳐 귀까지 와요"
 },
 {
  "t": 86.07,
  "end": 92.67,
  "section": "나무",
  "sub": "친구가 연필로 책상을 살짝 두드려요"
 },
 {
  "t": 92.67,
  "end": 99.53,
  "section": "나무",
  "sub": "다른 책상에서는 두드리는 소리가 거의 들리지 않아요"
 },
 {
  "t": 99.53,
  "end": 104.33,
  "section": "나무",
  "sub": "같은 책상에 귀를 대면 어떨까요?"
 },
 {
  "t": 104.33,
  "end": 109.53,
  "section": "나무",
  "sub": "같은 책상에서는?"
 },
 {
  "t": 109.53,
  "end": 114.67,
  "section": "나무",
  "sub": "같은 책상에서는 소리가 또렷하게 들려요"
 },
 {
  "t": 114.67,
  "end": 121.33,
  "section": "나무",
  "sub": "소리는 나무(고체)를 통해 전달돼요"
 },
 {
  "t": 121.33,
  "end": 126.93,
  "section": "실 전화기",
  "sub": "실 전화기로 이야기해요"
 },
 {
  "t": 126.93,
  "end": 133.73,
  "section": "실 전화기",
  "sub": "실을 팽팽하게 하면 소리가 잘 전달돼요"
 },
 {
  "t": 133.73,
  "end": 138.33,
  "section": "실 전화기",
  "sub": "실이 느슨하면 거의 들리지 않아요"
 },
 {
  "t": 138.33,
  "end": 145.33,
  "section": "실 전화기",
  "sub": "실(고체)을 통해서도 소리가 전달돼요"
 },
 {
  "t": 145.33,
  "end": 151.07,
  "section": "정리해요",
  "sub": "여러 가지 예를 고체·액체·기체로 나눠 봐요"
 },
 {
  "t": 151.07,
  "end": 156.07,
  "section": "정리해요",
  "sub": "소리를 전달한 물질은?"
 },
 {
  "t": 156.07,
  "end": 165.27,
  "section": "정리해요",
  "sub": "목소리·종소리는 기체, 물속 스피커는 액체, 철봉·실은 고체"
 },
 {
  "t": 165.27,
  "end": 171.53,
  "section": "정리해요",
  "sub": "소리는 여러 가지 물질을 통해 전달돼요"
 },
 {
  "t": 171.53,
  "end": 174.07,
  "section": "더 알아보기",
  "sub": "우주에서는 소리가 들릴까요?"
 },
 {
  "t": 174.07,
  "end": 178.07,
  "section": "더 알아보기",
  "sub": "우주에서는 소리가 들릴까요?"
 },
 {
  "t": 178.07,
  "end": 186.47,
  "section": "더 알아보기",
  "sub": "우주에는 소리를 전달할 공기가 거의 없어요"
 },
 {
  "t": 186.47,
  "end": 191.8,
  "section": "더 알아보기",
  "sub": "공기를 뺀 장치에서 소리가 작아진 것과 같은 까닭이에요"
 },
 {
  "t": 191.8,
  "end": 196.3,
  "section": "마무리",
  "sub": "소리는 고체, 액체, 기체 상태인 여러 가지 물질을 통해 전달돼요"
 },
 {
  "t": 196.3,
  "end": 202.27,
  "section": "마무리",
  "sub": "다음 영상: 3학년 34화 · 소음을 줄이려면?"
 }
]