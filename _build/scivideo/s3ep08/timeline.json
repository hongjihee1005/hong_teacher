[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 8화: 극지방과 사막에 사는 동물"
 },
 {
  "t": 5.5,
  "end": 12.27,
  "section": "궁금해요",
  "sub": "추운 겨울날, 우리는 어떻게 추위를 견디나요?"
 },
 {
  "t": 12.27,
  "end": 15.83,
  "section": "궁금해요",
  "sub": "극지방은 눈과 빙하로 덮여 있고 매우 추워요"
 },
 {
  "t": 15.83,
  "end": 21.73,
  "section": "궁금해요",
  "sub": "사막은 건조하고, 낮과 밤의 온도 차이가 커요"
 },
 {
  "t": 21.73,
  "end": 28.43,
  "section": "실험해요",
  "sub": "극지방 동물은 추위를 어떻게 견딜까요?"
 },
 {
  "t": 28.43,
  "end": 32.3,
  "section": "실험해요",
  "sub": "① 큰 지퍼 백에 바셀린을 1/3 정도 넣어요"
 },
 {
  "t": 32.3,
  "end": 35.87,
  "section": "실험해요",
  "sub": "② ③ 두 큰 지퍼 백에 작은 지퍼 백을 하나씩 넣어요"
 },
 {
  "t": 35.87,
  "end": 44.1,
  "section": "실험해요",
  "sub": "④ 양손을 넣고 얼음물에 담가요"
 },
 {
  "t": 44.1,
  "end": 50.2,
  "section": "실험해요",
  "sub": "어느 쪽 손이 덜 차가울까요?"
 },
 {
  "t": 50.2,
  "end": 56.87,
  "section": "실험해요",
  "sub": "바셀린이 든 쪽 손이 덜 차가워요"
 },
 {
  "t": 56.87,
  "end": 67.63,
  "section": "실험해요",
  "sub": "얼음물은 극지방의 추운 환경, 바셀린은 두꺼운 지방"
 },
 {
  "t": 67.63,
  "end": 71.2,
  "section": "생각 바로잡기",
  "sub": "지방이 스스로 열을 내서 따뜻해질까요?"
 },
 {
  "t": 71.2,
  "end": 81.97,
  "section": "생각 바로잡기",
  "sub": "따뜻함이 빠져나가는 것을 막아 체온을 유지해요"
 },
 {
  "t": 81.97,
  "end": 86.53,
  "section": "조사해요",
  "sub": "극지방에 사는 동물을 살펴봐요"
 },
 {
  "t": 86.53,
  "end": 92.27,
  "section": "조사해요",
  "sub": "북극곰 — 촘촘한 털, 두꺼운 지방"
 },
 {
  "t": 92.27,
  "end": 96.5,
  "section": "조사해요",
  "sub": "순록 — 넓고 편평한 발굽"
 },
 {
  "t": 96.5,
  "end": 101.4,
  "section": "조사해요",
  "sub": "하프물범 — 새끼 때 흰 털, 빙하 위에서 생활"
 },
 {
  "t": 101.4,
  "end": 107.4,
  "section": "조사해요",
  "sub": "펭귄 — 털, 몸을 맞대 추위를 견뎌요"
 },
 {
  "t": 107.4,
  "end": 112.63,
  "section": "조사해요",
  "sub": "사막에 사는 동물을 살펴봐요"
 },
 {
  "t": 112.63,
  "end": 120.53,
  "section": "조사해요",
  "sub": "낙타 — 혹에 지방 저장, 긴 눈썹"
 },
 {
  "t": 120.53,
  "end": 124.53,
  "section": "조사해요",
  "sub": "큰 귀는 어떤 점이 좋을까요?"
 },
 {
  "t": 124.53,
  "end": 130.27,
  "section": "조사해요",
  "sub": "사막여우 — 몸에 비해 큰 귀 열을 내보내요"
 },
 {
  "t": 130.27,
  "end": 135.5,
  "section": "조사해요",
  "sub": "이집트땅거북 — 작은 몸, 돔 모양 등껍질"
 },
 {
  "t": 135.5,
  "end": 140.77,
  "section": "조사해요",
  "sub": "사막전갈 — 돌 아래·틈에 숨어 살아요"
 },
 {
  "t": 140.77,
  "end": 147.17,
  "section": "정리해요",
  "sub": "극지방 동물은 지방·털로 추위를 견뎌요"
 },
 {
  "t": 147.17,
  "end": 155.1,
  "section": "정리해요",
  "sub": "사막 동물은 큰 귀·혹으로 건조한 환경을 견뎌요"
 },
 {
  "t": 155.1,
  "end": 158.67,
  "section": "확인해요",
  "sub": "다음 설명에 해당하는 동물은?"
 },
 {
  "t": 158.67,
  "end": 164.67,
  "section": "확인해요",
  "sub": "어느 동물일까요?"
 },
 {
  "t": 164.67,
  "end": 167.67,
  "section": "확인해요",
  "sub": "정답은 ② 북극곰이에요"
 },
 {
  "t": 167.67,
  "end": 172.17,
  "section": "마무리",
  "sub": "극지방 동물은 두꺼운 지방·촘촘한 털로 추위를 견디고 사막 동물은 큰 귀·혹으로 건조한 환경을 견뎌요"
 },
 {
