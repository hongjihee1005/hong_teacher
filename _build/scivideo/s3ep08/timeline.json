[
 {
  "t": 0.0,
  "end": 6.83,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 8화: 극지방과 사막에 사는 동물"
 },
 {
  "t": 6.83,
  "end": 14.67,
  "section": "궁금해요",
  "sub": "추운 겨울날, 우리는 어떻게 추위를 견디나요?"
 },
 {
  "t": 14.67,
  "end": 18.3,
  "section": "궁금해요",
  "sub": "극지방은 눈과 빙하로 덮여 있고 매우 추워요"
 },
 {
  "t": 18.3,
  "end": 24.97,
  "section": "궁금해요",
  "sub": "사막은 건조하고, 낮과 밤의 온도 차이가 커요"
 },
 {
  "t": 24.97,
  "end": 32.13,
  "section": "실험해요",
  "sub": "극지방 동물은 추위를 어떻게 견딜까요?"
 },
 {
  "t": 32.13,
  "end": 35.93,
  "section": "실험해요",
  "sub": "① 큰 지퍼 백에 바셀린을 1/3 정도 넣어요"
 },
 {
  "t": 35.93,
  "end": 39.43,
  "section": "실험해요",
  "sub": "② ③ 두 큰 지퍼 백에 작은 지퍼 백을 하나씩 넣어요"
 },
 {
  "t": 39.43,
  "end": 49.13,
  "section": "실험해요",
  "sub": "④ 양손을 넣고 얼음물에 담가요"
 },
 {
  "t": 49.13,
  "end": 55.23,
  "section": "실험해요",
  "sub": "어느 쪽 손이 덜 차가울까요?"
 },
 {
  "t": 55.23,
  "end": 62.63,
  "section": "실험해요",
  "sub": "바셀린이 든 쪽 손이 덜 차가워요"
 },
 {
  "t": 62.63,
  "end": 74.53,
  "section": "실험해요",
  "sub": "얼음물은 극지방의 추운 환경, 바셀린은 두꺼운 지방"
 },
 {
  "t": 74.53,
  "end": 77.87,
  "section": "생각 바로잡기",
  "sub": "지방이 스스로 열을 내서 따뜻해질까요?"
 },
 {
  "t": 77.87,
  "end": 89.03,
  "section": "생각 바로잡기",
  "sub": "따뜻함이 빠져나가는 것을 막아 체온을 유지해요"
 },
 {
  "t": 89.03,
  "end": 94.93,
  "section": "조사해요",
  "sub": "극지방에 사는 동물을 살펴봐요"
 },
 {
  "t": 94.93,
  "end": 101.23,
  "section": "조사해요",
  "sub": "북극곰 — 촘촘한 털, 두꺼운 지방"
 },
 {
  "t": 101.23,
  "end": 105.43,
  "section": "조사해요",
  "sub": "순록 — 넓고 편평한 발굽"
 },
 {
  "t": 105.43,
  "end": 110.93,
  "section": "조사해요",
  "sub": "하프물범 — 새끼 때 흰 털, 빙하 위에서 생활"
 },
 {
  "t": 110.93,
  "end": 117.63,
  "section": "조사해요",
  "sub": "펭귄 — 털, 몸을 맞대 추위를 견뎌요"
 },
 {
  "t": 117.63,
  "end": 124.1,
  "section": "조사해요",
  "sub": "사막에 사는 동물을 살펴봐요"
 },
 {
  "t": 124.1,
  "end": 132.67,
  "section": "조사해요",
  "sub": "낙타 — 혹에 지방 저장, 긴 눈썹"
 },
 {
  "t": 132.67,
  "end": 137.33,
  "section": "조사해요",
  "sub": "큰 귀는 어떤 점이 좋을까요?"
 },
 {
  "t": 137.33,
  "end": 143.7,
  "section": "조사해요",
  "sub": "사막여우 — 몸에 비해 큰 귀 열을 내보내요"
 },
 {
  "t": 143.7,
  "end": 149.6,
  "section": "조사해요",
  "sub": "이집트땅거북 — 작은 몸, 돔 모양 등껍질"
 },
 {
  "t": 149.6,
  "end": 154.77,
  "section": "조사해요",
  "sub": "사막전갈 — 돌 아래·틈에 숨어 살아요"
 },
 {
  "t": 154.77,
  "end": 160.8,
  "section": "정리해요",
  "sub": "극지방 동물은 지방·털로 추위를 견뎌요"
 },
 {
  "t": 160.8,
  "end": 168.43,
  "section": "정리해요",
  "sub": "사막 동물은 큰 귀·혹으로 건조한 환경을 견뎌요"
 },
 {
  "t": 168.43,
  "end": 171.9,
  "section": "확인해요",
  "sub": "다음 설명에 해당하는 동물은?"
 },
 {
  "t": 171.9,
  "end": 177.9,
  "section": "확인해요",
  "sub": "어느 동물일까요?"
 },
 {
  "t": 177.9,
  "end": 181.07,
  "section": "확인해요",
  "sub": "정답은 ② 북극곰이에요"
 },
 {
  "t": 181.07,
  "end": 190.7,
  "section": "마무리",
  "sub": "극지방 동물은 두꺼운 지방·촘촘한 털로 추위를 견디고 사막 동물은 큰 귀·혹으로 건조한 환경을 견뎌요"
 },
 {
  "t": 190.7,
  "end": 197.63,
  "section": "마무리",
  "sub": "다음 영상: 3학년 9화 · 동물의 특징을 본뜬 생활용품"
 }
