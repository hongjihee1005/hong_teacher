[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 1화: 여러 가지 용액을 분류해 볼까?"
 },
 {
  "t": 5.5,
  "end": 13.23,
  "section": "궁금해요",
  "sub": "오렌지주스는 어느 칸에 진열해야 할까요?"
 },
 {
  "t": 13.23,
  "end": 22.67,
  "section": "궁금해요",
  "sub": "색깔 있는 주스의 윗줄 — 비슷한 것끼리 모으면 찾기 쉬워요"
 },
 {
  "t": 22.67,
  "end": 28.33,
  "section": "관찰해요",
  "sub": "여섯 가지 용액을 관찰해요"
 },
 {
  "t": 28.33,
  "end": 32.03,
  "section": "관찰해요",
  "sub": "흰 종이를 뒤에 대고 색깔을 봐요"
 },
 {
  "t": 32.03,
  "end": 38.27,
  "section": "관찰해요",
  "sub": "글씨 쓴 종이를 대면 투명한 정도를 알 수 있어요"
 },
 {
  "t": 38.27,
  "end": 45.67,
  "section": "관찰해요",
  "sub": "흔든 뒤 5초 이상 거품이 남는지 봐요"
 },
 {
  "t": 45.67,
  "end": 51.27,
  "section": "관찰해요",
  "sub": "비슷한 점과 다른 점은 무엇일까요?"
 },
 {
  "t": 51.27,
  "end": 58.33,
  "section": "관찰해요",
  "sub": "식초는 노란색, 레몬즙은 연한 노란색, 빨랫비누 물은 흰색"
 },
 {
  "t": 58.33,
  "end": 65.93,
  "section": "관찰해요",
  "sub": "레몬즙·빨랫비누 물은 불투명, 거품은 빨랫비누 물만 남아요"
 },
 {
  "t": 65.93,
  "end": 71.83,
  "section": "분류 기준",
  "sub": "용액을 분류할 기준을 정해요"
 },
 {
  "t": 71.83,
  "end": 76.83,
  "section": "분류 기준",
  "sub": "알맞은 분류 기준을 모두 골라요"
 },
 {
  "t": 76.83,
  "end": 82.73,
  "section": "분류 기준",
  "sub": "관찰한 결과로 그렇다·그렇지 않다가 분명히 나뉘는 기준"
 },
 {
  "t": 82.73,
  "end": 89.13,
  "section": "분류 기준",
  "sub": "예쁘다·좋은 냄새는 사람마다 달라서 알맞지 않아요"
 },
 {
  "t": 89.13,
  "end": 97.13,
  "section": "분류 기준",
  "sub": "분류 기준은 객관적이고 명확한 질문으로 세워요"
 },
 {
  "t": 97.13,
  "end": 106.37,
  "section": "분류해요",
  "sub": "색깔이 있는 것: 식초·레몬즙·빨랫비누 물"
 },
 {
  "t": 106.37,
  "end": 115.8,
  "section": "분류해요",
  "sub": "기준이 달라지면 분류 결과도 달라질 수 있어요"
 },
 {
  "t": 115.8,
  "end": 120.37,
  "section": "생각해요",
  "sub": "겉보기 성질로만 분류할 때 어려운 점은?"
 },
 {
  "t": 120.37,
  "end": 129.63,
  "section": "생각해요",
  "sub": "색깔이 없고 투명해서 쉽게 구분되지 않아요"
 },
 {
  "t": 129.63,
  "end": 132.7,
  "section": "생각 바로잡기",
  "sub": "투명한 용액은 모두 색깔이 없을까요?"
 },
 {
  "t": 132.7,
  "end": 141.47,
  "section": "생각 바로잡기",
  "sub": "아니요, 식초처럼 색깔이 있으면서 투명한 용액도 있어요"
 },
 {
  "t": 141.47,
  "end": 148.03,
  "section": "한눈에 쏙",
  "sub": "용액을 분류하는 차례"
 },
 {
  "t": 148.03,
  "end": 152.2,
  "section": "한눈에 쏙",
  "sub": "색깔이 있는 것과 없는 것으로 분류할 수 있어요"
 },
 {
  "t": 152.2,
  "end": 156.7,
  "section": "마무리",
  "sub": "용액의 성질을 관찰하고 분류 기준을 세워 그 기준에 따라 용액을 분류해요"
 },
 {
  "t": 156.7,
  "end": 162.7,
  "section": "마무리",
  "sub": "다음 영상: 6학년 2화 · 지시약으로 분류하기"
 }
]