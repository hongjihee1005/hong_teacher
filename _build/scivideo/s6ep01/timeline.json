[
 {
  "t": 0.0,
  "end": 6.63,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 1화: 여러 가지 용액을 분류해 볼까?"
 },
 {
  "t": 6.63,
  "end": 14.63,
  "section": "궁금해요",
  "sub": "오렌지주스는 어느 칸에 진열해야 할까요?"
 },
 {
  "t": 14.63,
  "end": 24.27,
  "section": "궁금해요",
  "sub": "색깔 있는 주스의 윗줄 — 비슷한 것끼리 모으면 찾기 쉬워요"
 },
 {
  "t": 24.27,
  "end": 30.33,
  "section": "관찰해요",
  "sub": "여섯 가지 용액을 관찰해요"
 },
 {
  "t": 30.33,
  "end": 33.9,
  "section": "관찰해요",
  "sub": "흰 종이를 뒤에 대고 색깔을 봐요"
 },
 {
  "t": 33.9,
  "end": 40.57,
  "section": "관찰해요",
  "sub": "글씨 쓴 종이를 대면 투명한 정도를 알 수 있어요"
 },
 {
  "t": 40.57,
  "end": 49.43,
  "section": "관찰해요",
  "sub": "흔든 뒤 5초 이상 거품이 남는지 봐요"
 },
 {
  "t": 49.43,
  "end": 55.03,
  "section": "관찰해요",
  "sub": "비슷한 점과 다른 점은 무엇일까요?"
 },
 {
  "t": 55.03,
  "end": 63.8,
  "section": "관찰해요",
  "sub": "식초는 노란색, 레몬즙은 연한 노란색, 빨랫비누 물은 흰색"
 },
 {
  "t": 63.8,
  "end": 72.1,
  "section": "관찰해요",
  "sub": "레몬즙·빨랫비누 물은 불투명, 거품은 빨랫비누 물만 남아요"
 },
 {
  "t": 72.1,
  "end": 78.77,
  "section": "분류 기준",
  "sub": "용액을 분류할 기준을 정해요"
 },
 {
  "t": 78.77,
  "end": 83.77,
  "section": "분류 기준",
  "sub": "알맞은 분류 기준을 모두 골라요"
 },
 {
  "t": 83.77,
  "end": 89.3,
  "section": "분류 기준",
  "sub": "관찰한 결과로 그렇다·그렇지 않다가 분명히 나뉘는 기준"
 },
 {
  "t": 89.3,
  "end": 96.13,
  "section": "분류 기준",
  "sub": "예쁘다·좋은 냄새는 사람마다 달라서 알맞지 않아요"
 },
 {
  "t": 96.13,
  "end": 103.9,
  "section": "분류 기준",
  "sub": "분류 기준은 객관적이고 명확한 질문으로 세워요"
 },
 {
  "t": 103.9,
  "end": 115.43,
  "section": "분류해요",
  "sub": "색깔이 있는 것: 식초·레몬즙·빨랫비누 물"
 },
 {
  "t": 115.43,
  "end": 125.23,
  "section": "분류해요",
  "sub": "기준이 달라지면 분류 결과도 달라질 수 있어요"
 },
 {
  "t": 125.23,
  "end": 129.73,
  "section": "생각해요",
  "sub": "겉보기 성질로만 분류할 때 어려운 점은?"
 },
 {
  "t": 129.73,
  "end": 139.33,
  "section": "생각해요",
  "sub": "색깔이 없고 투명해서 쉽게 구분되지 않아요"
 },
 {
  "t": 139.33,
  "end": 142.37,
  "section": "생각 바로잡기",
  "sub": "투명한 용액은 모두 색깔이 없을까요?"
 },
 {
  "t": 142.37,
  "end": 152.4,
  "section": "생각 바로잡기",
  "sub": "아니요, 식초처럼 색깔이 있으면서 투명한 용액도 있어요"
 },
 {
  "t": 152.4,
  "end": 159.77,
  "section": "한눈에 쏙",
  "sub": "용액을 분류하는 차례"
 },
 {
  "t": 159.77,
  "end": 163.9,
  "section": "한눈에 쏙",
  "sub": "색깔이 있는 것과 없는 것으로 분류할 수 있어요"
 },
 {
  "t": 163.9,
  "end": 168.96,
  "section": "마무리",
  "sub": "성질을 관찰해 분류 기준을 세우고 그 기준에 따라 용액을 분류해요"
 },
 {
  "t": 168.96,
  "end": 175.2,
  "section": "마무리",
  "sub": "다음 영상: 6학년 2화 · 지시약으로 분류하기"
 }
]