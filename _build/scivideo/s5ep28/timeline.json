[
 {
  "t": 0.0,
  "end": 6.27,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 28화: 고기압과 저기압"
 },
 {
  "t": 6.27,
  "end": 14.33,
  "section": "궁금해요",
  "sub": "두 지역의 날씨에서 무엇이 다를까요?"
 },
 {
  "t": 14.33,
  "end": 19.0,
  "section": "궁금해요",
  "sub": "다른 기상 요소를 찾아보세요"
 },
 {
  "t": 19.0,
  "end": 29.7,
  "section": "궁금해요",
  "sub": "구름의 양, 강수량, 습도, 기온 등이 달라요"
 },
 {
  "t": 29.7,
  "end": 39.47,
  "section": "기압",
  "sub": "일정한 넓이에 작용하는 공기의 무게를 기압이라고 해요"
 },
 {
  "t": 39.47,
  "end": 47.97,
  "section": "기압",
  "sub": "주변보다 높은 곳은 고기압, 낮은 곳은 저기압"
 },
 {
  "t": 47.97,
  "end": 55.23,
  "section": "기압",
  "sub": "두 지도에서 '가'의 기압은 똑같이 1012예요"
 },
 {
  "t": 55.23,
  "end": 60.23,
  "section": "기압",
  "sub": "'가'는 고기압일까요, 저기압일까요?"
 },
 {
  "t": 60.23,
  "end": 67.53,
  "section": "기압",
  "sub": "왼쪽 '가'는 고기압, 오른쪽 '가'는 저기압이에요"
 },
 {
  "t": 67.53,
  "end": 76.77,
  "section": "기압",
  "sub": "정해진 기준값은 없어요. 주변과 비교해서 정해요"
 },
 {
  "t": 76.77,
  "end": 86.77,
  "section": "기상 위성 사진",
  "sub": "기상 위성 사진에서 흰색은 구름이에요"
 },
 {
  "t": 86.77,
  "end": 93.17,
  "section": "기상 위성 사진",
  "sub": "10월 12일: 우리나라에 고기압 → 구름이 거의 없어요"
 },
 {
  "t": 93.17,
  "end": 104.2,
  "section": "기상 위성 사진",
  "sub": "10월 22일: 우리나라에 저기압 → 구름이 많아요"
 },
 {
  "t": 104.2,
  "end": 119.43,
  "section": "날씨 비교",
  "sub": "기압이 다른 두 날, 서울의 기상 요소를 비교해요"
 },
 {
  "t": 119.43,
  "end": 124.43,
  "section": "날씨 비교",
  "sub": "두 날의 기압과 날씨는?"
 },
 {
  "t": 124.43,
  "end": 135.0,
  "section": "날씨 비교",
  "sub": "12일은 고기압·맑음, 22일은 저기압·흐리고 비"
 },
 {
  "t": 135.0,
  "end": 147.03,
  "section": "정리해요",
  "sub": "고기압은 대체로 맑고, 저기압은 대체로 흐리고 비나 눈"
 },
 {
  "t": 147.03,
  "end": 158.3,
  "section": "정리해요",
  "sub": "항상 그런 것은 아니고, '대체로' 그래요"
 },
 {
  "t": 158.3,
  "end": 164.57,
  "section": "한눈에 쏙",
  "sub": "주변보다 기압이 높은 곳 고기압, 낮은 곳 저기압"
 },
 {
  "t": 164.57,
  "end": 173.43,
  "section": "한눈에 쏙",
  "sub": "비가 올 수 있는 곳: 구름이 많은 곳, 저기압인 곳"
 },
 {
  "t": 173.43,
  "end": 181.94,
  "section": "마무리",
  "sub": "주변보다 기압이 높은 고기압: 대체로 맑아요 주변보다 기압이 낮은 저기압: 대체로 흐리고 비나 눈"
 },
 {
  "t": 181.94,
  "end": 188.87,
  "section": "마무리",
  "sub": "다음 영상: 5학년 29화 · 바람은 어느 방향으로 불까?"
 }
