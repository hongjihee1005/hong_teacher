 },
 {
  "t": 73.2,
  "end": 78.6,
  "section": "자석의 극",
  "sub": "철이 가장 많이 붙는 부분을 자석의 극이라고 해요"
 },
 {
  "t": 78.6,
  "end": 84.0,
  "section": "자석의 극",
  "sub": "여러 가지 모양의 자석에서 극을 찾아요"
 },
 {
  "t": 84.0,
  "end": 93.2,
