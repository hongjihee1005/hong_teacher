 {
  "t": 5.63,
  "end": 11.73,
  "section": "궁금해요",
  "sub": "쏟아진 철 클립을 편리하게 모으려면?"
 },
 {
  "t": 11.73,
  "end": 23.23,
  "section": "궁금해요",
  "sub": "막대자석의 끝부분? 가운데? 어디나 똑같을까요?"
 },
 {
  "t": 23.23,
  "end": 29.43,
  "section": "궁금해요",
  "sub": "어느 부분을 가까이 할까요?"
 },
 {
  "t": 29.43,
  "end": 37.97,
  "section": "예상해요",
  "sub": "빵 끈 조각은 막대자석에 어떤 모양으로 붙을까요?"
 },
 {
  "t": 37.97,
  "end": 44.73,
  "section": "예상해요",
  "sub": "내 생각을 정하고, 까닭도 친구에게 말해 봐요"
 },
 {
  "t": 44.73,
  "end": 50.93,
  "section": "예상해요",
  "sub": "빵 끈 조각은 어디에 많이 붙을까요?"
 },
 {
  "t": 50.93,
  "end": 56.27,
  "section": "실험해요",
  "sub": "빵 끈 조각이 든 그릇에 막대자석을 넣었다가 들어 올려요"
 },
 {
  "t": 56.27,
  "end": 60.93,
  "section": "실험해요",
  "sub": "빵 끈 조각이 양쪽 끝부분에 가장 많이 붙어요"
 },
 {
  "t": 60.93,
  "end": 65.17,
  "section": "실험해요",
  "sub": "가운데 부분에는 거의 붙지 않아요"
 },
 {
  "t": 65.17,
  "end": 69.77,
  "section": "실험해요",
  "sub": "둥근기둥 모양 자석으로도 해 봐요"
 },
 {
  "t": 69.77,
  "end": 76.37,
  "section": "실험해요",
  "sub": "둥근기둥 모양 자석도 양쪽 끝부분에 많이 붙어요"
 },
 {
  "t": 76.37,
  "end": 81.63,
  "section": "자석의 극",
  "sub": "철이 가장 많이 붙는 부분을 자석의 극이라고 해요"
 },
 {
  "t": 81.63,
  "end": 87.57,
  "section": "자석의 극",
  "sub": "여러 가지 모양의 자석에서 극을 찾아요"
 },
 {
  "t": 87.57,
  "end": 98.53,
  "section": "자석의 극",
  "sub": "모양은 달라도 극은 두 군데예요"
 },
 {
  "t": 98.53,
  "end": 103.93,
  "section": "자석의 극",
  "sub": "하나의 자석에는 극이 몇 개일까요?"
 },
 {
  "t": 103.93,
  "end": 111.57,
  "section": "자석의 극",
  "sub": "한 자석의 극은 두 개, N극과 S극이에요"
 },
 {
  "t": 111.57,
  "end": 118.43,
  "section": "생각 바로잡기",
  "sub": "양쪽 끝 극이 모두 N극일까요?"
 },
 {
  "t": 118.43,
  "end": 126.17,
  "section": "생각 바로잡기",
  "sub": "한쪽 끝은 N극, 다른 쪽 끝은 S극이에요"
 },
 {
  "t": 126.17,
  "end": 136.1,
  "section": "한눈에 쏙",
  "sub": "철이 가장 많이 붙는 곳이 자석의 극이에요"
 },
 {
  "t": 136.1,
  "end": 145.42,
  "section": "마무리",
  "sub": "자석에서 철로 만든 물체가 가장 많이 붙는 곳이 극이고, 한 자석에는 N극과 S극, 두 개의 극이 있어요"
 },
 {
  "t": 145.42,
  "end": 152.0,
