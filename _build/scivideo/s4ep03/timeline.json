  "sub": "「과학 원리 돋보기」 4학년 3화: 자석의 극"
 },
 {
  "t": 5.5,
  "end": 11.07,
  "section": "궁금해요",
  "sub": "쏟아진 철 클립을 편리하게 모으려면?"
 },
 {
  "t": 11.07,
  "end": 21.13,
  "section": "궁금해요",
  "sub": "막대자석의 끝부분? 가운데? 어디나 똑같을까요?"
 },
 {
  "t": 21.13,
  "end": 27.33,
  "section": "궁금해요",
  "sub": "어느 부분을 가까이 할까요?"
 },
 {
  "t": 27.33,
  "end": 35.2,
  "section": "예상해요",
  "sub": "빵 끈 조각은 막대자석에 어떤 모양으로 붙을까요?"
 },
 {
  "t": 35.2,
  "end": 41.6,
  "section": "예상해요",
  "sub": "내 생각을 정하고, 까닭도 친구에게 말해 봐요"
 },
 {
  "t": 41.6,
  "end": 47.8,
  "section": "예상해요",
  "sub": "빵 끈 조각은 어디에 많이 붙을까요?"
 },
 {
  "t": 47.8,
  "end": 53.37,
  "section": "실험해요",
  "sub": "빵 끈 조각이 든 그릇에 막대자석을 넣었다가 들어 올려요"
 },
 {
  "t": 53.37,
  "end": 57.93,
  "section": "실험해요",
  "sub": "빵 끈 조각이 양쪽 끝부분에 가장 많이 붙어요"
 },
 {
  "t": 57.93,
  "end": 62.33,
  "section": "실험해요",
  "sub": "가운데 부분에는 거의 붙지 않아요"
 },
 {
  "t": 62.33,
  "end": 66.93,
  "section": "실험해요",
  "sub": "둥근기둥 모양 자석으로도 해 봐요"
 },
 {
  "t": 66.93,
  "end": 73.37,
  "section": "실험해요",
  "sub": "둥근기둥 모양 자석도 양쪽 끝부분에 많이 붙어요"
 },
 {
  "t": 73.37,
  "end": 78.77,
  "section": "자석의 극",
  "sub": "철이 가장 많이 붙는 부분을 자석의 극이라고 해요"
 },
 {
  "t": 78.77,
  "end": 84.17,
  "section": "자석의 극",
  "sub": "여러 가지 모양의 자석에서 극을 찾아요"
 },
 {
  "t": 84.17,
  "end": 93.4,
  "section": "자석의 극",
  "sub": "모양은 달라도 극은 두 군데예요"
 },
 {
  "t": 93.4,
  "end": 98.8,
  "section": "자석의 극",
  "sub": "하나의 자석에는 극이 몇 개일까요?"
 },
 {
  "t": 98.8,
  "end": 105.57,
  "section": "자석의 극",
  "sub": "한 자석의 극은 두 개, N극과 S극이에요"
 },
 {
  "t": 105.57,
  "end": 111.63,
  "section": "생각 바로잡기",
  "sub": "양쪽 끝 극이 모두 N극일까요?"
 },
 {
  "t": 111.63,
  "end": 117.9,
  "section": "생각 바로잡기",
