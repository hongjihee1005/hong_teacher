 },
 {
  "t": 117.9,
  "end": 126.9,
  "section": "한눈에 쏙",
  "sub": "철이 가장 많이 붙는 곳이 자석의 극이에요"
 },
 {
  "t": 126.9,
  "end": 131.4,
  "section": "마무리",
  "sub": "자석에서 철로 만든 물체가 가장 많이 붙는 곳이 극이고, 한 자석에는 N극과 S극, 두 개의 극이 있어요"
 },
 {
  "t": 131.4,
  "end": 137.4,
