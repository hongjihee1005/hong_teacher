  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 27화: 계절별 남중 고도와 낮의 길이"
 },
 {
  "t": 7.23,
  "end": 11.37,
  "section": "궁금해요",
  "sub": "여름과 겨울의 오후 6시는 어떻게 다를까요?"
 },
 {
  "t": 11.37,
  "end": 22.9,
  "section": "궁금해요",
  "sub": "여름은 태양이 떠 있어 밝고, 겨울은 태양이 져서 어두워요"
 },
 {
  "t": 22.9,
  "end": 30.47,
  "section": "천문 자료 조사",
  "sub": "달마다 남중 고도와 낮의 길이를 조사해요"
 },
 {
  "t": 30.47,
  "end": 35.47,
  "section": "천문 자료 조사",
  "sub": "남중 고도가 가장 높은 달은?"
 },
 {
  "t": 35.47,
  "end": 43.9,
  "section": "천문 자료 조사",
  "sub": "6월은 남중 고도가 가장 높고 낮이 가장 길어요"
 },
 {
  "t": 43.9,
  "end": 52.83,
  "section": "천문 자료 조사",
  "sub": "12월은 남중 고도가 가장 낮고 낮이 가장 짧아요"
 },
 {
  "t": 52.83,
  "end": 58.73,
  "section": "꺾은선그래프",
  "sub": "두 그래프를 한 모눈에 그려요"
 },
 {
  "t": 58.73,
  "end": 62.1,
  "section": "꺾은선그래프",
  "sub": "두 그래프가 함께 오르내려요"
 },
 {
  "t": 62.1,
  "end": 67.13,
  "section": "꺾은선그래프",
  "sub": "남중 고도가 높을수록 낮의 길이가 길어요"
 },
 {
  "t": 67.13,
  "end": 70.93,
  "section": "태양이 지나는 길",
  "sub": "계절에 따라 태양이 지나는 길은 어떻게 다를까요?"
 },
 {
  "t": 70.93,
  "end": 80.63,
  "section": "태양이 지나는 길",
  "sub": "여름: 남쪽 하늘 높이, 지나는 길이 길어요"
 },
 {
  "t": 80.63,
  "end": 86.77,
  "section": "태양이 지나는 길",
  "sub": "봄·가을: 여름과 겨울의 중간 정도예요"
 },
 {
  "t": 86.77,
  "end": 94.93,
  "section": "태양이 지나는 길",
  "sub": "겨울: 남쪽 하늘 낮게, 지나는 길이 짧아요"
 },
 {
  "t": 94.93,
  "end": 102.5,
  "section": "태양이 지나는 길",
  "sub": "여름에서 겨울로 갈수록 남중 고도는 낮아지고 낮은 짧아져요"
 },
 {
  "t": 102.5,
  "end": 108.5,
  "section": "계절별 그림자",
  "sub": "같은 시각, 계절마다 나무 그림자 길이는?"
 },
 {
  "t": 108.5,
  "end": 114.7,
  "section": "계절별 그림자",
