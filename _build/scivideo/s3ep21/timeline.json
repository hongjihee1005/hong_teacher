[
 {
  "t": 0.0,
  "end": 7.23,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 21화: 같은 물질로 된 물체를 찾아라"
 },
 {
  "t": 7.23,
  "end": 12.5,
  "section": "궁금해요",
  "sub": "재활용품을 물질에 따라 나누어 모아요"
 },
 {
  "t": 12.5,
  "end": 22.5,
  "section": "궁금해요",
  "sub": "캔은 캔·고철류, 생수병은 플라스틱류에 넣어요"
 },
 {
  "t": 22.5,
  "end": 26.83,
  "section": "궁금해요",
  "sub": "철로 만든 뚜껑이 있는 유리병은 어떻게 할까요?"
 },
 {
  "t": 26.83,
  "end": 31.83,
  "section": "궁금해요",
  "sub": "철 뚜껑이 달린 유리병은 어디에?"
 },
 {
  "t": 31.83,
  "end": 40.8,
  "section": "궁금해요",
  "sub": "두 물질로 된 물건은 먼저 나누어요"
 },
 {
  "t": 40.8,
  "end": 46.73,
  "section": "궁금해요",
  "sub": "물질의 종류에 따라 나누어 버리면 다시 쓸 수 있어요"
 },
 {
  "t": 46.73,
  "end": 53.8,
  "section": "탐구해요",
  "sub": "교실에서 물체가 어떤 물질로 되어 있는지 찾아봐요"
 },
 {
  "t": 53.8,
  "end": 61.1,
  "section": "탐구해요",
  "sub": "두 가지 이상 물질로 된 물체는 부분마다 따로 붙여요"
 },
 {
  "t": 61.1,
  "end": 65.17,
  "section": "탐구해요",
  "sub": "붙임쪽지를 붙인 부분이 물질별로 모여요"
 },
 {
  "t": 65.17,
  "end": 74.0,
  "section": "탐구해요",
  "sub": "같은 물질끼리 모으면 물질의 종류로 분류돼요"
 },
 {
  "t": 74.0,
  "end": 79.5,
  "section": "탐구해요",
  "sub": "소화기는 여러 가지 물질로 되어 있어요"
 },
 {
  "t": 79.5,
  "end": 85.3,
  "section": "탐구해요",
  "sub": "몸통은 금속, 호스는 고무, 노즐은 플라스틱"
 },
 {
  "t": 85.3,
  "end": 95.73,
  "section": "탐구해요",
  "sub": "물체는 쓰임새에 따라 여러 물질로 만들어요"
 },
 {
  "t": 95.73,
  "end": 100.9,
  "section": "분류 기준 찾기",
  "sub": "세 무리로 나눈 기준은 무엇일까요?"
 },
 {
  "t": 100.9,
  "end": 105.9,
  "section": "분류 기준 찾기",
  "sub": "세 무리로 나눈 기준은?"
 },
 {
  "t": 105.9,
  "end": 111.9,
  "section": "분류 기준 찾기",
  "sub": "무리 1은 금속, 무리 2는 나무, 무리 3은 플라스틱"
 },
 {
  "t": 111.9,
  "end": 119.27,
  "section": "분류 기준 찾기",
  "sub": "기준은 물체를 이루는 물질의 종류예요"
 },
 {
  "t": 119.27,
  "end": 125.57,
  "section": "정리해요",
  "sub": "철 못, 고무장갑, 철 클립, 지우개를 물질별로 모아요"
 },
 {
  "t": 125.57,
  "end": 132.7,
  "section": "정리해요",
  "sub": "철 못과 철 클립은 금속으로 분류할 수 있어요"
 },
 {
  "t": 132.7,
  "end": 143.47,
  "section": "정리해요",
  "sub": "집에서 고무로 된 물체를 찾아봐요"
 },
 {
  "t": 143.47,
  "end": 148.93,
  "section": "확인해요",
  "sub": "집게, 냄비, 프라이팬을 이루는 공통 물질은?"
 },
 {
  "t": 148.93,
  "end": 153.93,
  "section": "확인해요",
  "sub": "세 물체의 공통 물질은?"
 },
 {
  "t": 153.93,
  "end": 158.13,
  "section": "확인해요",
  "sub": "세 물체 모두 단단한 금속으로 만들어요"
 },
 {
  "t": 158.13,
  "end": 162.63,
  "section": "마무리",
  "sub": "물체는 이루고 있는 물질의 종류에 따라 분류할 수 있어요"
 },
 {
  "t": 162.63,
  "end": 169.27,
  "section": "마무리",
  "sub": "다음 영상: 3학년 22화 · 물질의 세 가지 상태"
 }
]