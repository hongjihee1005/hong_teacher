[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 21화: 같은 물질로 된 물체를 찾아라"
 },
 {
  "t": 5.47,
  "end": 10.2,
  "section": "궁금해요",
  "sub": "재활용품을 물질에 따라 나누어 모아요"
 },
 {
  "t": 10.2,
  "end": 17.6,
  "section": "궁금해요",
  "sub": "캔은 캔·고철류, 생수병은 플라스틱류에 넣어요"
 },
 {
  "t": 17.6,
  "end": 22.33,
  "section": "궁금해요",
  "sub": "철로 만든 뚜껑이 있는 유리병은 어떻게 할까요?"
 },
 {
  "t": 22.33,
  "end": 27.33,
  "section": "궁금해요",
  "sub": "철 뚜껑이 달린 유리병은 어디에?"
 },
 {
  "t": 27.33,
  "end": 34.73,
  "section": "궁금해요",
  "sub": "두 물질로 된 물건은 먼저 나누어요"
 },
 {
  "t": 34.73,
  "end": 40.93,
  "section": "궁금해요",
  "sub": "물질의 종류에 따라 나누어 버리면 다시 쓸 수 있어요"
 },
 {
  "t": 40.93,
  "end": 47.13,
  "section": "탐구해요",
  "sub": "교실에서 물체가 어떤 물질로 되어 있는지 찾아봐요"
 },
 {
  "t": 47.13,
  "end": 53.8,
  "section": "탐구해요",
  "sub": "두 가지 이상 물질로 된 물체는 부분마다 따로 붙여요"
 },
 {
  "t": 53.8,
  "end": 57.8,
  "section": "탐구해요",
  "sub": "붙임쪽지를 붙인 부분이 물질별로 모여요"
 },
 {
  "t": 57.8,
  "end": 65.53,
  "section": "탐구해요",
  "sub": "같은 물질끼리 모으면 물질의 종류로 분류돼요"
 },
 {
  "t": 65.53,
  "end": 70.4,
  "section": "탐구해요",
  "sub": "소화기는 여러 가지 물질로 되어 있어요"
 },
 {
  "t": 70.4,
  "end": 75.27,
  "section": "탐구해요",
  "sub": "몸통은 금속, 호스는 고무, 노즐은 플라스틱"
 },
 {
  "t": 75.27,
  "end": 84.53,
  "section": "탐구해요",
  "sub": "물체는 쓰임새에 따라 여러 물질로 만들어요"
 },
 {
  "t": 84.53,
  "end": 88.93,
  "section": "분류 기준 찾기",
  "sub": "세 무리로 나눈 기준은 무엇일까요?"
 },
 {
  "t": 88.93,
  "end": 93.93,
  "section": "분류 기준 찾기",
  "sub": "세 무리로 나눈 기준은?"
 },
 {
  "t": 93.93,
  "end": 99.33,
  "section": "분류 기준 찾기",
  "sub": "무리 1은 금속, 무리 2는 나무, 무리 3은 플라스틱"
 },
 {
  "t": 99.33,
  "end": 106.27,
  "section": "분류 기준 찾기",
  "sub": "기준은 물체를 이루는 물질의 종류예요"
 },
 {
  "t": 106.27,
  "end": 111.67,
  "section": "정리해요",
  "sub": "철 못, 고무장갑, 철 클립, 지우개를 물질별로 모아요"
 },
 {
  "t": 111.67,
  "end": 118.0,
  "section": "정리해요",
  "sub": "철 못과 철 클립은 금속으로 분류할 수 있어요"
 },
 {
  "t": 118.0,
  "end": 127.07,
  "section": "정리해요",
  "sub": "집에서 고무로 된 물체를 찾아봐요"
 },
 {
  "t": 127.07,
  "end": 132.27,
  "section": "확인해요",
  "sub": "집게, 냄비, 프라이팬을 이루는 공통 물질은?"
 },
 {
  "t": 132.27,
  "end": 137.27,
  "section": "확인해요",
  "sub": "세 물체의 공통 물질은?"
 },
 {
  "t": 137.27,
  "end": 141.4,
  "section": "확인해요",
  "sub": "세 물체 모두 단단한 금속으로 만들어요"
 },
 {
  "t": 141.4,
  "end": 145.9,
  "section": "마무리",
  "sub": "물체는 이루고 있는 물질의 종류에 따라 분류할 수 있어요"
 },
 {
  "t": 145.9,
  "end": 151.87,
  "section": "마무리",
  "sub": "다음 영상: 3학년 22화 · 물질의 세 가지 상태"
 }
