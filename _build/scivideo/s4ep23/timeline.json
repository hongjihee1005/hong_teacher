 },
 {
  "t": 67.27,
  "end": 72.67,
  "section": "숲속 이야기",
  "sub": "괭이밥과 개망초는 스스로 양분을 만들어요: 생산자"
 },
 {
  "t": 72.67,
  "end": 75.4,
  "section": "숲속 이야기",
  "sub": "애벌레는 잎을 먹어요: 소비자"
 },
 {
  "t": 75.4,
