  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 4학년 23화: 생물 요소를 분류해 볼까?"
 },
 {
  "t": 5.47,
  "end": 9.87,
  "section": "궁금해요",
  "sub": "우리는 필요한 양분을 어떻게 얻을까요?"
 },
 {
  "t": 9.87,
  "end": 13.4,
  "section": "궁금해요",
  "sub": "우리는 음식을 먹어서 양분을 얻어요"
 },
 {
  "t": 13.4,
  "end": 18.93,
  "section": "궁금해요",
  "sub": "다른 생물을 먹지 않고 스스로 양분을 만드는 생물은?"
 },
 {
  "t": 18.93,
  "end": 23.93,
  "section": "궁금해요",
  "sub": "스스로 양분을 만드는 생물은?"
 },
 {
  "t": 23.93,
  "end": 29.0,
