 },
 {
  "t": 58.2,
  "end": 62.87,
  "section": "분류해요",
  "sub": "소비자: 토끼, 개구리, 뱀, 달팽이, 박새, 잠자리"
 },
 {
  "t": 62.87,
  "end": 67.27,
  "section": "분류해요",
