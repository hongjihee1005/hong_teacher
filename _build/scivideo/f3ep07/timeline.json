[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「처음 배우는 과학」 3학년 7화: 물에 사는 동물과 물갈퀴"
 },
 {
  "t": 5.47,
  "end": 11.67,
  "section": "궁금해요",
  "sub": "물고기는 어떻게 물속에서 빠르게 움직일까요?"
 },
 {
  "t": 11.67,
  "end": 16.67,
  "section": "궁금해요",
  "sub": "붕어의 몸을 살펴봐요"
 },
 {
  "t": 16.67,
  "end": 19.4,
  "section": "궁금해요",
  "sub": "몸에 지느러미가 있어요"
 },
 {
  "t": 19.4,
  "end": 26.2,
  "section": "궁금해요",
  "sub": "몸이 부드러운 곡선 모양이에요"
 },
 {
  "t": 26.2,
  "end": 33.47,
  "section": "궁금해요",
  "sub": "강, 호수, 갯벌, 바다에서 동물을 본 적이 있나요?"
 },
 {
  "t": 33.47,
  "end": 36.33,
  "section": "새 낱말",
  "sub": "땅과 물을 오가며 사는 개구리예요"
 },
 {
  "t": 36.33,
  "end": 41.87,
  "section": "새 낱말",
  "sub": "발가락 사이의 얇은 막이 물갈퀴예요"
 },
 {
  "t": 41.87,
  "end": 46.33,
  "section": "새 낱말",
  "sub": "물속에서는 물갈퀴가 있는 발로 헤엄쳐요"
 },
 {
  "t": 46.33,
  "end": 48.53,
  "section": "새 낱말",
  "sub": "오리의 발도 살펴볼까요?"
 },
 {
  "t": 48.53,
  "end": 53.07,
  "section": "새 낱말",
  "sub": "발가락 사이에 물갈퀴가 있어 헤엄을 잘 쳐요"
 },
 {
  "t": 53.07,
  "end": 59.13,
  "section": "새 낱말",
  "sub": "물갈퀴가 있으면 어떤 점이 좋을까요?"
 },
 {
  "t": 59.13,
  "end": 69.07,
  "section": "실험해요",
  "sub": "준비물을 챙기고 안전 약속을 확인해요"
 },
 {
  "t": 69.07,
  "end": 75.6,
  "section": "실험해요",
  "sub": "① 수조에 페트병 뚜껑을 띄워요"
 },
 {
  "t": 75.6,
  "end": 82.13,
  "section": "실험해요",
  "sub": "② 부챗살을 펼쳐 물속에서 저어요"
 },
 {
  "t": 82.13,
  "end": 86.0,
  "section": "실험해요",
  "sub": "물이 조금 출렁이고 뚜껑이 조금 움직여요"
 },
 {
  "t": 86.0,
  "end": 92.73,
  "section": "실험해요",
  "sub": "③ 빈틈에 테이프를 붙여 물갈퀴처럼 만들어요"
 },
 {
  "t": 92.73,
  "end": 97.93,
  "section": "실험해요",
  "sub": "④ 같은 힘으로 저으면 어떻게 될까요?"
 },
 {
  "t": 97.93,
  "end": 105.47,
  "section": "실험해요",
  "sub": "뚜껑이 더 많이 움직이는 것은 ㈎? ㈏?"
 },
 {
  "t": 105.47,
  "end": 110.87,
  "section": "실험해요",
  "sub": "물이 많이 출렁이고 뚜껑이 더 많이 움직여요"
 },
 {
  "t": 110.87,
  "end": 113.27,
  "section": "정리해요",
  "sub": "실험 결과를 정리해요"
 },
 {
  "t": 113.27,
  "end": 119.93,
  "section": "정리해요",
  "sub": "물을 더 많이 밀어 내 빠르게 움직일 수 있어요"
 },
 {
  "t": 119.93,
  "end": 128.2,
  "section": "정리해요",
  "sub": "물갈퀴나 지느러미 모양의 발로 헤엄치는 동물"
 },
 {
  "t": 128.2,
  "end": 130.93,
  "section": "조사해요",
  "sub": "강이나 호수에 사는 수달이에요"
 },
 {
  "t": 130.93,
  "end": 135.33,
  "section": "조사해요",
  "sub": "머리는 납작하며 둥글고 발에 물갈퀴가 있어요"
 },
 {
  "t": 135.33,
  "end": 142.0,
  "section": "조사해요",
  "sub": "땅과 물을 오가며, 물갈퀴 발로 헤엄쳐요"
 },
 {
  "t": 142.0,
  "end": 144.07,
  "section": "조사해요",
  "sub": "갯벌에 사는 농게예요"
 },
 {
  "t": 144.07,
  "end": 150.47,
  "section": "조사해요",
  "sub": "딱딱한 껍데기, 수컷은 한쪽 집게발이 더 커요"
 },
 {
  "t": 150.47,
  "end": 155.47,
  "section": "조사해요",
  "sub": "갯벌에 구멍을 뚫고 살며 다리로 걸어 다녀요"
 },
 {
  "t": 155.47,
  "end": 160.67,
  "section": "조사해요",
  "sub": "물에 사는 동물은 어떻게 이동할까요?"
 },
 {
  "t": 160.67,
  "end": 164.67,
  "section": "조사해요",
  "sub": "농게와 따개비는 어디에 들어갈까요?"
 },
 {
  "t": 164.67,
  "end": 169.07,
  "section": "조사해요",
  "sub": "지느러미로 헤엄쳐요"
 },
 {
  "t": 169.07,
  "end": 174.6,
  "section": "조사해요",
  "sub": "물갈퀴 발이나 다리로 헤엄쳐요"
 },
 {
  "t": 174.6,
  "end": 178.67,
  "section": "조사해요",
  "sub": "기어다니거나 걸어 다녀요"
 },
 {
  "t": 178.67,
  "end": 183.07,
  "section": "조사해요",
  "sub": "한곳에 붙어서 살아요"
 },
 {
  "t": 183.07,
  "end": 193.4,
  "section": "정리해요",
  "sub": "물에 사는 동물은 물에서 살기에 알맞은 생김새를 가졌어요"
 },
 {
  "t": 193.4,
  "end": 199.27,
  "section": "정리해요",
  "sub": "고등어, 돌고래가 바다에서 살기에 알맞은 특징은?"
 },
 {
  "t": 199.27,
  "end": 204.27,
  "section": "정리해요",
  "sub": "몸 모양과 지느러미를 살펴봐요"
 },
 {
  "t": 204.27,
  "end": 209.87,
  "section": "정리해요",
  "sub": "부드러운 곡선 모양의 몸과 지느러미가 있어요"
 },
 {
  "t": 209.87,
  "end": 216.73,
  "section": "확인해요",
  "sub": "땅과 물을 오가며, 물갈퀴 발로 헤엄치는 동물은?"
 },
 {
  "t": 216.73,
  "end": 222.73,
  "section": "확인해요",
  "sub": "어느 동물일까요?"
 },
 {
  "t": 222.73,
  "end": 225.53,
  "section": "확인해요",
  "sub": "정답은 ③ 수달이에요"
 },
 {
  "t": 225.53,
  "end": 231.4,
  "section": "확인해요",
  "sub": "농게에 관한 설명으로 옳은 것 두 가지는?"
 },
 {
  "t": 231.4,
  "end": 237.2,
  "section": "확인해요",
  "sub": "옳은 것 두 가지를 골라요"
 },
 {
  "t": 237.2,
  "end": 244.33,
  "section": "확인해요",
  "sub": "정답은 ①, ③ — 갯벌에 살고 다리로 걸어 다녀요"
 },
 {
  "t": 244.33,
  "end": 248.83,
  "section": "마무리",
  "sub": "물갈퀴가 있는 발은 물을 더 많이 밀어 내 물속에서 빠르게 움직일 수 있어요"
 },
 {
