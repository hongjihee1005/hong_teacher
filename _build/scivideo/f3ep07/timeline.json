[
 {
  "t": 0.0,
  "end": 6.9,
  "section": "오프닝",
  "sub": "「처음 배우는 과학」 3학년 7화: 물에 사는 동물과 물갈퀴"
 },
 {
  "t": 6.9,
  "end": 14.23,
  "section": "궁금해요",
  "sub": "물고기는 어떻게 물속에서 빠르게 움직일까요?"
 },
 {
  "t": 14.23,
  "end": 19.23,
  "section": "궁금해요",
  "sub": "붕어의 몸을 살펴봐요"
 },
 {
  "t": 19.23,
  "end": 21.9,
  "section": "궁금해요",
  "sub": "몸에 지느러미가 있어요"
 },
 {
  "t": 21.9,
  "end": 29.67,
  "section": "궁금해요",
  "sub": "몸이 부드러운 곡선 모양이에요"
 },
 {
  "t": 29.67,
  "end": 38.8,
  "section": "궁금해요",
  "sub": "강, 호수, 갯벌, 바다에서 동물을 본 적이 있나요?"
 },
 {
  "t": 38.8,
  "end": 41.7,
  "section": "새 낱말",
  "sub": "땅과 물을 오가며 사는 개구리예요"
 },
 {
  "t": 41.7,
  "end": 49.23,
  "section": "새 낱말",
  "sub": "발가락 사이의 얇은 막이 물갈퀴예요"
 },
 {
  "t": 49.23,
  "end": 53.87,
  "section": "새 낱말",
  "sub": "물속에서는 물갈퀴가 있는 발로 헤엄쳐요"
 },
 {
  "t": 53.87,
  "end": 56.27,
  "section": "새 낱말",
  "sub": "오리의 발도 살펴볼까요?"
 },
 {
  "t": 56.27,
  "end": 60.93,
  "section": "새 낱말",
  "sub": "발가락 사이에 물갈퀴가 있어 헤엄을 잘 쳐요"
 },
 {
  "t": 60.93,
  "end": 68.17,
  "section": "새 낱말",
  "sub": "물갈퀴가 있으면 어떤 점이 좋을까요?"
 },
 {
  "t": 68.17,
  "end": 82.07,
  "section": "실험해요",
  "sub": "준비물을 챙기고 안전 약속을 확인해요"
 },
 {
  "t": 82.07,
  "end": 89.67,
  "section": "실험해요",
  "sub": "① 수조에 페트병 뚜껑을 띄워요"
 },
 {
  "t": 89.67,
  "end": 97.5,
  "section": "실험해요",
  "sub": "② 부챗살을 펼쳐 물속에서 저어요"
 },
 {
  "t": 97.5,
  "end": 102.5,
  "section": "실험해요",
  "sub": "물이 조금 출렁이고 뚜껑이 조금 움직여요"
 },
 {
  "t": 102.5,
  "end": 110.5,
  "section": "실험해요",
  "sub": "③ 빈틈에 테이프를 붙여 물갈퀴처럼 만들어요"
 },
 {
  "t": 110.5,
  "end": 117.07,
  "section": "실험해요",
  "sub": "④ 같은 힘으로 저으면 어떻게 될까요?"
 },
 {
  "t": 117.07,
  "end": 124.57,
  "section": "실험해요",
  "sub": "뚜껑이 더 많이 움직이는 것은 ㈎? ㈏?"
 },
 {
  "t": 124.57,
  "end": 131.17,
  "section": "실험해요",
  "sub": "물이 많이 출렁이고 뚜껑이 더 많이 움직여요"
 },
 {
  "t": 131.17,
  "end": 133.8,
  "section": "정리해요",
  "sub": "실험 결과를 정리해요"
 },
 {
  "t": 133.8,
  "end": 141.5,
  "section": "정리해요",
  "sub": "물을 더 많이 밀어 내 빠르게 움직일 수 있어요"
 },
 {
  "t": 141.5,
  "end": 150.43,
  "section": "정리해요",
  "sub": "물갈퀴나 지느러미 모양의 발로 헤엄치는 동물"
 },
 {
  "t": 150.43,
  "end": 153.1,
  "section": "조사해요",
  "sub": "강이나 호수에 사는 수달이에요"
 },
 {
  "t": 153.1,
  "end": 158.83,
  "section": "조사해요",
  "sub": "머리는 납작하며 둥글고 발에 물갈퀴가 있어요"
 },
 {
  "t": 158.83,
  "end": 166.63,
  "section": "조사해요",
  "sub": "땅과 물을 오가며, 물갈퀴 발로 헤엄쳐요"
 },
 {
  "t": 166.63,
  "end": 168.8,
  "section": "조사해요",
  "sub": "갯벌에 사는 농게예요"
 },
 {
  "t": 168.8,
  "end": 176.73,
  "section": "조사해요",
  "sub": "딱딱한 껍데기, 수컷은 한쪽 집게발이 더 커요"
 },
 {
  "t": 176.73,
  "end": 182.77,
  "section": "조사해요",
  "sub": "갯벌에 구멍을 뚫고 살며 다리로 걸어 다녀요"
 },
 {
  "t": 182.77,
  "end": 189.13,
  "section": "조사해요",
  "sub": "물에 사는 동물은 어떻게 이동할까요?"
 },
 {
  "t": 189.13,
  "end": 194.1,
  "section": "조사해요",
  "sub": "농게와 따개비는 어디에 들어갈까요?"
 },
 {
  "t": 194.1,
  "end": 199.77,
  "section": "조사해요",
  "sub": "지느러미로 헤엄쳐요"
 },
 {
  "t": 199.77,
  "end": 206.23,
  "section": "조사해요",
  "sub": "물갈퀴 발이나 다리로 헤엄쳐요"
 },
 {
  "t": 206.23,
  "end": 211.27,
  "section": "조사해요",
  "sub": "기어다니거나 걸어 다녀요"
 },
 {
  "t": 211.27,
  "end": 215.8,
  "section": "조사해요",
  "sub": "한곳에 붙어서 살아요"
 },
 {
  "t": 215.8,
  "end": 228.0,
  "section": "정리해요",
  "sub": "물에 사는 동물은 물에서 살기에 알맞은 생김새를 가졌어요"
 },
 {
  "t": 228.0,
  "end": 234.67,
  "section": "정리해요",
  "sub": "고등어, 돌고래가 바다에서 살기에 알맞은 특징은?"
 },
 {
  "t": 234.67,
  "end": 239.67,
  "section": "정리해요",
  "sub": "몸 모양과 지느러미를 살펴봐요"
 },
 {
  "t": 239.67,
  "end": 246.2,
  "section": "정리해요",
  "sub": "부드러운 곡선 모양의 몸과 지느러미가 있어요"
 },
 {
  "t": 246.2,
  "end": 254.33,
  "section": "확인해요",
  "sub": "땅과 물을 오가며, 물갈퀴 발로 헤엄치는 동물은?"
 },
 {
  "t": 254.33,
  "end": 260.33,
  "section": "확인해요",
  "sub": "어느 동물일까요?"
 },
 {
  "t": 260.33,
  "end": 263.37,
  "section": "확인해요",
  "sub": "정답은 ③ 수달이에요"
 },
 {
  "t": 263.37,
  "end": 270.47,
  "section": "확인해요",
  "sub": "농게에 관한 설명으로 옳은 것 두 가지는?"
 },
 {
  "t": 270.47,
  "end": 276.27,
  "section": "확인해요",
  "sub": "옳은 것 두 가지를 골라요"
 },
 {
  "t": 276.27,
  "end": 285.67,
  "section": "확인해요",
  "sub": "정답은 ①, ③ — 갯벌에 살고 다리로 걸어 다녀요"
 },
 {
  "t": 285.67,
  "end": 291.44,
  "section": "마무리",
  "sub": "물갈퀴가 있는 발은 물을 더 많이 밀어 내 물속에서 빠르게 움직일 수 있어요"
 },
 {
