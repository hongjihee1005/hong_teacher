[
 {
  "t": 0.0,
  "end": 7.1,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 6화: 우리 주변·땅속에 사는 동물"
 },
 {
  "t": 7.1,
  "end": 10.77,
  "section": "궁금해요",
  "sub": "학교나 집 주변에서 어떤 동물을 보았나요?"
 },
 {
  "t": 10.77,
  "end": 17.8,
  "section": "궁금해요",
  "sub": "우리 주변에는 다양한 동물이 살고 있어요"
 },
 {
  "t": 17.8,
  "end": 24.5,
  "section": "궁금해요",
  "sub": "달팽이·고양이처럼 땅에 사는 동물"
 },
 {
  "t": 24.5,
  "end": 29.5,
  "section": "궁금해요",
  "sub": "나비·참새처럼 하늘을 날아다니는 동물도 있어요"
 },
 {
  "t": 29.5,
  "end": 35.93,
  "section": "조사해요",
  "sub": "학교에 사는 동물을 조사하러 가요"
 },
 {
  "t": 35.93,
  "end": 47.37,
  "section": "조사해요",
  "sub": "긴소매·긴바지를 입고, 동물은 함부로 채집하지 않아요"
 },
 {
  "t": 47.37,
  "end": 58.97,
  "section": "생각 바로잡기",
  "sub": "산호·말미잘·따개비는 한곳에 붙어서 살아요"
 },
 {
  "t": 58.97,
  "end": 66.2,
  "section": "관찰해요",
  "sub": "땅에서 동물이 파 놓은 구멍을 볼 때가 있어요"
 },
 {
  "t": 66.2,
  "end": 76.57,
  "section": "관찰해요",
  "sub": "매미 애벌레의 허물을 돋보기로 관찰해요"
 },
 {
  "t": 76.57,
  "end": 78.77,
  "section": "관찰해요",
  "sub": "머리에는 더듬이가 있어요"
 },
 {
  "t": 78.77,
  "end": 87.77,
  "section": "관찰해요",
  "sub": "다리를 세어 봐요 — 세 쌍이에요"
 },
 {
  "t": 87.77,
  "end": 93.07,
  "section": "관찰해요",
  "sub": "매미 애벌레는 무엇으로 땅을 팔까요?"
 },
 {
  "t": 93.07,
  "end": 98.77,
  "section": "관찰해요",
  "sub": "앞다리 끝이 뾰족해요 — 이 앞다리로 땅을 파요"
 },
 {
  "t": 98.77,
  "end": 106.9,
  "section": "관찰해요",
  "sub": "허물은 쉽게 부서져요 — 힘을 주어 만지지 않아요"
 },
 {
  "t": 106.9,
  "end": 115.9,
  "section": "조사해요",
  "sub": "두더지, 개미, 땅강아지, 매미 애벌레, 지렁이"
 },
 {
  "t": 115.9,
  "end": 120.9,
  "section": "조사해요",
  "sub": "누가 어떻게 땅을 팔까요?"
 },
 {
  "t": 120.9,
  "end": 128.1,
  "section": "조사해요",
  "sub": "두더지는 삽처럼 넓적한 앞다리로 굴을 파요"
 },
 {
  "t": 128.1,
  "end": 132.73,
  "section": "조사해요",
  "sub": "땅강아지도 넓적한 앞다리로 땅을 파요"
 },
 {
  "t": 132.73,
  "end": 136.37,
  "section": "조사해요",
  "sub": "개미는 큰턱으로 땅을 파서 집을 지어요"
 },
 {
  "t": 136.37,
  "end": 143.3,
  "section": "조사해요",
  "sub": "매미 애벌레는 뾰족한 앞다리로 땅을 파요"
 },
 {
  "t": 143.3,
  "end": 153.23,
  "section": "조사해요",
  "sub": "지렁이는 몸을 늘였다 당기며 이동해요"
 },
 {
  "t": 153.23,
  "end": 160.97,
  "section": "정리해요",
  "sub": "땅속 동물은 땅속에서 살기에 알맞은 생김새를 가졌어요"
 },
 {
  "t": 160.97,
  "end": 169.9,
  "section": "정리해요",
  "sub": "땅강아지는 넓적한 앞다리로 땅을 잘 파서 땅속에서 잘 살아요"
 },
 {
  "t": 169.9,
  "end": 176.87,
  "section": "확인해요",
  "sub": "땅속에 사는 동물 ㈎와 ㈏의 공통 특징은?"
 },
 {
  "t": 176.87,
  "end": 181.87,
  "section": "확인해요",
  "sub": "㈎·㈏의 이름과 공통 특징은?"
 },
 {
  "t": 181.87,
  "end": 184.93,
  "section": "확인해요",
  "sub": "㈎는 두더지, ㈏는 땅강아지예요"
 },
 {
  "t": 184.93,
  "end": 190.87,
  "section": "확인해요",
  "sub": "둘 다 앞다리를 이용해 땅을 팔 수 있어요"
 },
 {
  "t": 190.87,
  "end": 197.83,
  "section": "마무리",
  "sub": "땅속에 사는 동물은 앞다리로 땅을 파는 등 땅속에서 살기에 알맞은 생김새와 생활 방식을 가져요"
 },
 {
  "t": 197.83,
  "end": 204.67,
  "section": "마무리",
  "sub": "다음 영상: 3학년 7화 · 물에 사는 동물과 물갈퀴"
 }
]