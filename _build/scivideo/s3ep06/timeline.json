[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 6화: 우리 주변·땅속에 사는 동물"
 },
 {
  "t": 5.5,
  "end": 9.23,
  "section": "궁금해요",
  "sub": "학교나 집 주변에서 어떤 동물을 보았나요?"
 },
 {
  "t": 9.23,
  "end": 15.13,
  "section": "궁금해요",
  "sub": "우리 주변에는 다양한 동물이 살고 있어요"
 },
 {
  "t": 15.13,
  "end": 20.5,
  "section": "궁금해요",
  "sub": "달팽이·고양이처럼 땅에 사는 동물"
 },
 {
  "t": 20.5,
  "end": 25.73,
  "section": "궁금해요",
  "sub": "나비·참새처럼 하늘을 날아다니는 동물도 있어요"
 },
 {
  "t": 25.73,
  "end": 31.77,
  "section": "조사해요",
  "sub": "학교에 사는 동물을 조사하러 가요"
 },
 {
  "t": 31.77,
  "end": 42.03,
  "section": "조사해요",
  "sub": "긴소매·긴바지를 입고, 동물은 함부로 채집하지 않아요"
 },
 {
  "t": 42.03,
  "end": 51.47,
  "section": "생각 바로잡기",
  "sub": "산호·말미잘·따개비는 한곳에 붙어서 살아요"
 },
 {
  "t": 51.47,
  "end": 58.03,
  "section": "관찰해요",
  "sub": "땅에서 동물이 파 놓은 구멍을 볼 때가 있어요"
 },
 {
  "t": 58.03,
  "end": 67.43,
  "section": "관찰해요",
  "sub": "매미 애벌레의 허물을 돋보기로 관찰해요"
 },
 {
  "t": 67.43,
  "end": 69.83,
  "section": "관찰해요",
  "sub": "머리에는 더듬이가 있어요"
 },
 {
  "t": 69.83,
  "end": 75.73,
  "section": "관찰해요",
  "sub": "다리를 세어 봐요 — 세 쌍이에요"
 },
 {
  "t": 75.73,
  "end": 81.03,
  "section": "관찰해요",
  "sub": "매미 애벌레는 무엇으로 땅을 팔까요?"
 },
 {
  "t": 81.03,
  "end": 86.1,
  "section": "관찰해요",
  "sub": "앞다리 끝이 뾰족해요 — 이 앞다리로 땅을 파요"
 },
 {
  "t": 86.1,
  "end": 93.7,
  "section": "관찰해요",
  "sub": "허물은 쉽게 부서져요 — 힘을 주어 만지지 않아요"
 },
 {
  "t": 93.7,
  "end": 100.6,
  "section": "조사해요",
  "sub": "두더지, 개미, 땅강아지, 매미 애벌레, 지렁이"
 },
 {
  "t": 100.6,
  "end": 105.6,
  "section": "조사해요",
  "sub": "누가 어떻게 땅을 팔까요?"
 },
 {
  "t": 105.6,
  "end": 112.0,
  "section": "조사해요",
  "sub": "두더지는 삽처럼 넓적한 앞다리로 굴을 파요"
 },
 {
  "t": 112.0,
  "end": 116.9,
  "section": "조사해요",
  "sub": "땅강아지도 넓적한 앞다리로 땅을 파요"
 },
 {
  "t": 116.9,
  "end": 120.63,
  "section": "조사해요",
  "sub": "개미는 큰턱으로 땅을 파서 집을 지어요"
 },
 {
  "t": 120.63,
  "end": 127.37,
  "section": "조사해요",
  "sub": "매미 애벌레는 뾰족한 앞다리로 땅을 파요"
 },
 {
  "t": 127.37,
  "end": 136.3,
  "section": "조사해요",
  "sub": "지렁이는 몸을 늘였다 당기며 이동해요"
 },
 {
  "t": 136.3,
  "end": 144.37,
  "section": "정리해요",
  "sub": "땅속 동물은 땅속에서 살기에 알맞은 생김새를 가졌어요"
 },
 {
  "t": 144.37,
  "end": 152.63,
  "section": "정리해요",
  "sub": "땅강아지는 넓적한 앞다리로 땅을 잘 파서 땅속에서 잘 살아요"
 },
 {
  "t": 152.63,
  "end": 158.7,
  "section": "확인해요",
  "sub": "땅속에 사는 동물 ㈎와 ㈏의 공통 특징은?"
 },
 {
  "t": 158.7,
  "end": 163.7,
  "section": "확인해요",
  "sub": "㈎·㈏의 이름과 공통 특징은?"
 },
 {
  "t": 163.7,
  "end": 166.6,
  "section": "확인해요",
  "sub": "㈎는 두더지, ㈏는 땅강아지예요"
 },
 {
  "t": 166.6,
  "end": 172.77,
  "section": "확인해요",
  "sub": "둘 다 앞다리를 이용해 땅을 팔 수 있어요"
 },
 {
  "t": 172.77,
  "end": 177.27,
  "section": "마무리",
  "sub": "땅속에 사는 동물은 앞다리로 땅을 파는 등 땅속에서 살기에 알맞은 생김새와 생활 방식을 가져요"
 },
 {
  "t": 177.27,
  "end": 183.27,
  "section": "마무리",
  "sub": "다음 영상: 3학년 7화 · 물에 사는 동물과 물갈퀴"
 }
]