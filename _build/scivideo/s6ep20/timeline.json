  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 20화: 하루 동안 태양과 별의 위치"
 },
 {
  "t": 6.87,
  "end": 8.6,
  "section": "궁금해요",
  "sub": "독도의 하늘이에요"
 },
 {
  "t": 8.6,
  "end": 14.57,
  "section": "궁금해요",
  "sub": "태양은 떠오르는 중일까요, 지는 중일까요?"
 },
 {
  "t": 14.57,
  "end": 19.57,
  "section": "궁금해요",
  "sub": "떠오르는 중일까요, 지는 중일까요?"
 },
 {
  "t": 19.57,
  "end": 24.1,
  "section": "궁금해요",
  "sub": "태양이 동쪽 바다 위에 있어요 → 떠오르는 중"
 },
 {
  "t": 24.1,
  "end": 31.83,
  "section": "궁금해요",
  "sub": "같은 장소에서 일정한 시간 간격으로 관찰해요"
 },
 {
  "t": 31.83,
  "end": 35.73,
  "section": "관찰 준비",
  "sub": "나침반으로 방위를 확인하고 남쪽을 바라보고 서요"
 },
 {
  "t": 35.73,
  "end": 39.33,
  "section": "관찰 준비",
  "sub": "남쪽을 바라보면 내 왼쪽은 어느 쪽일까요?"
 },
 {
  "t": 39.33,
  "end": 46.23,
  "section": "관찰 준비",
  "sub": "왼쪽이 동쪽, 오른쪽이 서쪽이에요"
 },
 {
  "t": 46.23,
  "end": 54.93,
  "section": "관찰 준비",
  "sub": "태양은 맨눈·선글라스로 보지 않고 태양 관측 안경으로 잠깐만"
 },
 {
  "t": 54.93,
  "end": 58.13,
  "section": "태양 관찰",
  "sub": "학교 운동장에서 남쪽 하늘을 바라봐요"
 },
 {
  "t": 58.13,
  "end": 63.9,
  "section": "태양 관찰",
  "sub": "오전 8시 30분부터 두 시간마다 태양 붙임딱지를 붙여요"
 },
 {
  "t": 63.9,
  "end": 68.9,
  "section": "태양 관찰",
  "sub": "태양의 위치는 어떻게 달라졌나요?"
 },
 {
  "t": 68.9,
  "end": 74.07,
  "section": "태양 관찰",
  "sub": "동쪽 하늘 → 남쪽 하늘 → 서쪽 하늘"
 },
 {
  "t": 74.07,
  "end": 81.9,
  "section": "태양 관찰",
  "sub": "다른 날짜에도 동쪽에서 서쪽으로 위치가 달라져요"
 },
 {
  "t": 81.9,
  "end": 85.6,
  "section": "별 관찰",
  "sub": "천체 관측 프로그램으로 밤하늘의 별을 관찰해요"
 },
 {
  "t": 85.6,
  "end": 92.17,
  "section": "별 관찰",
  "sub": "오후 7시, 동쪽 하늘의 밝은 별 견우성을 골라 표시해요"
 },
 {
  "t": 92.17,
  "end": 95.63,
  "section": "별 관찰",
  "sub": "남동쪽 하늘의 붉은 별 안타레스도 표시해요"
 },
 {
  "t": 95.63,
  "end": 100.63,
  "section": "별 관찰",
  "sub": "별의 위치는 어떻게 달라졌나요?"
 },
 {
  "t": 100.63,
  "end": 104.73,
  "section": "별 관찰",
  "sub": "별도 동쪽 하늘에서 서쪽 하늘로 위치가 달라져요"
 },
 {
  "t": 104.73,
  "end": 110.8,
  "section": "별 관찰",
  "sub": "안타레스는 오전 2시에 서쪽 지평선 아래로 내려가요"
 },
 {
  "t": 110.8,
  "end": 113.63,
  "section": "정리해요",
  "sub": "태양과 별의 위치 변화를 비교해요"
 },
 {
  "t": 113.63,
  "end": 121.23,
  "section": "정리해요",
  "sub": "방향이 서로 같아요 — 다른 날짜에 관찰해도 같아요"
 },
 {
  "t": 121.23,
  "end": 125.77,
  "section": "생각해요",
  "sub": "우리나라에서 해돋이를 일찍 보려면?"
 },
 {
  "t": 125.77,
  "end": 130.47,
  "section": "생각해요",
  "sub": "동쪽으로 가요 — 태양은 동쪽 하늘에서 떠요"
 },
 {
  "t": 130.47,
  "end": 137.77,
  "section": "생각해요",
  "sub": "태양과 별은 왜 동쪽에서 서쪽으로 달라질까요?"
 },
 {
  "t": 137.77,
  "end": 143.57,
