  "sub": "「과학 원리 돋보기」 6학년 20화: 하루 동안 태양과 별의 위치"
 },
 {
  "t": 5.5,
  "end": 7.4,
  "section": "궁금해요",
  "sub": "독도의 하늘이에요"
 },
 {
  "t": 7.4,
  "end": 12.13,
  "section": "궁금해요",
  "sub": "태양은 떠오르는 중일까요, 지는 중일까요?"
 },
 {
  "t": 12.13,
  "end": 17.13,
  "section": "궁금해요",
  "sub": "떠오르는 중일까요, 지는 중일까요?"
 },
 {
  "t": 17.13,
  "end": 22.1,
  "section": "궁금해요",
  "sub": "태양이 동쪽 바다 위에 있어요 → 떠오르는 중"
 },
 {
  "t": 22.1,
  "end": 29.83,
  "section": "궁금해요",
  "sub": "같은 장소에서 일정한 시간 간격으로 관찰해요"
 },
 {
  "t": 29.83,
  "end": 33.87,
  "section": "관찰 준비",
  "sub": "나침반으로 방위를 확인하고 남쪽을 바라보고 서요"
 },
 {
  "t": 33.87,
  "end": 37.27,
  "section": "관찰 준비",
  "sub": "남쪽을 바라보면 내 왼쪽은 어느 쪽일까요?"
 },
 {
  "t": 37.27,
  "end": 43.0,
  "section": "관찰 준비",
  "sub": "왼쪽이 동쪽, 오른쪽이 서쪽이에요"
 },
 {
  "t": 43.0,
  "end": 50.93,
  "section": "관찰 준비",
  "sub": "태양은 맨눈·선글라스로 보지 않고 태양 관측 안경으로 잠깐만"
 },
 {
  "t": 50.93,
  "end": 54.17,
  "section": "태양 관찰",
  "sub": "학교 운동장에서 남쪽 하늘을 바라봐요"
 },
 {
  "t": 54.17,
  "end": 59.73,
  "section": "태양 관찰",
  "sub": "오전 8시 30분부터 두 시간마다 태양 붙임딱지를 붙여요"
 },
 {
  "t": 59.73,
  "end": 64.73,
  "section": "태양 관찰",
  "sub": "태양의 위치는 어떻게 달라졌나요?"
 },
 {
  "t": 64.73,
  "end": 69.97,
  "section": "태양 관찰",
  "sub": "동쪽 하늘 → 남쪽 하늘 → 서쪽 하늘"
 },
 {
  "t": 69.97,
  "end": 77.23,
  "section": "태양 관찰",
  "sub": "다른 날짜에도 동쪽에서 서쪽으로 위치가 달라져요"
 },
 {
  "t": 77.23,
  "end": 81.13,
  "section": "별 관찰",
  "sub": "천체 관측 프로그램으로 밤하늘의 별을 관찰해요"
 },
 {
  "t": 81.13,
  "end": 87.37,
  "section": "별 관찰",
  "sub": "오후 7시, 동쪽 하늘의 밝은 별 견우성을 골라 표시해요"
 },
 {
  "t": 87.37,
  "end": 90.93,
  "section": "별 관찰",
  "sub": "남동쪽 하늘의 붉은 별 안타레스도 표시해요"
 },
 {
  "t": 90.93,
  "end": 95.93,
  "section": "별 관찰",
  "sub": "별의 위치는 어떻게 달라졌나요?"
 },
 {
  "t": 95.93,
  "end": 100.17,
