 },
 {
  "t": 109.17,
  "end": 116.1,
  "section": "정리해요",
  "sub": "방향이 서로 같아요 — 다른 날짜에 관찰해도 같아요"
 },
 {
  "t": 116.1,
  "end": 121.0,
  "section": "생각해요",
  "sub": "우리나라에서 해돋이를 일찍 보려면?"
 },
 {
  "t": 121.0,
  "end": 125.23,
