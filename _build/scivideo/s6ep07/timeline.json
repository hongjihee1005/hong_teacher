[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 7화: 운동하는 물체의 특징"
 },
 {
  "t": 5.5,
  "end": 11.57,
  "section": "궁금해요",
  "sub": "사진을 찍고 난 뒤 무엇이 달라졌나요?"
 },
 {
  "t": 11.57,
  "end": 18.73,
  "section": "궁금해요",
  "sub": "새는 날아가 위치가 바뀌고, 나무는 그대로예요"
 },
 {
  "t": 18.73,
  "end": 28.3,
  "section": "궁금해요",
  "sub": "가만히 있는 공과 굴러가는 공, 운동하는 물체는?"
 },
 {
  "t": 28.3,
  "end": 34.5,
  "section": "관찰해요",
  "sub": "교실을 5초 간격으로 두 번 찍어 비교해요"
 },
 {
  "t": 34.5,
  "end": 39.23,
  "section": "관찰해요",
  "sub": "찰칵! 그리고 5초 뒤에 또 찰칵!"
 },
 {
  "t": 39.23,
  "end": 44.23,
  "section": "관찰해요",
  "sub": "5초 뒤 다른 위치에 있는 물체는?"
 },
 {
  "t": 44.23,
  "end": 48.8,
  "section": "관찰해요",
  "sub": "걸어가는 친구와 시곗바늘은 다른 위치에 있어요"
 },
 {
  "t": 48.8,
  "end": 55.63,
  "section": "관찰해요",
  "sub": "책상·창문·화분·친구 둘은 같은 위치에 있어요"
 },
 {
  "t": 55.63,
  "end": 61.47,
  "section": "관찰해요",
  "sub": "운동하는 물체는 시간이 지났을 때 다른 위치에 있어요"
 },
 {
  "t": 61.47,
  "end": 67.2,
  "section": "관찰해요",
  "sub": "공원의 처음 모습과 얼마 뒤 모습을 비교해요"
 },
 {
  "t": 67.2,
  "end": 73.6,
  "section": "관찰해요",
  "sub": "자전거·오리 배·비행기·달리는 사람은 위치가 변했어요"
 },
 {
  "t": 73.6,
  "end": 81.5,
  "section": "관찰해요",
  "sub": "나무·운동 기구·의자·책 읽는 사람은 그대로예요"
 },
 {
  "t": 81.5,
  "end": 91.43,
  "section": "관찰해요",
  "sub": "바닷가에서도 찾아봐요"
 },
 {
  "t": 91.43,
  "end": 97.17,
  "section": "정리해요",
  "sub": "교실·공원·바닷가에서 찾은 운동하는 물체의 공통점은?"
 },
 {
  "t": 97.17,
  "end": 101.17,
  "section": "정리해요",
  "sub": "공통점을 골라 보세요"
 },
 {
  "t": 101.17,
  "end": 111.1,
  "section": "정리해요",
  "sub": "시간이 지남에 따라 물체의 위치가 변해요"
 },
 {
  "t": 111.1,
  "end": 115.5,
  "section": "생각 바로잡기",
  "sub": "몸을 단련하는 것도 '운동'이라고 하지요?"
 },
 {
  "t": 115.5,
  "end": 125.0,
  "section": "생각 바로잡기",
  "sub": "과학에서는 위치가 변할 때 운동한다고 해요"
 },
 {
  "t": 125.0,
  "end": 132.57,
  "section": "생각 바로잡기",
  "sub": "주차된 자동차, 철봉에 가만히 매달린 것은 운동일까요?"
 },
 {
  "t": 132.57,
  "end": 141.83,
  "section": "생각 바로잡기",
  "sub": "아니요, 시간이 지나도 위치가 변하지 않아요"
 },
 {
  "t": 141.83,
  "end": 146.33,
  "section": "한눈에 쏙",
  "sub": "운동하는 물체는 시간이 지남에 따라 위치가 변해요"
 },
 {
  "t": 146.33,
  "end": 150.83,
  "section": "마무리",
  "sub": "운동하는 물체는 시간이 지남에 따라 물체의 위치가 변해요"
 },
 {
  "t": 150.83,
  "end": 156.83,
  "section": "마무리",
  "sub": "다음 영상: 6학년 8화 · 물체의 운동을 나타내기"
 }
