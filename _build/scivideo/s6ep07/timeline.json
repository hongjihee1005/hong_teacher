[
 {
  "t": 0.0,
  "end": 6.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 7화: 운동하는 물체의 특징"
 },
 {
  "t": 6.5,
  "end": 14.17,
  "section": "궁금해요",
  "sub": "사진을 찍고 난 뒤 무엇이 달라졌나요?"
 },
 {
  "t": 14.17,
  "end": 21.6,
  "section": "궁금해요",
  "sub": "새는 날아가 위치가 바뀌고, 나무는 그대로예요"
 },
 {
  "t": 21.6,
  "end": 31.93,
  "section": "궁금해요",
  "sub": "가만히 있는 공과 굴러가는 공, 운동하는 물체는?"
 },
 {
  "t": 31.93,
  "end": 38.9,
  "section": "관찰해요",
  "sub": "교실을 5초 간격으로 두 번 찍어 비교해요"
 },
 {
  "t": 38.9,
  "end": 45.37,
  "section": "관찰해요",
  "sub": "찰칵! 그리고 5초 뒤에 또 찰칵!"
 },
 {
  "t": 45.37,
  "end": 50.37,
  "section": "관찰해요",
  "sub": "5초 뒤 다른 위치에 있는 물체는?"
 },
 {
  "t": 50.37,
  "end": 54.73,
  "section": "관찰해요",
  "sub": "걸어가는 친구와 시곗바늘은 다른 위치에 있어요"
 },
 {
  "t": 54.73,
  "end": 63.27,
  "section": "관찰해요",
  "sub": "책상·창문·화분·친구 둘은 같은 위치에 있어요"
 },
 {
  "t": 63.27,
  "end": 68.93,
  "section": "관찰해요",
  "sub": "운동하는 물체는 시간이 지났을 때 다른 위치에 있어요"
 },
 {
  "t": 68.93,
  "end": 74.47,
  "section": "관찰해요",
  "sub": "공원의 처음 모습과 얼마 뒤 모습을 비교해요"
 },
 {
  "t": 74.47,
  "end": 81.83,
  "section": "관찰해요",
  "sub": "자전거·오리 배·비행기·달리는 사람은 위치가 변했어요"
 },
 {
  "t": 81.83,
  "end": 91.6,
  "section": "관찰해요",
  "sub": "나무·운동 기구·의자·책 읽는 사람은 그대로예요"
 },
 {
  "t": 91.6,
  "end": 103.17,
  "section": "관찰해요",
  "sub": "바닷가에서도 찾아봐요"
 },
 {
  "t": 103.17,
  "end": 109.33,
  "section": "정리해요",
  "sub": "교실·공원·바닷가에서 찾은 운동하는 물체의 공통점은?"
 },
 {
  "t": 109.33,
  "end": 114.0,
  "section": "정리해요",
  "sub": "공통점을 골라 보세요"
 },
 {
  "t": 114.0,
  "end": 124.47,
  "section": "정리해요",
  "sub": "시간이 지남에 따라 물체의 위치가 변해요"
 },
 {
  "t": 124.47,
  "end": 128.73,
  "section": "생각 바로잡기",
  "sub": "몸을 단련하는 것도 '운동'이라고 하지요?"
 },
 {
  "t": 128.73,
  "end": 138.6,
  "section": "생각 바로잡기",
  "sub": "과학에서는 위치가 변할 때 운동한다고 해요"
 },
 {
  "t": 138.6,
  "end": 146.87,
  "section": "생각 바로잡기",
  "sub": "주차된 자동차, 철봉에 가만히 매달린 것은 운동일까요?"
 },
 {
  "t": 146.87,
  "end": 157.37,
  "section": "생각 바로잡기",
  "sub": "아니요, 시간이 지나도 위치가 변하지 않아요"
 },
 {
  "t": 157.37,
  "end": 161.83,
  "section": "한눈에 쏙",
  "sub": "운동하는 물체는 시간이 지남에 따라 위치가 변해요"
 },
 {
  "t": 161.83,
  "end": 166.38,
  "section": "마무리",
  "sub": "운동하는 물체는 시간이 지남에 따라 물체의 위치가 변해요"
 },
 {
  "t": 166.38,
  "end": 173.07,
  "section": "마무리",
