[
 {
  "t": 0.0,
  "end": 6.23,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 9화: 빛을 거울에 비추면?"
 },
 {
  "t": 6.23,
  "end": 12.67,
  "section": "궁금해요",
  "sub": "천장을 비추는 밝은 빛은 어디에서 온 것일까요?"
 },
 {
  "t": 12.67,
  "end": 17.67,
  "section": "궁금해요",
  "sub": "천장의 빛은 어디에서 왔을까요?"
 },
 {
  "t": 17.67,
  "end": 20.17,
  "section": "궁금해요",
  "sub": "빛이 지나온 길을 따라가 봐요"
 },
 {
  "t": 20.17,
  "end": 29.47,
  "section": "궁금해요",
  "sub": "햇빛이 거울을 만나 방향이 바뀌어 천장을 비췄어요"
 },
 {
  "t": 29.47,
  "end": 37.0,
  "section": "실험해요 1",
  "sub": "흰 종이 위에 평면거울을 수직으로 세워요"
 },
 {
  "t": 37.0,
  "end": 47.93,
  "section": "실험해요 1",
  "sub": "레이저 빛을 사람에게 비추지 않아요"
 },
 {
  "t": 47.93,
  "end": 51.77,
  "section": "실험해요 1",
  "sub": "교실을 어둡게 하고 레이저 지시기를 거울을 향해 켜요"
 },
 {
  "t": 51.77,
  "end": 57.67,
  "section": "실험해요 1",
  "sub": "거울에 닿은 빛은 어떻게 될까요?"
 },
 {
  "t": 57.67,
  "end": 64.17,
  "section": "실험해요 1",
  "sub": "거울에 부딪친 빛은 나아가는 방향이 바뀌어요"
 },
 {
  "t": 64.17,
  "end": 68.93,
  "section": "실험해요 1",
  "sub": "여러 방향으로 비추어 봐요"
 },
 {
  "t": 68.93,
  "end": 76.8,
  "section": "실험해요 1",
  "sub": "어느 방향으로 비추어도 거울에서 방향이 바뀌어 곧게 나아가요"
 },
 {
  "t": 76.8,
  "end": 86.37,
  "section": "실험해요 2",
  "sub": "거울에 비춘 빛으로 세모·네모·원을 맞혀요"
 },
 {
  "t": 86.37,
  "end": 93.6,
  "section": "실험해요 2",
  "sub": "어느 쪽으로 비추어야 할까요?"
 },
 {
  "t": 93.6,
  "end": 101.43,
  "section": "실험해요 2",
  "sub": "거울에서 방향이 바뀐 빛이 세모를 맞혔어요!"
 },
 {
  "t": 101.43,
  "end": 110.13,
  "section": "실험해요 2",
  "sub": "레이저나 거울의 방향을 바꾸면 빛의 방향도 바뀌어요"
 },
 {
  "t": 110.13,
  "end": 118.63,
  "section": "정리해요",
  "sub": "이런 빛의 성질을 빛의 반사라고 해요"
 },
 {
  "t": 118.63,
  "end": 123.6,
  "section": "정리해요",
  "sub": "우리는 어떻게 사과를 볼 수 있을까요?"
 },
 {
  "t": 123.6,
  "end": 131.3,
  "section": "정리해요",
  "sub": "물체가 반사한 빛이 우리 눈에 들어오기 때문이에요"
 },
 {
  "t": 131.3,
  "end": 134.67,
  "section": "생활 속 반사",
  "sub": "높은 산으로 둘러싸여 해가 들지 않는 마을이 있어요"
 },
 {
  "t": 134.67,
  "end": 140.93,
  "section": "생활 속 반사",
  "sub": "산꼭대기에 커다란 거울을 설치했어요. 왜일까요?"
 },
 {
  "t": 140.93,
  "end": 148.57,
  "section": "생활 속 반사",
  "sub": "산꼭대기에 거울을 설치한 까닭은?"
 },
 {
  "t": 148.57,
  "end": 160.23,
  "section": "생활 속 반사",
  "sub": "거울이 햇빛을 반사해 그늘진 마을에 햇빛이 들어요"
 },
 {
  "t": 160.23,
  "end": 166.17,
  "section": "한눈에 쏙",
  "sub": "물체가 반사한 빛이 눈에 들어와 물체를 볼 수 있어요"
 },
 {
  "t": 166.17,
  "end": 171.13,
  "section": "한눈에 쏙",
  "sub": "거울처럼 빛의 반사가 일어나는 것을 골라 봐요"
 },
 {
  "t": 171.13,
  "end": 179.6,
  "section": "한눈에 쏙",
  "sub": "매끄러운 면은 거울처럼 빛을 반사해요. 그림자는 직진이에요"
 },
 {
  "t": 179.6,
  "end": 184.48,
  "section": "마무리",
  "sub": "빛이 거울에 부딪쳐 나아가는 방향이 바뀌는 성질 = 빛의 반사"
 },
 {
  "t": 184.48,
  "end": 190.8,
  "section": "마무리",
  "sub": "다음 영상: 5학년 10화 · 렌즈와 물을 지날 때"
 }
