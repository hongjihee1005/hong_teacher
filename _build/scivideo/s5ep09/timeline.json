  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 9화: 빛을 거울에 비추면?"
 },
 {
  "t": 5.47,
  "end": 12.33,
  "section": "궁금해요",
  "sub": "천장을 비추는 밝은 빛은 어디에서 온 것일까요?"
 },
 {
  "t": 12.33,
  "end": 17.33,
  "section": "궁금해요",
  "sub": "천장의 빛은 어디에서 왔을까요?"
 },
 {
  "t": 17.33,
  "end": 19.87,
  "section": "궁금해요",
  "sub": "빛이 지나온 길을 따라가 봐요"
 },
 {
  "t": 19.87,
  "end": 28.8,
  "section": "궁금해요",
  "sub": "햇빛이 거울을 만나 방향이 바뀌어 천장을 비췄어요"
 },
 {
  "t": 28.8,
  "end": 36.07,
  "section": "실험해요 1",
  "sub": "흰 종이 위에 평면거울을 수직으로 세워요"
 },
 {
  "t": 36.07,
  "end": 45.13,
  "section": "실험해요 1",
  "sub": "레이저 빛을 사람에게 비추지 않아요"
 },
 {
  "t": 45.13,
  "end": 49.33,
  "section": "실험해요 1",
  "sub": "교실을 어둡게 하고 레이저 지시기를 거울을 향해 켜요"
 },
 {
  "t": 49.33,
  "end": 55.27,
  "section": "실험해요 1",
  "sub": "거울에 닿은 빛은 어떻게 될까요?"
 },
 {
  "t": 55.27,
  "end": 61.33,
  "section": "실험해요 1",
  "sub": "거울에 부딪친 빛은 나아가는 방향이 바뀌어요"
 },
 {
  "t": 61.33,
  "end": 66.33,
  "section": "실험해요 1",
  "sub": "여러 방향으로 비추어 봐요"
 },
 {
  "t": 66.33,
  "end": 73.93,
  "section": "실험해요 1",
  "sub": "어느 방향으로 비추어도 거울에서 방향이 바뀌어 곧게 나아가요"
 },
 {
  "t": 73.93,
  "end": 82.13,
  "section": "실험해요 2",
  "sub": "거울에 비춘 빛으로 세모·네모·원을 맞혀요"
 },
 {
  "t": 82.13,
  "end": 89.47,
  "section": "실험해요 2",
  "sub": "어느 쪽으로 비추어야 할까요?"
 },
 {
  "t": 89.47,
  "end": 97.67,
  "section": "실험해요 2",
  "sub": "거울에서 방향이 바뀐 빛이 세모를 맞혔어요!"
 },
 {
  "t": 97.67,
  "end": 109.07,
  "section": "실험해요 2",
  "sub": "레이저나 거울의 방향을 바꾸면 빛의 방향도 바뀌어요"
 },
 {
  "t": 109.07,
  "end": 117.13,
  "section": "정리해요",
  "sub": "이런 빛의 성질을 빛의 반사라고 해요"
 },
 {
  "t": 117.13,
  "end": 122.0,
  "section": "정리해요",
  "sub": "우리는 어떻게 사과를 볼 수 있을까요?"
 },
 {
  "t": 122.0,
  "end": 129.4,
  "section": "정리해요",
  "sub": "물체가 반사한 빛이 우리 눈에 들어오기 때문이에요"
 },
 {
  "t": 129.4,
  "end": 135.13,
  "section": "생활 속 반사",
  "sub": "높은 산으로 둘러싸여 해가 들지 않는 마을이 있어요"
 },
 {
  "t": 135.13,
  "end": 140.67,
  "section": "생활 속 반사",
  "sub": "산꼭대기에 커다란 거울을 설치했어요. 왜일까요?"
 },
 {
  "t": 140.67,
  "end": 148.33,
  "section": "생활 속 반사",
  "sub": "산꼭대기에 거울을 설치한 까닭은?"
 },
 {
  "t": 148.33,
  "end": 159.73,
  "section": "생활 속 반사",
  "sub": "거울이 햇빛을 반사해 그늘진 마을에 햇빛이 들어요"
 },
 {
  "t": 159.73,
  "end": 165.93,
  "section": "한눈에 쏙",
  "sub": "물체가 반사한 빛이 눈에 들어와 물체를 볼 수 있어요"
 },
 {
  "t": 165.93,
  "end": 170.93,
  "section": "한눈에 쏙",
  "sub": "거울처럼 빛의 반사가 일어나는 것을 골라 봐요"
 },
 {
  "t": 170.93,
  "end": 180.6,
  "section": "한눈에 쏙",
  "sub": "매끄러운 면은 거울처럼 빛을 반사해요. 그림자는 직진이에요"
 },
 {
  "t": 180.6,
  "end": 185.1,
  "section": "마무리",
  "sub": "빛이 거울에 부딪쳐 나아가는 방향이 바뀌는 성질 = 빛의 반사"
 },
 {
