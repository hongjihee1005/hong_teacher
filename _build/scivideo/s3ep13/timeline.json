[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 13화: 사막과 높은 산의 식물"
 },
 {
  "t": 5.5,
  "end": 10.4,
  "section": "궁금해요",
  "sub": "물이 부족한 곳에서 식물은 어떻게 살까요?"
 },
 {
  "t": 10.4,
  "end": 14.8,
  "section": "궁금해요",
  "sub": "사막은 비가 거의 내리지 않아 건조해요"
 },
 {
  "t": 14.8,
  "end": 17.87,
  "section": "궁금해요",
  "sub": "사막은 언제나 뜨거운 곳일까요?"
 },
 {
  "t": 17.87,
  "end": 22.27,
  "section": "궁금해요",
  "sub": "맞을까요, 틀릴까요?"
 },
 {
  "t": 22.27,
  "end": 29.5,
  "section": "궁금해요",
  "sub": "생각 바로잡기: 사막은 밤에는 추워요 — 기준은 비의 양"
 },
 {
  "t": 29.5,
  "end": 37.03,
  "section": "관찰해요",
  "sub": "사막에 사는 알로에를 관찰해요"
 },
 {
  "t": 37.03,
  "end": 41.1,
  "section": "관찰해요",
  "sub": "잎이 두껍고 표면이 매끈하며 광택이 나요"
 },
 {
  "t": 41.1,
  "end": 45.2,
  "section": "관찰해요",
  "sub": "잎의 가장자리에는 가시가 있어요"
 },
 {
  "t": 45.2,
  "end": 48.77,
  "section": "실험해요",
  "sub": "집게로 잡고 플라스틱 칼로 잘라요"
 },
 {
  "t": 48.77,
  "end": 50.67,
  "section": "실험해요",
  "sub": "자른 면을 관찰해요"
 },
 {
  "t": 50.67,
  "end": 56.37,
  "section": "실험해요",
  "sub": "알로에 잎 속은 어떨까요?"
 },
 {
  "t": 56.37,
  "end": 62.1,
  "section": "실험해요",
  "sub": "껍질이 두껍고 안쪽이 미끌미끌하고 축축해요"
 },
 {
  "t": 62.1,
  "end": 68.87,
  "section": "실험해요",
  "sub": "휴지를 대면 젖어요 — 잎 속에 물이 많아요"
 },
 {
  "t": 68.87,
  "end": 74.77,
  "section": "정리해요",
  "sub": "잎이 두꺼워 물을 많이 저장해요"
 },
 {
  "t": 74.77,
  "end": 79.0,
  "section": "정리해요",
  "sub": "두꺼운 껍질이 물이 빠져나가는 것을 막아요"
 },
 {
  "t": 79.0,
  "end": 85.27,
  "section": "정리해요",
  "sub": "가시가 동물에게 먹히는 것을 막아요"
 },
 {
  "t": 85.27,
  "end": 89.33,
  "section": "조사해요",
  "sub": "선인장은 줄기가 굵어 물을 저장해요"
 },
 {
  "t": 89.33,
  "end": 94.9,
  "section": "조사해요",
  "sub": "잎은 가시 모양이에요"
 },
 {
  "t": 94.9,
  "end": 102.47,
  "section": "조사해요",
  "sub": "비가 조금 내리면 얕고 넓은 뿌리가 빠르게 흡수해요"
 },
 {
  "t": 102.47,
  "end": 109.9,
  "section": "조사해요",
  "sub": "비가 오지 않아도 깊은 뿌리가 깊은 곳의 물을 흡수해요"
 },
 {
  "t": 109.9,
  "end": 117.3,
  "section": "높은 산",
  "sub": "한라산처럼 높은 산에는 어떤 식물이 살까요?"
 },
 {
  "t": 117.3,
  "end": 120.7,
  "section": "높은 산",
  "sub": "한라솜다리는 키가 작아요"
 },
 {
  "t": 120.7,
  "end": 125.93,
  "section": "높은 산",
  "sub": "암매는 키가 3~5 cm이고 모여서 자라요"
 },
 {
  "t": 125.93,
  "end": 130.07,
  "section": "높은 산",
  "sub": "눈잣나무는 줄기가 누워서 자라요"
 },
 {
  "t": 130.07,
  "end": 132.8,
  "section": "높은 산",
  "sub": "강한 바람이 불면 어떻게 될까요?"
 },
 {
  "t": 132.8,
  "end": 141.07,
  "section": "높은 산",
  "sub": "키가 작거나 누워 자라면 바람을 덜 받아요"
 },
 {
  "t": 141.07,
  "end": 151.83,
  "section": "정리해요",
  "sub": "한눈에 쏙 정리해요"
 },
 {
  "t": 151.83,
  "end": 157.23,
  "section": "생각해요",
  "sub": "눈잣나무를 산 아래에서 키우면 어떻게 자랄까요?"
 },
 {
  "t": 157.23,
  "end": 162.93,
  "section": "생각해요",
  "sub": "위로 곧게? 그대로 누워서?"
 },
 {
  "t": 162.93,
  "end": 171.6,
  "section": "생각해요",
  "sub": "바람이 약한 산 아래에서는 위로 곧게 자라요"
 },
 {
  "t": 171.6,
  "end": 176.1,
  "section": "마무리",
  "sub": "사막 식물은 잎이 두껍거나 줄기가 굵어 물을 저장하고, 높은 산 식물은 키가 작거나 줄기가 누워 바람을 견뎌요"
 },
 {
