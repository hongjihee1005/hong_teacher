[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 13화: 사막과 높은 산의 식물"
 },
 {
  "t": 5.47,
  "end": 10.33,
  "section": "궁금해요",
  "sub": "물이 부족한 곳에서 식물은 어떻게 살까요?"
 },
 {
  "t": 10.33,
  "end": 14.73,
  "section": "궁금해요",
  "sub": "사막은 비가 거의 내리지 않아 건조해요"
 },
 {
  "t": 14.73,
  "end": 17.8,
  "section": "궁금해요",
  "sub": "사막은 언제나 뜨거운 곳일까요?"
 },
 {
  "t": 17.8,
  "end": 22.2,
  "section": "궁금해요",
  "sub": "맞을까요, 틀릴까요?"
 },
 {
  "t": 22.2,
  "end": 29.47,
  "section": "궁금해요",
  "sub": "생각 바로잡기: 사막은 밤에는 추워요 — 기준은 비의 양"
 },
 {
  "t": 29.47,
  "end": 37.0,
  "section": "관찰해요",
  "sub": "사막에 사는 알로에를 관찰해요"
 },
 {
  "t": 37.0,
  "end": 41.0,
  "section": "관찰해요",
  "sub": "잎이 두껍고 표면이 매끈하며 광택이 나요"
 },
 {
  "t": 41.0,
  "end": 45.07,
  "section": "관찰해요",
  "sub": "잎의 가장자리에는 가시가 있어요"
 },
 {
  "t": 45.07,
  "end": 48.6,
  "section": "실험해요",
  "sub": "집게로 잡고 플라스틱 칼로 잘라요"
 },
 {
  "t": 48.6,
  "end": 50.47,
  "section": "실험해요",
  "sub": "자른 면을 관찰해요"
 },
 {
  "t": 50.47,
  "end": 56.2,
  "section": "실험해요",
  "sub": "알로에 잎 속은 어떨까요?"
 },
 {
  "t": 56.2,
  "end": 61.87,
  "section": "실험해요",
  "sub": "껍질이 두껍고 안쪽이 미끌미끌하고 축축해요"
 },
 {
  "t": 61.87,
  "end": 68.6,
  "section": "실험해요",
  "sub": "휴지를 대면 젖어요 — 잎 속에 물이 많아요"
 },
 {
  "t": 68.6,
  "end": 74.47,
  "section": "정리해요",
  "sub": "잎이 두꺼워 물을 많이 저장해요"
 },
 {
  "t": 74.47,
  "end": 78.67,
  "section": "정리해요",
  "sub": "두꺼운 껍질이 물이 빠져나가는 것을 막아요"
 },
 {
  "t": 78.67,
  "end": 84.93,
  "section": "정리해요",
  "sub": "가시가 동물에게 먹히는 것을 막아요"
 },
 {
  "t": 84.93,
  "end": 89.0,
  "section": "조사해요",
  "sub": "선인장은 줄기가 굵어 물을 저장해요"
 },
 {
  "t": 89.0,
  "end": 94.53,
  "section": "조사해요",
  "sub": "잎은 가시 모양이에요"
 },
 {
  "t": 94.53,
  "end": 102.07,
  "section": "조사해요",
  "sub": "비가 조금 내리면 얕고 넓은 뿌리가 빠르게 흡수해요"
 },
 {
  "t": 102.07,
  "end": 109.47,
  "section": "조사해요",
  "sub": "비가 오지 않아도 깊은 뿌리가 깊은 곳의 물을 흡수해요"
 },
 {
  "t": 109.47,
  "end": 116.87,
  "section": "높은 산",
  "sub": "한라산처럼 높은 산에는 어떤 식물이 살까요?"
 },
 {
  "t": 116.87,
  "end": 120.27,
  "section": "높은 산",
  "sub": "한라솜다리는 키가 작아요"
 },
 {
  "t": 120.27,
  "end": 125.47,
  "section": "높은 산",
  "sub": "암매는 키가 3~5 cm이고 모여서 자라요"
 },
 {
  "t": 125.47,
  "end": 129.6,
  "section": "높은 산",
  "sub": "눈잣나무는 줄기가 누워서 자라요"
 },
 {
  "t": 129.6,
  "end": 132.33,
  "section": "높은 산",
  "sub": "강한 바람이 불면 어떻게 될까요?"
 },
 {
  "t": 132.33,
  "end": 140.6,
  "section": "높은 산",
  "sub": "키가 작거나 누워 자라면 바람을 덜 받아요"
 },
 {
  "t": 140.6,
  "end": 151.33,
  "section": "정리해요",
  "sub": "한눈에 쏙 정리해요"
 },
 {
  "t": 151.33,
  "end": 156.73,
  "section": "생각해요",
  "sub": "눈잣나무를 산 아래에서 키우면 어떻게 자랄까요?"
 },
 {
  "t": 156.73,
  "end": 162.47,
  "section": "생각해요",
  "sub": "위로 곧게? 그대로 누워서?"
 },
 {
  "t": 162.47,
  "end": 171.13,
  "section": "생각해요",
  "sub": "바람이 약한 산 아래에서는 위로 곧게 자라요"
 },
 {
  "t": 171.13,
  "end": 175.63,
  "section": "마무리",
  "sub": "사막 식물은 잎이 두껍거나 줄기가 굵어 물을 저장하고, 높은 산 식물은 키가 작거나 줄기가 누워 바람을 견뎌요"
 },
 {
  "t": 175.63,
  "end": 181.6,
  "section": "마무리",
  "sub": "다음 영상: 3학년 14화 · 식물의 특징을 본뜬 생활용품"
 }
]