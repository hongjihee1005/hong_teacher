[
 {
  "t": 0.0,
  "end": 6.8,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 13화: 사막과 높은 산의 식물"
 },
 {
  "t": 6.8,
  "end": 12.3,
  "section": "궁금해요",
  "sub": "물이 부족한 곳에서 식물은 어떻게 살까요?"
 },
 {
  "t": 12.3,
  "end": 16.5,
  "section": "궁금해요",
  "sub": "사막은 비가 거의 내리지 않아 건조해요"
 },
 {
  "t": 16.5,
  "end": 19.7,
  "section": "궁금해요",
  "sub": "사막은 언제나 뜨거운 곳일까요?"
 },
 {
  "t": 19.7,
  "end": 24.77,
  "section": "궁금해요",
  "sub": "맞을까요, 틀릴까요?"
 },
 {
  "t": 24.77,
  "end": 32.97,
  "section": "궁금해요",
  "sub": "생각 바로잡기: 사막은 밤에는 추워요 — 기준은 비의 양"
 },
 {
  "t": 32.97,
  "end": 41.83,
  "section": "관찰해요",
  "sub": "사막에 사는 알로에를 관찰해요"
 },
 {
  "t": 41.83,
  "end": 46.7,
  "section": "관찰해요",
  "sub": "잎이 두껍고 표면이 매끈하며 광택이 나요"
 },
 {
  "t": 46.7,
  "end": 50.73,
  "section": "관찰해요",
  "sub": "잎의 가장자리에는 가시가 있어요"
 },
 {
  "t": 50.73,
  "end": 54.2,
  "section": "실험해요",
  "sub": "집게로 잡고 플라스틱 칼로 잘라요"
 },
 {
  "t": 54.2,
  "end": 56.17,
  "section": "실험해요",
  "sub": "자른 면을 관찰해요"
 },
 {
  "t": 56.17,
  "end": 61.87,
  "section": "실험해요",
  "sub": "알로에 잎 속은 어떨까요?"
 },
 {
  "t": 61.87,
  "end": 68.43,
  "section": "실험해요",
  "sub": "껍질이 두껍고 안쪽이 미끌미끌하고 축축해요"
 },
 {
  "t": 68.43,
  "end": 75.67,
  "section": "실험해요",
  "sub": "휴지를 대면 젖어요 — 잎 속에 물이 많아요"
 },
 {
  "t": 75.67,
  "end": 82.0,
  "section": "정리해요",
  "sub": "잎이 두꺼워 물을 많이 저장해요"
 },
 {
  "t": 82.0,
  "end": 85.93,
  "section": "정리해요",
  "sub": "두꺼운 껍질이 물이 빠져나가는 것을 막아요"
 },
 {
  "t": 85.93,
  "end": 91.97,
  "section": "정리해요",
  "sub": "가시가 동물에게 먹히는 것을 막아요"
 },
 {
  "t": 91.97,
  "end": 96.03,
  "section": "조사해요",
  "sub": "선인장은 줄기가 굵어 물을 저장해요"
 },
 {
  "t": 96.03,
  "end": 102.1,
  "section": "조사해요",
  "sub": "잎은 가시 모양이에요"
 },
 {
  "t": 102.1,
  "end": 110.83,
  "section": "조사해요",
  "sub": "비가 조금 내리면 얕고 넓은 뿌리가 빠르게 흡수해요"
 },
 {
  "t": 110.83,
  "end": 118.07,
  "section": "조사해요",
  "sub": "비가 오지 않아도 깊은 뿌리가 깊은 곳의 물을 흡수해요"
 },
 {
  "t": 118.07,
  "end": 126.3,
  "section": "높은 산",
  "sub": "한라산처럼 높은 산에는 어떤 식물이 살까요?"
 },
 {
  "t": 126.3,
  "end": 129.53,
  "section": "높은 산",
  "sub": "한라솜다리는 키가 작아요"
 },
 {
  "t": 129.53,
  "end": 135.33,
  "section": "높은 산",
  "sub": "암매는 키가 3~5 cm이고 모여서 자라요"
 },
 {
  "t": 135.33,
  "end": 139.43,
  "section": "높은 산",
  "sub": "눈잣나무는 줄기가 누워서 자라요"
 },
 {
  "t": 139.43,
  "end": 142.3,
  "section": "높은 산",
  "sub": "강한 바람이 불면 어떻게 될까요?"
 },
 {
  "t": 142.3,
  "end": 150.97,
  "section": "높은 산",
  "sub": "키가 작거나 누워 자라면 바람을 덜 받아요"
 },
 {
  "t": 150.97,
  "end": 163.5,
  "section": "정리해요",
  "sub": "한눈에 쏙 정리해요"
 },
 {
  "t": 163.5,
  "end": 168.6,
  "section": "생각해요",
  "sub": "눈잣나무를 산 아래에서 키우면 어떻게 자랄까요?"
 },
 {
  "t": 168.6,
  "end": 174.3,
  "section": "생각해요",
  "sub": "위로 곧게? 그대로 누워서?"
 },
 {
  "t": 174.3,
  "end": 183.33,
  "section": "생각해요",
  "sub": "바람이 약한 산 아래에서는 위로 곧게 자라요"
 },
 {
  "t": 183.33,
  "end": 192.17,
  "section": "마무리",
  "sub": "사막 식물은 잎이 두껍거나 줄기가 굵어 물을 저장하고, 높은 산 식물은 키가 작거나 줄기가 누워 바람을 견뎌요"
 },
 {
  "t": 192.17,
  "end": 199.33,
  "section": "마무리",
  "sub": "다음 영상: 3학년 14화 · 식물의 특징을 본뜬 생활용품"
 }
