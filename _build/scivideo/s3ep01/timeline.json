  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 1화: 무거운 물체를 밀 때 힘이 더 들까?"
 },
 {
  "t": 7.23,
  "end": 13.9,
  "section": "궁금해요",
  "sub": "어른이 앉은 그네와 어린이가 앉은 그네"
 },
 {
  "t": 13.9,
  "end": 16.93,
  "section": "궁금해요",
  "sub": "두 그네를 밀면 어떤 차이가 있을까?"
 },
 {
  "t": 16.93,
  "end": 21.93,
  "section": "궁금해요",
  "sub": "어느 그네를 밀 때 힘이 더 들까요?"
 },
 {
  "t": 21.93,
  "end": 25.2,
  "section": "궁금해요",
  "sub": "어른이 앉은 그네를 밀 때 더 큰 힘이 들어요"
 },
 {
  "t": 25.2,
  "end": 36.6,
  "section": "궁금해요",
  "sub": "그네에 탄 사람이 무거울수록 밀 때 더 큰 힘이 들어요"
 },
 {
  "t": 36.6,
  "end": 44.77,
  "section": "실험해요",
  "sub": "상자 두 개에 복사용지 묶음을 넣어요"
 },
 {
  "t": 44.77,
  "end": 49.47,
  "section": "실험해요",
  "sub": "어느 상자가 더 무거울까요? 상자 ㉮가 더 무거워요"
 },
 {
  "t": 49.47,
  "end": 55.2,
  "section": "실험해요",
  "sub": "이제 두 상자를 각각 밀어 봐요"
 },
 {
  "t": 55.2,
  "end": 60.2,
  "section": "실험해요",
  "sub": "어느 상자를 밀 때 힘이 더 들까요?"
 },
 {
  "t": 60.2,
  "end": 64.1,
  "section": "실험해요",
  "sub": "상자 ㉮(묶음 4개)를 밀면?"
 },
 {
  "t": 64.1,
  "end": 68.17,
  "section": "실험해요",
  "sub": "무거운 상자는 큰 힘을 주어야 움직여요"
 },
 {
  "t": 68.17,
  "end": 71.87,
  "section": "실험해요",
  "sub": "상자 ㉯(묶음 1개)를 밀면?"
 },
 {
  "t": 71.87,
  "end": 76.0,
  "section": "실험해요",
  "sub": "가벼운 상자는 작은 힘으로도 움직여요"
 },
 {
  "t": 76.0,
  "end": 79.6,
  "section": "실험해요",
  "sub": "당길 때도 똑같을까요?"
 },
 {
  "t": 79.6,
  "end": 86.63,
  "section": "실험해요",
  "sub": "당길 때도 무거운 상자에 더 큰 힘이 들어요"
 },
 {
  "t": 86.63,
  "end": 92.6,
  "section": "결과 정리",
  "sub": "막대가 길수록 큰 힘이 든 거예요"
 },
 {
  "t": 92.6,
  "end": 101.07,
  "section": "결과 정리",
  "sub": "무거운 물체를 밀거나 당길 때 더 큰 힘이 들어요"
 },
 {
  "t": 101.07,
  "end": 104.53,
  "section": "무게",
  "sub": "물체가 가볍고 무거운 정도를 무게라고 해요"
 },
 {
  "t": 104.53,
  "end": 112.63,
  "section": "무게",
  "sub": "책을 넣은 가방, 물건을 담은 카트는 더 무거워요"
 },
 {
  "t": 112.63,
  "end": 117.93,
  "section": "무게",
  "sub": "가득 찬 카트를 밀 때 더 큰 힘이 들어요"
 },
 {
  "t": 117.93,
  "end": 121.57,
  "section": "생각 바로잡기",
  "sub": "크기가 크면 항상 더 무거울까요?"
 },
 {
  "t": 121.57,
  "end": 128.87,
  "section": "생각 바로잡기",
  "sub": "밀어서 움직일 때 더 큰 힘이 드는 것은?"
 },
 {
  "t": 128.87,
  "end": 133.87,
  "section": "생각 바로잡기",
  "sub": "어느 것을 밀 때 힘이 더 들까요?"
 },
 {
  "t": 133.87,
  "end": 139.9,
  "section": "생각 바로잡기",
  "sub": "작은 쇠 아령이 더 무거워서 더 큰 힘이 들어요"
 },
 {
  "t": 139.9,
  "end": 145.13,
  "section": "생각 바로잡기",
  "sub": "크기가 아니라 무게에 따라 드는 힘이 달라요"
 },
 {
  "t": 145.13,
  "end": 152.85,
  "section": "마무리",
  "sub": "무거운 물체일수록 밀거나 당길 때 더 큰 힘이 들고, 가벼운 물체일수록 더 작은 힘이 들어요"
 },
 {
  "t": 152.85,
  "end": 159.7,
  "section": "마무리",
  "sub": "다음 영상: 3학년 2화 · 수평 잡기로 무게를 비교해요"
 }
