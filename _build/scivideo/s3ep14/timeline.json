 },
 {
  "t": 24.33,
  "end": 29.2,
  "section": "관찰해요",
  "sub": "눈으로 보면 둥근 방패 모양이에요"
 },
 {
  "t": 29.2,
  "end": 32.27,
  "section": "관찰해요",
  "sub": "손으로 만지면 부드러워요"
 },
 {
  "t": 32.27,
  "end": 36.6,
  "section": "관찰해요",
  "sub": "돋보기로 보면 잔털이 촘촘해요"
 },
 {
  "t": 36.6,
  "end": 39.47,
  "section": "실험해요",
  "sub": "연잎에 물을 한 방울씩 떨어뜨려요"
 },
 {
  "t": 39.47,
  "end": 46.47,
  "section": "실험해요",
  "sub": "물방울은 어떻게 될까요?"
 },
 {
  "t": 46.47,
  "end": 52.67,
  "section": "실험해요",
  "sub": "물방울이 스며들지 않고 동그랗게 굴러가요"
 },
 {
  "t": 52.67,
  "end": 58.53,
  "section": "실험해요",
  "sub": "잔털 위에 물방울이 올라앉아 스며들지 못해요"
 },
 {
  "t": 58.53,
  "end": 65.67,
  "section": "실험해요",
  "sub": "기울이면 굴러떨어지고 젖은 흔적도 없어요"
 },
 {
  "t": 65.67,
  "end": 72.6,
  "section": "실험해요",
  "sub": "물이 스며들지 않는 특징 → 물에 젖지 않는 옷감"
 },
 {
  "t": 72.6,
  "end": 79.47,
  "section": "관찰해요",
  "sub": "가시가 많은 우엉 열매를 부직포에 붙여 봐요"
 },
 {
  "t": 79.47,
  "end": 84.2,
  "section": "관찰해요",
  "sub": "떼려고 해도 잘 떨어지지 않아요"
 },
 {
  "t": 84.2,
  "end": 89.2,
  "section": "관찰해요",
  "sub": "왜 잘 떨어지지 않을까요?"
 },
 {
  "t": 89.2,
  "end": 97.6,
  "section": "관찰해요",
  "sub": "확대경으로 보니 가시 끝이 갈고리처럼 휘어져 있어요"
 },
 {
  "t": 97.6,
  "end": 104.33,
  "section": "과학자 이야기",
  "sub": "메스트랄은 바지에 붙은 산우엉 열매를 보았어요"
 },
 {
  "t": 104.33,
  "end": 113.73,
  "section": "과학자 이야기",
  "sub": "가시 끝의 갈고리를 본떠 찍찍이 테이프를 만들었어요"
 },
 {
  "t": 113.73,
  "end": 116.27,
  "section": "짝 찾기",
