[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 23화: 고체·액체·기체는 어떻게 다를까?"
 },
 {
  "t": 5.5,
  "end": 10.07,
  "section": "궁금해요",
  "sub": "레몬차를 찻잔에 부으면 주전자 안의 물질은?"
 },
 {
  "t": 10.07,
  "end": 14.3,
  "section": "궁금해요",
  "sub": "찻물은 흘러나와 찻잔에 담겨요"
 },
 {
  "t": 14.3,
  "end": 23.23,
  "section": "궁금해요",
  "sub": "레몬 껍질은 고체, 빈 곳에는 공기가 있어요"
 },
 {
  "t": 23.23,
  "end": 31.27,
  "section": "실험해요",
  "sub": "부피는 물질이 차지하는 공간의 크기예요"
 },
 {
  "t": 31.27,
  "end": 35.5,
  "section": "실험해요",
  "sub": "나무 막대를 ㉮㉯㉰에 넣어 봐요"
 },
 {
  "t": 35.5,
  "end": 41.97,
  "section": "실험해요",
  "sub": "막대는 모양도 크기(부피)도 그대로예요"
 },
 {
  "t": 41.97,
  "end": 47.03,
  "section": "실험해요",
  "sub": "이번에는 물을 ㉮에 담고 높이를 표시해요"
 },
 {
  "t": 47.03,
  "end": 55.1,
  "section": "실험해요",
  "sub": "㉯로 옮기면 넓게 퍼지고, ㉰에서는 둥글게 — 모양이 바뀌어요"
 },
 {
  "t": 55.1,
  "end": 60.1,
  "section": "실험해요",
  "sub": "다시 ㉮로 옮기면 물의 높이는?"
 },
 {
  "t": 60.1,
  "end": 64.33,
  "section": "실험해요",
  "sub": "다시 ㉮로 옮기면 처음 높이와 똑같아요"
 },
 {
  "t": 64.33,
  "end": 70.6,
  "section": "실험해요",
  "sub": "액체는 모양은 변해도 부피는 변하지 않아요"
 },
 {
  "t": 70.6,
  "end": 76.17,
  "section": "생각해요",
  "sub": "모래는 부으면 흐르는데, 고체일까요?"
 },
 {
  "t": 76.17,
  "end": 85.77,
  "section": "생각해요",
  "sub": "알갱이 하나하나는 모양과 부피가 그대로 — 고체예요"
 },
 {
  "t": 85.77,
  "end": 94.83,
  "section": "실험해요",
  "sub": "컵 안쪽에 압축 물휴지를 붙이고 컵을 뒤집어요"
 },
 {
  "t": 94.83,
  "end": 101.57,
  "section": "실험해요",
  "sub": "한 컵은 구멍을 테이프로 막고, 한 컵은 막지 않아요"
 },
 {
  "t": 101.57,
  "end": 106.57,
  "section": "실험해요",
  "sub": "물휴지는 어떻게 될까요?"
 },
 {
  "t": 106.57,
  "end": 113.3,
  "section": "실험해요",
  "sub": "① 막은 컵: 물이 들어오지 않아 물휴지가 그대로예요"
 },
 {
  "t": 113.3,
  "end": 120.53,
  "section": "실험해요",
  "sub": "수조 물 높이는 조금 높아져요 — 공기가 공간을 차지해요"
 },
 {
  "t": 120.53,
  "end": 125.77,
  "section": "실험해요",
  "sub": "② 막지 않은 컵: 공기가 구멍으로 빠져나가요"
 },
 {
  "t": 125.77,
  "end": 133.0,
  "section": "실험해요",
  "sub": "물이 들어와 물휴지가 젖어서 커져요"
 },
 {
  "t": 133.0,
  "end": 139.77,
  "section": "실험해요",
  "sub": "기체는 공간을 차지하고, 이동할 수 있어요"
 },
 {
  "t": 139.77,
  "end": 147.53,
  "section": "생활 속 기체",
  "sub": "풍선·타이어·공기 포장재는 공기가 공간을 차지하는 성질을 이용해요"
 },
 {
  "t": 147.53,
  "end": 151.43,
  "section": "정리해요",
  "sub": "고체, 액체, 기체의 성질을 표로 비교해요"
 },
 {
  "t": 151.43,
  "end": 159.33,
  "section": "정리해요",
  "sub": "고체는 용기가 바뀌어도 모양과 부피가 변하지 않아요"
 },
 {
  "t": 159.33,
  "end": 165.83,
  "section": "정리해요",
  "sub": "셋은 성질이 다르지만, 모두 공간을 차지해요"
 },
 {
  "t": 165.83,
  "end": 170.33,
  "section": "마무리",
  "sub": "고체는 모양·부피가 그대로, 액체는 모양만 바뀌고, 기체는 공간을 차지하고 이동할 수 있어요"
 },
 {
  "t": 170.33,
  "end": 176.33,
  "section": "마무리",
  "sub": "다음 영상: 3학년 마인드맵 5 · 물질의 성질"
 }
]