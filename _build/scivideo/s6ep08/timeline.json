[
 {
  "t": 0.0,
  "end": 6.57,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 8화: 물체의 운동을 나타내기"
 },
 {
  "t": 6.57,
  "end": 17.07,
  "section": "궁금해요",
  "sub": "미끄럼틀을 타는 곰의 위치는 어떻게 바뀌었나요?"
 },
 {
  "t": 17.07,
  "end": 26.77,
  "section": "궁금해요",
  "sub": "미끄럼틀 위에서 미끄럼틀 아래로 바뀌었어요"
 },
 {
  "t": 26.77,
  "end": 33.67,
  "section": "활동해요",
  "sub": "분수를 기준으로 꽃의 위치를 말해 봐요"
 },
 {
  "t": 33.67,
  "end": 49.5,
  "section": "활동해요",
  "sub": "분수에서 어느 쪽으로 몇 칸 떨어져 있나요?"
 },
 {
  "t": 49.5,
  "end": 55.83,
  "section": "활동해요",
  "sub": "위치는 기준에서 방향과 떨어진 거리로 나타내요"
 },
 {
  "t": 55.83,
  "end": 65.8,
  "section": "활동해요",
  "sub": "꿀벌을 진달래꽃에서 유채꽃까지 움직여요"
 },
 {
  "t": 65.8,
  "end": 70.8,
  "section": "활동해요",
  "sub": "가장 짧은 길로 가면 몇 초 걸릴까요?"
 },
 {
  "t": 70.8,
  "end": 77.2,
  "section": "활동해요",
  "sub": "오른쪽으로 1칸, 위쪽으로 4칸 — 한 칸에 1초씩"
 },
 {
  "t": 77.2,
  "end": 88.53,
  "section": "활동해요",
  "sub": "꿀벌은 5초 동안 진달래꽃에서 유채꽃으로 이동했어요"
 },
 {
  "t": 88.53,
  "end": 96.43,
  "section": "정리해요",
  "sub": "기차·승강기·코딩 로봇의 운동을 나타내 봐요"
 },
 {
  "t": 96.43,
  "end": 100.8,
  "section": "정리해요",
  "sub": "기차는 1시간 동안 출발역에서 도착역으로"
 },
 {
  "t": 100.8,
  "end": 105.1,
  "section": "정리해요",
  "sub": "승강기는 15초 동안 1층에서 5층으로"
 },
 {
  "t": 105.1,
  "end": 109.77,
  "section": "정리해요",
  "sub": "코딩 로봇은 10초 동안 입구에서 출구로"
 },
 {
  "t": 109.77,
  "end": 114.47,
  "section": "정리해요",
  "sub": "물체의 운동을 표현할 때 꼭 들어가야 하는 것은?"
 },
 {
  "t": 114.47,
  "end": 125.77,
  "section": "정리해요",
  "sub": "걸린 시간, 처음 위치, 나중 위치가 꼭 들어가요"
 },
 {
  "t": 125.77,
  "end": 130.23,
  "section": "생각 바로잡기",
  "sub": "물체의 운동을 옳게 표현한 것은 어느 것일까요?"
 },
 {
  "t": 130.23,
  "end": 134.9,
  "section": "생각 바로잡기",
  "sub": "빠진 것이 무엇인지 찾아보세요"
 },
 {
  "t": 134.9,
  "end": 146.73,
  "section": "생각 바로잡기",
  "sub": "빠진 것이 있으면 운동을 바르게 나타낼 수 없어요"
 },
 {
  "t": 146.73,
  "end": 149.93,
  "section": "생각 바로잡기",
  "sub": "버스의 운동을 나타내 볼까요?"
 },
 {
  "t": 149.93,
  "end": 156.3,
  "section": "생각 바로잡기",
  "sub": "버스는 5분 동안 ㉮ 정류장에서 ㉯ 정류장으로 이동했어요"
 },
 {
  "t": 156.3,
  "end": 165.83,
  "section": "한눈에 쏙",
  "sub": "걸린 시간과 위치 변화로 운동을 표현해요"
 },
 {
  "t": 165.83,
  "end": 174.67,
  "section": "한눈에 쏙",
  "sub": "나의 운동도 이렇게 표현할 수 있어요"
 },
 {
  "t": 174.67,
  "end": 180.3,
  "section": "마무리",
  "sub": "물체의 운동은 걸린 시간과 처음 위치·나중 위치로 나타내요"
 },
 {
  "t": 180.3,
  "end": 187.97,
  "section": "마무리",
  "sub": "다음 영상: 6학년 9화 · 같은 시간 동안 이동한 거리로 빠르기 비교"
 }
]