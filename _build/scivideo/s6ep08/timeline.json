[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 8화: 물체의 운동을 나타내기"
 },
 {
  "t": 5.5,
  "end": 13.9,
  "section": "궁금해요",
  "sub": "미끄럼틀을 타는 곰의 위치는 어떻게 바뀌었나요?"
 },
 {
  "t": 13.9,
  "end": 23.17,
  "section": "궁금해요",
  "sub": "미끄럼틀 위에서 미끄럼틀 아래로 바뀌었어요"
 },
 {
  "t": 23.17,
  "end": 29.37,
  "section": "활동해요",
  "sub": "분수를 기준으로 꽃의 위치를 말해 봐요"
 },
 {
  "t": 29.37,
  "end": 41.23,
  "section": "활동해요",
  "sub": "분수에서 어느 쪽으로 몇 칸 떨어져 있나요?"
 },
 {
  "t": 41.23,
  "end": 47.8,
  "section": "활동해요",
  "sub": "위치는 기준에서 방향과 떨어진 거리로 나타내요"
 },
 {
  "t": 47.8,
  "end": 56.2,
  "section": "활동해요",
  "sub": "꿀벌을 진달래꽃에서 유채꽃까지 움직여요"
 },
 {
  "t": 56.2,
  "end": 61.2,
  "section": "활동해요",
  "sub": "가장 짧은 길로 가면 몇 초 걸릴까요?"
 },
 {
  "t": 61.2,
  "end": 66.43,
  "section": "활동해요",
  "sub": "오른쪽으로 1칸, 위쪽으로 4칸 — 한 칸에 1초씩"
 },
 {
  "t": 66.43,
  "end": 76.03,
  "section": "활동해요",
  "sub": "꿀벌은 5초 동안 진달래꽃에서 유채꽃으로 이동했어요"
 },
 {
  "t": 76.03,
  "end": 82.6,
  "section": "정리해요",
  "sub": "기차·승강기·코딩 로봇의 운동을 나타내 봐요"
 },
 {
  "t": 82.6,
  "end": 87.17,
  "section": "정리해요",
  "sub": "기차는 1시간 동안 출발역에서 도착역으로"
 },
 {
  "t": 87.17,
  "end": 91.57,
  "section": "정리해요",
  "sub": "승강기는 15초 동안 1층에서 5층으로"
 },
 {
  "t": 91.57,
  "end": 96.57,
  "section": "정리해요",
  "sub": "코딩 로봇은 10초 동안 입구에서 출구로"
 },
 {
  "t": 96.57,
  "end": 101.47,
  "section": "정리해요",
  "sub": "물체의 운동을 표현할 때 꼭 들어가야 하는 것은?"
 },
 {
  "t": 101.47,
  "end": 111.23,
  "section": "정리해요",
  "sub": "걸린 시간, 처음 위치, 나중 위치가 꼭 들어가요"
 },
 {
  "t": 111.23,
  "end": 115.8,
  "section": "생각 바로잡기",
  "sub": "물체의 운동을 옳게 표현한 것은 어느 것일까요?"
 },
 {
  "t": 115.8,
  "end": 119.8,
  "section": "생각 바로잡기",
  "sub": "빠진 것이 무엇인지 찾아보세요"
 },
 {
  "t": 119.8,
  "end": 130.63,
  "section": "생각 바로잡기",
  "sub": "빠진 것이 있으면 운동을 바르게 나타낼 수 없어요"
 },
 {
  "t": 130.63,
  "end": 134.03,
  "section": "생각 바로잡기",
  "sub": "버스의 운동을 나타내 볼까요?"
 },
 {
  "t": 134.03,
  "end": 140.47,
  "section": "생각 바로잡기",
  "sub": "버스는 5분 동안 ㉮ 정류장에서 ㉯ 정류장으로 이동했어요"
 },
 {
  "t": 140.47,
  "end": 149.53,
  "section": "한눈에 쏙",
  "sub": "걸린 시간과 위치 변화로 운동을 표현해요"
 },
 {
  "t": 149.53,
  "end": 158.03,
  "section": "한눈에 쏙",
  "sub": "나의 운동도 이렇게 표현할 수 있어요"
 },
 {
  "t": 158.03,
  "end": 162.53,
  "section": "마무리",
  "sub": "물체의 운동은 걸린 시간과 처음 위치·나중 위치로 나타내요"
 },
 {
  "t": 162.53,
  "end": 168.53,
  "section": "마무리",
  "sub": "다음 영상: 6학년 9화 · 같은 시간 동안 이동한 거리로 빠르기 비교"
 }
]