[
 {
  "t": 0.0,
  "end": 6.13,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 35화: 미래 사회의 문제"
 },
 {
  "t": 6.13,
  "end": 11.67,
  "section": "궁금해요",
  "sub": "10년 전과 현재의 식당은 무엇이 달라졌을까요?"
 },
 {
  "t": 11.67,
  "end": 19.27,
  "section": "궁금해요",
  "sub": "10년 전: 종업원에게 주문하고, 종업원이 음식을 날라 주었어요"
 },
 {
  "t": 19.27,
  "end": 26.23,
  "section": "궁금해요",
  "sub": "현재: 키오스크로 주문·결제, 서빙 로봇이 음식 전달"
 },
 {
  "t": 26.23,
  "end": 36.2,
  "section": "궁금해요",
  "sub": "변화의 까닭은 과학 기술의 발달 — 현재로 미래를 예상해 봐요"
 },
 {
  "t": 36.2,
  "end": 43.8,
  "section": "조사해요",
  "sub": "(가) 출생아 수가 줄어들고 있어요"
 },
 {
  "t": 43.8,
  "end": 48.4,
  "section": "조사해요",
  "sub": "(나) 이산화 탄소 배출량이 증가하고 있어요"
 },
 {
  "t": 48.4,
  "end": 54.6,
  "section": "조사해요",
  "sub": "(다) 과학 기술이 빠른 속도로 발전하고 있어요"
 },
 {
  "t": 54.6,
  "end": 58.63,
  "section": "더 알아보기",
  "sub": "우리나라 인구 구조는 어떻게 변하고 있을까요?"
 },
 {
  "t": 58.63,
  "end": 68.6,
  "section": "더 알아보기",
  "sub": "만 65세 이상: 2.9%(1960년) → 46.4%(2070년 예상), 점점 늘어나요"
 },
 {
  "t": 68.6,
  "end": 77.7,
  "section": "더 알아보기",
  "sub": "만 15~64세는 2020년 뒤 줄어요 → 노동력이 부족해질 수 있어요"
 },
 {
  "t": 77.7,
  "end": 82.5,
  "section": "조사해요",
  "sub": "현재 사회의 모습이 계속되면 미래에는 어떤 문제가 생길까요?"
 },
 {
  "t": 82.5,
  "end": 87.5,
  "section": "조사해요",
  "sub": "이대로 계속되면 어떤 문제가 생길까요?"
 },
 {
  "t": 87.5,
  "end": 93.93,
  "section": "조사해요",
  "sub": "(가)가 계속되면 → 노동력 부족: 인구 문제"
 },
 {
  "t": 93.93,
  "end": 104.53,
  "section": "조사해요",
  "sub": "(나)가 계속되면 → 기후 위기: 환경 문제"
 },
 {
  "t": 104.53,
  "end": 114.53,
  "section": "조사해요",
  "sub": "(다)가 계속되면 → 과학 기술의 범죄 악용: 윤리 문제"
 },
 {
  "t": 114.53,
  "end": 119.6,
  "section": "토의해요",
  "sub": "문제 하나를 골라 우리에게 미치는 영향을 이어 봐요"
 },
 {
  "t": 119.6,
  "end": 128.3,
  "section": "토의해요",
  "sub": "이산화 탄소 증가 → 기후 위기 → 기후 난민·자연재해"
 },
 {
  "t": 128.3,
  "end": 134.07,
  "section": "토의해요",
  "sub": "하나의 문제가 또 다른 문제를 연쇄적으로 일으킬 수 있어요"
 },
 {
  "t": 134.07,
  "end": 140.5,
  "section": "한눈에 쏙",
  "sub": "미래 사회에는 인구·환경·윤리 문제 등이 일어날 수 있어요"
 },
 {
  "t": 140.5,
  "end": 154.47,
  "section": "한눈에 쏙",
  "sub": "전 세계적으로는 인구 증가 → 자원과 에너지 부족"
 },
 {
  "t": 154.47,
  "end": 158.13,
