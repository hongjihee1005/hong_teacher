 },
 {
  "t": 50.97,
  "end": 55.97,
  "section": "실험해요 ②",
  "sub": "어느 용액의 색깔이 변할까요?"
 },
 {
  "t": 55.97,
  "end": 61.87,
  "section": "실험해요 ②",
  "sub": "빨랫비누 물·석회수·수산화 나트륨만 붉은색으로 변해요"
