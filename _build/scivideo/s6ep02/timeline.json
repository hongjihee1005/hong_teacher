 {
  "t": 68.47,
  "end": 73.03,
  "section": "정리해요",
  "sub": "산성 용액과 염기성 용액"
 },
 {
  "t": 73.03,
  "end": 80.27,
  "section": "정리해요",
  "sub": "산성 용액: 푸른색 리트머스 → 붉은색, 페놀프탈레인 → 변화 없음"
 },
 {
  "t": 80.27,
  "end": 88.7,
