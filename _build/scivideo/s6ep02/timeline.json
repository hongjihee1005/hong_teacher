[
 {
  "t": 0.0,
  "end": 6.03,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 2화: 지시약으로 분류하기"
 },
 {
  "t": 6.03,
  "end": 10.1,
  "section": "궁금해요",
  "sub": "색깔이 없고 투명한 용액은 어떻게 분류할까요?"
 },
 {
  "t": 10.1,
  "end": 15.57,
  "section": "궁금해요",
  "sub": "용액의 성질에 따라 색깔이 변하는 물질, 지시약"
 },
 {
  "t": 15.57,
  "end": 19.33,
  "section": "실험해요 ①",
  "sub": "홈판의 각 홈에 용액을 3분의 1 정도씩 넣어요"
 },
 {
  "t": 19.33,
  "end": 24.03,
  "section": "실험해요 ①",
  "sub": "푸른색과 붉은색 리트머스 시험지를 넣어요"
 },
 {
  "t": 24.03,
  "end": 29.03,
  "section": "실험해요 ①",
  "sub": "시험지 색깔은 어떻게 변할까요?"
 },
 {
  "t": 29.03,
  "end": 35.5,
  "section": "실험해요 ①",
  "sub": "식초·레몬즙·묽은 염산: 푸른색 리트머스 → 붉은색"
 },
 {
  "t": 35.5,
  "end": 45.97,
  "section": "실험해요 ①",
  "sub": "빨랫비누 물·석회수·수산화 나트륨: 붉은색 리트머스 → 푸른색"
 },
 {
  "t": 45.97,
  "end": 51.33,
  "section": "실험해요 ②",
  "sub": "색깔이 없는 페놀프탈레인 용액을 한두 방울씩"
 },
 {
  "t": 51.33,
  "end": 56.33,
  "section": "실험해요 ②",
  "sub": "어느 용액의 색깔이 변할까요?"
 },
 {
  "t": 56.33,
  "end": 63.2,
  "section": "실험해요 ②",
  "sub": "빨랫비누 물·석회수·수산화 나트륨만 붉은색으로 변해요"
 },
 {
  "t": 63.2,
  "end": 70.43,
  "section": "실험해요 ②",
  "sub": "리트머스로 나눈 무리와 같은 무리로 나뉘어요"
 },
 {
  "t": 70.43,
  "end": 74.97,
  "section": "정리해요",
  "sub": "산성 용액과 염기성 용액"
 },
 {
  "t": 74.97,
  "end": 82.47,
  "section": "정리해요",
  "sub": "산성 용액: 푸른색 리트머스 → 붉은색, 페놀프탈레인 → 변화 없음"
 },
 {
  "t": 82.47,
  "end": 91.23,
  "section": "정리해요",
  "sub": "염기성 용액: 붉은색 리트머스 → 푸른색, 페놀프탈레인 → 붉은색"
 },
 {
  "t": 91.23,
  "end": 102.8,
  "section": "붉은 양배추 지시약",
  "sub": "붉은 양배추 용액도 지시약으로 쓸 수 있어요"
 },
 {
  "t": 102.8,
  "end": 106.87,
  "section": "실험해요 ③",
  "sub": "붉은 양배추 용액을 다섯 방울씩 떨어뜨려요"
 },
 {
  "t": 106.87,
  "end": 113.27,
  "section": "실험해요 ③",
  "sub": "어떤 색깔로 변할까요?"
 },
 {
  "t": 113.27,
  "end": 117.8,
  "section": "실험해요 ③",
  "sub": "식초·레몬즙·묽은 염산은 붉은색"
 },
 {
  "t": 117.8,
  "end": 125.4,
  "section": "실험해요 ③",
  "sub": "빨랫비누 물·석회수는 푸른색, 수산화 나트륨은 노란색"
 },
 {
  "t": 125.4,
  "end": 136.63,
  "section": "실험해요 ③",
  "sub": "산성은 붉은색 계열, 염기성은 푸른색이나 노란색 계열"
 },
 {
  "t": 136.63,
  "end": 144.3,
  "section": "실험해요 ③",
  "sub": "리트머스·페놀프탈레인으로 분류한 결과와 같아요"
 },
 {
  "t": 144.3,
  "end": 149.13,
  "section": "한눈에 쏙",
  "sub": "산성 용액에 푸른색 리트머스 시험지를 넣으면 붉은색"
 },
 {
  "t": 149.13,
  "end": 155.7,
  "section": "한눈에 쏙",
  "sub": "겉보기로 어려운 용액도 색깔 변화로 분류해요"
 },
 {
  "t": 155.7,
  "end": 160.61,
  "section": "마무리",
  "sub": "지시약의 색깔 변화로 용액을 산성과 염기성 용액으로 분류해요"
 },
 {
  "t": 160.61,
  "end": 167.97,
  "section": "마무리",
  "sub": "다음 영상: 6학년 3화 · 산성 용액과 염기성 용액의 성질"
 }
