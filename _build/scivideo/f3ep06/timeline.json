[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「처음 배우는 과학」 3학년 6화: 우리 주변·땅속에 사는 동물"
 },
 {
  "t": 5.47,
  "end": 9.2,
  "section": "궁금해요",
  "sub": "학교나 집 주변에서 어떤 동물을 보았나요?"
 },
 {
  "t": 9.2,
  "end": 13.2,
  "section": "궁금해요",
  "sub": "내가 본 동물을 말해 봐요"
 },
 {
  "t": 13.2,
  "end": 17.93,
  "section": "궁금해요",
  "sub": "달팽이처럼 땅에 사는 동물이 있고"
 },
 {
  "t": 17.93,
  "end": 22.47,
  "section": "궁금해요",
  "sub": "나비처럼 하늘을 날아다니는 동물도 있어요"
 },
 {
  "t": 22.47,
  "end": 27.53,
  "section": "궁금해요",
  "sub": "우리 주변에는 다양한 동물이 살고 있어요"
 },
 {
  "t": 27.53,
  "end": 31.6,
  "section": "조사해요",
  "sub": "학교에 사는 동물을 조사하러 가요"
 },
 {
  "t": 31.6,
  "end": 38.47,
  "section": "조사해요",
  "sub": "돋보기, 동물도감을 챙기고 긴소매·긴바지를 입어요"
 },
 {
  "t": 38.47,
  "end": 45.0,
  "section": "조사해요",
  "sub": "동물은 채집하지 않고 사진이나 영상으로 기록해요"
 },
 {
  "t": 45.0,
  "end": 52.33,
  "section": "조사해요",
  "sub": "동물을 함부로 만지지 않아요"
 },
 {
  "t": 52.33,
  "end": 59.2,
  "section": "조사해요",
  "sub": "생명을 소중히 여기는 마음으로 조사해요"
 },
 {
  "t": 59.2,
  "end": 61.4,
  "section": "생각 바로잡기",
  "sub": "동물은 모두 움직일까요?"
 },
 {
  "t": 61.4,
  "end": 68.93,
  "section": "생각 바로잡기",
  "sub": "아니에요. 한곳에 붙어서 사는 동물도 있어요"
 },
 {
  "t": 68.93,
  "end": 77.33,
  "section": "새 낱말",
  "sub": "땅에서 동물이 파 놓은 구멍을 볼 때가 있어요"
 },
 {
  "t": 77.33,
  "end": 80.73,
  "section": "새 낱말",
  "sub": "매미 애벌레가 벗은 허물이에요"
 },
 {
  "t": 80.73,
  "end": 89.47,
  "section": "새 낱말",
  "sub": "허물: 매미 애벌레 등이 자라면서 벗는 껍질"
 },
 {
  "t": 89.47,
  "end": 92.67,
  "section": "관찰해요",
  "sub": "돋보기로 허물을 자세히 관찰해요"
 },
 {
  "t": 92.67,
  "end": 96.53,
  "section": "관찰해요",
  "sub": "머리에는 더듬이가 있어요"
 },
 {
  "t": 96.53,
  "end": 102.07,
  "section": "관찰해요",
  "sub": "다리는 몇 개일까요? 세어 봐요"
 },
 {
  "t": 102.07,
  "end": 105.6,
  "section": "관찰해요",
  "sub": "다리는 세 쌍, 모두 여섯 개예요"
 },
 {
  "t": 105.6,
  "end": 110.6,
  "section": "관찰해요",
  "sub": "매미 애벌레는 무엇으로 땅을 팔까요?"
 },
 {
  "t": 110.6,
  "end": 113.8,
  "section": "관찰해요",
  "sub": "앞다리가 뾰족해요"
 },
 {
  "t": 113.8,
  "end": 117.33,
  "section": "관찰해요",
  "sub": "뾰족한 앞다리로 땅을 파요"
 },
 {
  "t": 117.33,
  "end": 124.73,
  "section": "관찰해요",
  "sub": "허물은 쉽게 부서져요 — 힘을 주어 만지지 않아요"
 },
 {
  "t": 124.73,
  "end": 130.8,
  "section": "조사해요",
  "sub": "땅속에 사는 동물을 조사해요"
 },
 {
  "t": 130.8,
  "end": 136.4,
  "section": "조사해요",
  "sub": "누가 어떻게 땅을 팔까요?"
 },
 {
  "t": 136.4,
  "end": 138.6,
  "section": "조사해요",
  "sub": "땅속에 사는 두더지예요"
 },
 {
  "t": 138.6,
  "end": 145.13,
  "section": "조사해요",
  "sub": "앞다리가 삽처럼 넓적하고 두꺼운 발톱이 있어요"
 },
 {
  "t": 145.13,
  "end": 152.6,
  "section": "조사해요",
  "sub": "이 앞다리로 굴을 파서 땅속을 이동해요"
 },
 {
  "t": 152.6,
  "end": 155.0,
  "section": "조사해요",
  "sub": "땅속에 사는 땅강아지예요"
 },
 {
  "t": 155.0,
  "end": 160.2,
  "section": "조사해요",
  "sub": "앞다리가 삽 모양으로 넓고 두꺼워요"
 },
 {
  "t": 160.2,
  "end": 165.2,
  "section": "조사해요",
  "sub": "넓적한 앞다리로 땅을 파며 살아요"
 },
 {
  "t": 165.2,
  "end": 169.07,
  "section": "조사해요",
  "sub": "땅 위를 기어다니는 개미예요"
 },
 {
  "t": 169.07,
  "end": 174.27,
  "section": "조사해요",
  "sub": "머리에 큰턱이 있어요"
 },
 {
  "t": 174.27,
  "end": 178.6,
  "section": "조사해요",
  "sub": "큰턱으로 땅을 파서 집을 지어요"
 },
 {
  "t": 178.6,
  "end": 182.13,
  "section": "조사해요",
  "sub": "지렁이는 몸이 가늘고 길며 다리가 없어요"
 },
 {
  "t": 182.13,
  "end": 186.2,
  "section": "조사해요",
  "sub": "몸의 앞부분을 늘여 흙을 밀어 내요"
 },
 {
  "t": 186.2,
  "end": 191.13,
  "section": "조사해요",
  "sub": "그다음 뒷부분을 끌어당겨 이동해요"
 },
 {
  "t": 191.13,
  "end": 199.33,
  "section": "정리해요",
  "sub": "땅속 동물은 땅속에서 살기에 알맞은 생김새를 가졌어요"
 },
 {
  "t": 199.33,
  "end": 205.67,
  "section": "정리해요",
  "sub": "우리 주변에는 다양한 동물이 살아요"
 },
 {
  "t": 205.67,
  "end": 210.87,
  "section": "정리해요",
  "sub": "땅강아지가 땅속에서 잘 사는 까닭은?"
 },
 {
  "t": 210.87,
  "end": 215.87,
  "section": "정리해요",
  "sub": "앞다리 모양을 살펴봐요"
 },
 {
  "t": 215.87,
  "end": 222.13,
  "section": "정리해요",
  "sub": "넓적한 앞다리로 땅을 잘 팔 수 있기 때문이에요"
 },
 {
  "t": 222.13,
  "end": 228.2,
  "section": "확인해요",
  "sub": "동물을 관찰할 때 지켜야 할 것으로 옳지 않은 것은?"
 },
 {
  "t": 228.2,
  "end": 234.2,
  "section": "확인해요",
  "sub": "옳지 않은 것은 몇 번일까요?"
 },
 {
  "t": 234.2,
  "end": 241.33,
  "section": "확인해요",
  "sub": "정답은 ④ — 동물은 채집하지 않아요"
 },
 {
  "t": 241.33,
  "end": 247.4,
  "section": "확인해요",
  "sub": "땅속에 사는 동물 ㈎와 ㈏의 이름과 공통 특징은?"
 },
 {
  "t": 247.4,
  "end": 252.4,
  "section": "확인해요",
  "sub": "㈎·㈏의 이름과 공통 특징은?"
 },
 {
  "t": 252.4,
  "end": 255.27,
  "section": "확인해요",
  "sub": "㈎는 두더지, ㈏는 땅강아지예요"
 },
 {
  "t": 255.27,
  "end": 259.6,
  "section": "확인해요",
  "sub": "둘 다 앞다리를 이용해 땅을 팔 수 있어요"
 },
 {
  "t": 259.6,
  "end": 264.1,
  "section": "마무리",
  "sub": "땅속에 사는 동물은 앞다리로 땅을 파는 등 땅속에서 살기에 알맞은 생김새와 생활 방식을 가져요"
 },
 {
  "t": 264.1,
  "end": 270.07,
  "section": "마무리",
  "sub": "다음 영상: 처음 배우는 과학 3학년 7화 · 물에 사는 동물과 물갈퀴"
 }
]