[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 21화: 지구의 자전"
 },
 {
  "t": 5.47,
  "end": 8.53,
  "section": "궁금해요",
  "sub": "팽이는 무엇을 중심으로 돌고 있나요?"
 },
 {
  "t": 8.53,
  "end": 12.4,
  "section": "궁금해요",
  "sub": "팽이는 가운데 축을 중심으로 제자리에서 돌아요"
 },
 {
  "t": 12.4,
  "end": 16.6,
  "section": "궁금해요",
  "sub": "팽이처럼 제자리에서 회전하는 것은?"
 },
 {
  "t": 16.6,
  "end": 24.27,
  "section": "궁금해요",
  "sub": "발레리나·놀이 기구 ○, 미끄럼틀은 ×"
 },
 {
  "t": 24.27,
  "end": 33.67,
  "section": "궁금해요",
  "sub": "천체가 스스로 고정된 축을 중심으로 회전 = 자전"
 },
 {
  "t": 33.67,
  "end": 40.2,
  "section": "실험 준비",
  "sub": "붙임쪽지에 '지구', '별', '동', '서'를 쓰고 역할을 정해요"
 },
 {
  "t": 40.2,
  "end": 46.6,
  "section": "실험 준비",
  "sub": "지구 역할의 왼손에 붙일 쪽지는 무엇일까요?"
 },
 {
  "t": 46.6,
  "end": 53.33,
  "section": "실험 준비",
  "sub": "왼손에 동, 오른손에 서"
 },
 {
  "t": 53.33,
  "end": 60.2,
  "section": "역할놀이",
  "sub": "제자리에서 서쪽에서 동쪽(시계 반대 방향)으로 천천히 돌아요"
 },
 {
  "t": 60.2,
  "end": 67.2,
  "section": "역할놀이",
  "sub": "처음에는 전등이 왼손(동) 쪽에 보여요"
 },
 {
  "t": 67.2,
  "end": 71.6,
  "section": "역할놀이",
  "sub": "계속 돌면 별 역할이 보이기 시작해요"
 },
 {
  "t": 71.6,
  "end": 76.6,
  "section": "역할놀이",
  "sub": "전등과 별은 어느 쪽에서 어느 쪽으로?"
 },
 {
  "t": 76.6,
  "end": 86.2,
  "section": "역할놀이",
  "sub": "전등과 별 모두 동쪽 → 남쪽 → 서쪽으로 달라졌어요"
 },
 {
  "t": 86.2,
  "end": 93.6,
  "section": "결과 정리",
  "sub": "지구 역할은 서→동, 전등과 별은 동→서"
 },
 {
  "t": 93.6,
  "end": 105.2,
  "section": "결과 정리",
  "sub": "지구가 자전하기 때문이지, 태양과 별이 스스로 움직여서가 아니에요"
 },
 {
  "t": 105.2,
  "end": 112.4,
  "section": "지구의 자전",
  "sub": "북극과 남극을 이은 가상의 직선 = 자전축"
 },
 {
  "t": 112.4,
  "end": 120.27,
  "section": "지구의 자전",
  "sub": "지구는 하루에 한 바퀴씩 서쪽에서 동쪽으로 회전해요"
 },
 {
  "t": 120.27,
  "end": 126.2,
  "section": "지구의 자전",
  "sub": "북극 위에서 내려다보면 시계 반대 방향으로 돌아요"
 },
 {
  "t": 126.2,
  "end": 128.6,
  "section": "정리해요",
  "sub": "낱말과 뜻을 이어요"
 },
 {
  "t": 128.6,
  "end": 132.67,
  "section": "정리해요",
  "sub": "자전 방향을 바르게 말한 친구는?"
 },
 {
  "t": 132.67,
  "end": 142.07,
  "section": "정리해요",
  "sub": "방위로 말해요 — 왼쪽·오른쪽은 바라보는 방향에 따라 달라져요"
 },
 {
  "t": 142.07,
  "end": 148.93,
  "section": "생각해요",
  "sub": "만약 지구가 동쪽에서 서쪽으로 자전한다면?"
 },
 {
  "t": 148.93,
  "end": 159.67,
  "section": "생각해요",
  "sub": "태양과 별은 서쪽에서 동쪽으로 위치가 달라질 거예요"
 },
 {
  "t": 159.67,
  "end": 168.6,
  "section": "한눈에 쏙",
  "sub": "지구의 자전"
 },
 {
  "t": 168.6,
  "end": 174.47,
  "section": "확인해요",
  "sub": "옳으면 ○, 옳지 않으면 ×"
 },
 {
  "t": 174.47,
  "end": 179.47,
  "section": "확인해요",
  "sub": "○일까요, ×일까요?"
 },
 {
  "t": 179.47,
  "end": 186.13,
  "section": "확인해요",
  "sub": "⑴ × — 지구는 서쪽에서 동쪽으로 자전해요, ⑵·⑶ ○"
 },
 {
  "t": 186.13,
  "end": 190.63,
  "section": "마무리",
  "sub": "지구는 자전축을 중심으로 하루에 한 바퀴씩 서쪽에서 동쪽으로 자전해요"
 },
 {
  "t": 190.63,
  "end": 196.6,
  "section": "마무리",
  "sub": "다음 영상: 6학년 22화 · 낮과 밤이 생기는 까닭"
 }
]