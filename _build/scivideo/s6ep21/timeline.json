[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 21화: 지구의 자전"
 },
 {
  "t": 5.5,
  "end": 8.57,
  "section": "궁금해요",
  "sub": "팽이는 무엇을 중심으로 돌고 있나요?"
 },
 {
  "t": 8.57,
  "end": 12.47,
  "section": "궁금해요",
  "sub": "팽이는 가운데 축을 중심으로 제자리에서 돌아요"
 },
 {
  "t": 12.47,
  "end": 16.7,
  "section": "궁금해요",
  "sub": "팽이처럼 제자리에서 회전하는 것은?"
 },
 {
  "t": 16.7,
  "end": 24.33,
  "section": "궁금해요",
  "sub": "발레리나·놀이 기구 ○, 미끄럼틀은 ×"
 },
 {
  "t": 24.33,
  "end": 33.73,
  "section": "궁금해요",
  "sub": "천체가 스스로 고정된 축을 중심으로 회전 = 자전"
 },
 {
  "t": 33.73,
  "end": 38.3,
  "section": "실험 준비",
  "sub": "붙임쪽지에 '지구', '별', '동', '서'를 쓰고 역할을 정해요"
 },
 {
  "t": 38.3,
  "end": 43.87,
  "section": "실험 준비",
  "sub": "지구 역할의 왼손에 붙일 쪽지는 무엇일까요?"
 },
 {
  "t": 43.87,
  "end": 50.47,
  "section": "실험 준비",
  "sub": "왼손에 동, 오른손에 서"
 },
 {
  "t": 50.47,
  "end": 56.53,
  "section": "역할놀이",
  "sub": "제자리에서 서쪽에서 동쪽(시계 반대 방향)으로 천천히 돌아요"
 },
 {
  "t": 56.53,
  "end": 60.6,
  "section": "역할놀이",
  "sub": "처음에는 전등이 왼손(동) 쪽에 보여요"
 },
 {
  "t": 60.6,
  "end": 64.07,
  "section": "역할놀이",
  "sub": "계속 돌면 별 역할이 보이기 시작해요"
 },
 {
  "t": 64.07,
  "end": 69.07,
  "section": "역할놀이",
  "sub": "전등과 별은 어떻게 달라졌나요?"
 },
 {
  "t": 69.07,
  "end": 75.5,
  "section": "역할놀이",
  "sub": "전등과 별 모두 동쪽 → 남쪽 → 서쪽으로 달라졌어요"
 },
 {
  "t": 75.5,
  "end": 81.73,
  "section": "결과 정리",
  "sub": "지구 역할은 서→동, 전등과 별은 동→서"
 },
 {
  "t": 81.73,
  "end": 89.83,
  "section": "결과 정리",
  "sub": "지구가 자전하기 때문이지, 태양과 별이 스스로 움직여서가 아니에요"
 },
 {
  "t": 89.83,
  "end": 97.07,
  "section": "지구의 자전",
  "sub": "북극과 남극을 이은 가상의 직선 = 자전축"
 },
 {
  "t": 97.07,
  "end": 102.93,
  "section": "지구의 자전",
  "sub": "지구는 하루에 한 바퀴씩 서쪽에서 동쪽으로 회전해요"
 },
 {
  "t": 102.93,
  "end": 108.87,
  "section": "지구의 자전",
  "sub": "북극 위에서 내려다보면 시계 반대 방향으로 돌아요"
 },
 {
  "t": 108.87,
  "end": 110.6,
  "section": "정리해요",
  "sub": "낱말과 뜻을 이어요"
 },
 {
  "t": 110.6,
  "end": 113.33,
  "section": "정리해요",
  "sub": "자전 방향을 바르게 말한 친구는?"
 },
 {
  "t": 113.33,
  "end": 119.77,
  "section": "정리해요",
  "sub": "방위로 말해요 — 왼쪽·오른쪽은 바라보는 방향에 따라 달라져요"
 },
 {
  "t": 119.77,
  "end": 124.67,
  "section": "생각해요",
  "sub": "만약 지구가 동쪽에서 서쪽으로 자전한다면?"
 },
 {
  "t": 124.67,
  "end": 133.43,
  "section": "생각해요",
  "sub": "태양과 별은 서쪽에서 동쪽으로 위치가 달라질 거예요"
 },
 {
  "t": 133.43,
  "end": 142.37,
  "section": "한눈에 쏙",
  "sub": "지구의 자전"
 },
 {
  "t": 142.37,
  "end": 146.27,
  "section": "확인해요",
  "sub": "옳으면 ○, 옳지 않으면 ×"
 },
 {
  "t": 146.27,
  "end": 151.27,
  "section": "확인해요",
  "sub": "○일까요, ×일까요?"
 },
 {
  "t": 151.27,
  "end": 157.93,
  "section": "확인해요",
  "sub": "⑴ × — 지구는 서쪽에서 동쪽으로 자전해요, ⑵·⑶ ○"
 },
 {
  "t": 157.93,
  "end": 162.43,
  "section": "마무리",
  "sub": "지구는 자전축을 중심으로 하루에 한 바퀴씩 서쪽에서 동쪽으로 자전해요"
 },
 {
  "t": 162.43,
  "end": 168.43,
  "section": "마무리",
  "sub": "다음 영상: 6학년 22화 · 낮과 밤이 생기는 까닭"
 }
]