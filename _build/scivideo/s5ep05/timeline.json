[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 5화: 화석은 어떻게 만들어질까?"
 },
 {
  "t": 5.47,
  "end": 9.33,
  "section": "궁금해요",
  "sub": "기념 손 찍기는 어떻게 만들까요?"
 },
 {
  "t": 9.33,
  "end": 17.07,
  "section": "궁금해요",
  "sub": "반죽을 손으로 눌러 생긴 자국을 굳혀요"
 },
 {
  "t": 17.07,
  "end": 21.8,
  "section": "실험해요",
  "sub": "화석 모형을 만들어 봐요"
 },
 {
  "t": 21.8,
  "end": 25.87,
  "section": "실험해요",
  "sub": "① 비닐봉지를 펴고 찰흙을 평평하게 넣어요"
 },
 {
  "t": 25.87,
  "end": 29.27,
  "section": "실험해요",
  "sub": "② 조개껍데기를 눌렀다가 떼어 내요"
 },
 {
  "t": 29.27,
  "end": 32.27,
  "section": "실험해요",
  "sub": "조개껍데기를 떼어 내는 까닭은 무엇일까요?"
 },
 {
  "t": 32.27,
  "end": 37.27,
  "section": "실험해요",
  "sub": "조개껍데기를 떼어 내는 까닭은?"
 },
 {
  "t": 37.27,
  "end": 43.33,
  "section": "실험해요",
  "sub": "자연에서는 오랜 시간이 지나면 껍데기가 없어지고 흔적이 남아요"
 },
 {
  "t": 43.33,
  "end": 47.0,
  "section": "실험해요",
  "sub": "③ 자국이 모두 덮이도록 물을 부어요"
 },
 {
  "t": 47.0,
  "end": 53.0,
  "section": "실험해요",
  "sub": "④ 물 표면이 보이지 않을 정도로 석고 가루를 넣어요"
 },
 {
  "t": 53.0,
  "end": 56.67,
  "section": "실험해요",
  "sub": "석고 가루는 실제 자연에서 무엇을 나타낼까요?"
 },
 {
  "t": 56.67,
  "end": 61.67,
  "section": "실험해요",
  "sub": "석고 가루는 무엇을 나타낼까요?"
 },
 {
  "t": 61.67,
  "end": 65.53,
  "section": "실험해요",
  "sub": "석고 가루는 물에 의해 운반된 퇴적물을 나타내요"
 },
 {
  "t": 65.53,
  "end": 71.73,
  "section": "실험해요",
  "sub": "⑤ 석고가 굳으면 비닐봉지째 들어 올려 꺼내요"
 },
 {
  "t": 71.73,
  "end": 81.47,
  "section": "실험해요",
  "sub": "⑥ 찰흙에는 오목한 자국, 석고는 볼록한 조개 모양이에요"
 },
 {
  "t": 81.47,
  "end": 87.87,
  "section": "실험해요",
  "sub": "찰흙의 자국과 석고 조개 모양은 둘 다 화석 모형이에요"
 },
 {
  "t": 87.87,
  "end": 93.4,
  "section": "모형 ↔ 실제",
  "sub": "화석 모형으로 실제 화석이 만들어지는 과정을 추리해요"
 },
 {
  "t": 93.4,
  "end": 97.93,
  "section": "모형 ↔ 실제",
  "sub": "찰흙의 자국 → 무른 땅에 남은 생물의 흔적"
 },
 {
  "t": 97.93,
  "end": 103.33,
  "section": "모형 ↔ 실제",
  "sub": "물과 석고 가루 → 쌓이는 퇴적물"
 },
 {
  "t": 103.33,
  "end": 108.4,
  "section": "모형 ↔ 실제",
  "sub": "꺼내기 → 화석이 있는 지층이 발견됨"
 },
 {
  "t": 108.4,
  "end": 114.87,
  "section": "모형 ↔ 실제",
  "sub": "자국과 석고 조개 → 화석"
 },
 {
  "t": 114.87,
  "end": 121.07,
  "section": "모형 ↔ 실제",
  "sub": "모형과 실제 화석은 생김새가 비슷해요"
 },
 {
  "t": 121.07,
  "end": 131.0,
  "section": "모형 ↔ 실제",
  "sub": "실제 화석은 자연에서 오랜 시간에 걸쳐 만들어져요"
 },
 {
  "t": 131.0,
  "end": 137.73,
  "section": "만들어지는 과정",
  "sub": "생물의 몸체나 흔적이 바다나 호수에 가라앉아요"
 },
 {
  "t": 137.73,
  "end": 140.47,
  "section": "만들어지는 과정",
  "sub": "그 위로 퇴적물이 빠르게 쌓여요"
 },
 {
  "t": 140.47,
  "end": 146.87,
  "section": "만들어지는 과정",
  "sub": "지층이 만들어지고, 지층 속 생물은 화석이 돼요"
 },
 {
  "t": 146.87,
  "end": 149.93,
  "section": "만들어지는 과정",
  "sub": "물 밖으로 드러난 지층이 점점 깎여요"
 },
 {
  "t": 149.93,
  "end": 154.33,
  "section": "만들어지는 과정",
  "sub": "지층이 더 깎이면서 화석이 발견돼요"
 },
 {
  "t": 154.33,
  "end": 160.4,
  "section": "만들어지는 과정",
  "sub": "화석이 발견되기까지는 오랜 시간이 걸려요"
 },
 {
  "t": 160.4,
  "end": 163.93,
  "section": "생각+",
  "sub": "어떤 생물이 화석으로 만들어지기 쉬울까요?"
 },
 {
  "t": 163.93,
  "end": 168.93,
