  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 5학년 5화: 화석은 어떻게 만들어질까?"
 },
 {
  "t": 5.5,
  "end": 8.23,
  "section": "궁금해요",
  "sub": "기념 손 찍기는 어떻게 만들까요?"
 },
 {
  "t": 8.23,
  "end": 16.0,
  "section": "궁금해요",
  "sub": "반죽을 손으로 눌러 생긴 자국을 굳혀요"
 },
 {
  "t": 16.0,
  "end": 20.7,
  "section": "실험해요",
  "sub": "화석 모형을 만들어 봐요"
 },
 {
  "t": 20.7,
  "end": 24.73,
  "section": "실험해요",
  "sub": "① 비닐봉지를 펴고 찰흙을 평평하게 넣어요"
 },
 {
  "t": 24.73,
  "end": 28.1,
  "section": "실험해요",
  "sub": "② 조개껍데기를 눌렀다가 떼어 내요"
 },
 {
  "t": 28.1,
  "end": 33.1,
  "section": "실험해요",
  "sub": "조개껍데기를 떼어 내는 까닭은?"
 },
 {
  "t": 33.1,
  "end": 39.17,
  "section": "실험해요",
  "sub": "자연에서는 오랜 시간이 지나면 껍데기가 없어지고 흔적이 남아요"
 },
 {
  "t": 39.17,
  "end": 42.9,
  "section": "실험해요",
  "sub": "③ 자국이 모두 덮이도록 물을 부어요"
 },
 {
  "t": 42.9,
  "end": 48.97,
  "section": "실험해요",
  "sub": "④ 물 표면이 보이지 않을 정도로 석고 가루를 넣어요"
 },
 {
  "t": 48.97,
  "end": 53.97,
