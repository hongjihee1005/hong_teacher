  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 4학년 13화: 화강암과 현무암"
 },
 {
  "t": 6.2,
  "end": 12.4,
  "section": "궁금해요",
  "sub": "제주도에서 많이 볼 수 있는 돌하르방의 색깔은 어떠한가요?"
 },
 {
  "t": 12.4,
  "end": 19.3,
  "section": "궁금해요",
  "sub": "어두운 회색이나 검은색이고, 작은 구멍도 보여요"
 },
 {
  "t": 19.3,
  "end": 28.13,
  "section": "궁금해요",
  "sub": "마그마가 식어 만들어진 암석을 화성암이라고 해요"
 },
 {
  "t": 28.13,
  "end": 35.83,
  "section": "관찰해요",
  "sub": "흰 종이 위에 암석 네 개를 놓고 관찰해요"
 },
 {
  "t": 35.83,
  "end": 45.57,
  "section": "관찰해요",
  "sub": "맨눈으로 보면 색깔이 달라요"
 },
 {
  "t": 45.57,
  "end": 50.57,
  "section": "관찰해요",
  "sub": "알갱이의 크기는 어떨까요?"
 },
 {
  "t": 50.57,
  "end": 54.4,
  "section": "관찰해요",
  "sub": "디지털 현미경으로 알갱이를 자세히 봐요"
 },
 {
  "t": 54.4,
  "end": 60.13,
  "section": "관찰해요",
  "sub": "암석 ①: 알갱이가 크고, 검은색 알갱이가 군데군데 있어요"
 },
 {
  "t": 60.13,
  "end": 67.03,
  "section": "관찰해요",
  "sub": "암석 ②: 알갱이가 아주 작아요. 구멍이 많아요"
 },
 {
  "t": 67.03,
  "end": 69.63,
  "section": "관찰해요",
  "sub": "암석 ③: 알갱이가 크고, 연한 분홍빛이에요"
 },
 {
  "t": 69.63,
  "end": 76.1,
  "section": "관찰해요",
  "sub": "암석 ④: 알갱이가 아주 작아요. 구멍이 조금 있어요"
 },
 {
  "t": 76.1,
  "end": 82.3,
  "section": "분류해요",
  "sub": "기준 1: 색깔이 밝은가?"
 },
 {
  "t": 82.3,
  "end": 88.63,
  "section": "분류해요",
  "sub": "밝은 암석은 ①, ③, 어두운 암석은 ②, ④예요"
 },
 {
  "t": 88.63,
  "end": 91.93,
  "section": "분류해요",
  "sub": "기준 2: 알갱이의 크기가 큰가?"
 },
 {
  "t": 91.93,
  "end": 101.07,
  "section": "분류해요",
  "sub": "알갱이가 큰 암석도 ①, ③! 나눈 무리가 같아요"
 },
 {
  "t": 101.07,
  "end": 110.07,
  "section": "분류해요",
  "sub": "①, ③은 화강암, ②, ④는 현무암이에요"
 },
 {
  "t": 110.07,
  "end": 120.57,
  "section": "분류해요",
  "sub": "현무암에는 구멍이 있기도 하지만, 구멍이 없는 현무암도 있어요"
 },
 {
  "t": 120.57,
  "end": 131.87,
  "section": "왜 다를까요?",
  "sub": "왜 알갱이의 크기가 다를까요? 마그마를 식혀 봐요"
 },
 {
  "t": 131.87,
  "end": 136.87,
  "section": "왜 다를까요?",
  "sub": "어느 쪽 알갱이가 클까요?"
 },
 {
  "t": 136.87,
  "end": 141.57,
  "section": "왜 다를까요?",
  "sub": "마그마가 식는 중…"
 },
 {
  "t": 141.57,
  "end": 151.23,
  "section": "왜 다를까요?",
  "sub": "지표 가까이에서 빨리 식으면 알갱이가 작은 현무암"
 },
 {
  "t": 151.23,
  "end": 157.5,
  "section": "왜 다를까요?",
  "sub": "땅속 깊은 곳에서 천천히 식으면 알갱이가 큰 화강암"
 },
 {
  "t": 157.5,
  "end": 162.3,
  "section": "우리 주변 암석",
  "sub": "우리 주변에는 화강암과 현무암으로 만든 것이 많아요"
 },
 {
  "t": 162.3,
  "end": 168.4,
  "section": "우리 주변 암석",
  "sub": "석가탑은 화강암, 돌하르방은 현무암으로 만들었어요"
 },
 {
  "t": 168.4,
  "end": 181.57,
  "section": "한눈에 쏙",
  "sub": "마그마가 식어 만들어진 암석은 화성암이에요"
 },
 {
  "t": 181.57,
  "end": 189.08,
  "section": "마무리",
  "sub": "땅속 깊은 곳에서 천천히 식으면 알갱이가 큰 화강암 지표 가까이에서 빨리 식으면 알갱이가 작은 현무암"
 },
 {
