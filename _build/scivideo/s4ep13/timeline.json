 },
 {
  "t": 148.0,
  "end": 154.27,
  "section": "우리 주변 암석",
  "sub": "석가탑은 화강암, 돌하르방은 현무암으로 만들었어요"
 },
 {
  "t": 154.27,
  "end": 166.73,
