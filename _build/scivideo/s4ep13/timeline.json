 {
  "t": 46.2,
  "end": 50.2,
  "section": "관찰해요",
  "sub": "디지털 현미경으로 알갱이를 자세히 봐요"
 },
 {
  "t": 50.2,
  "end": 55.07,
  "section": "관찰해요",
  "sub": "암석 ①: 알갱이가 크고, 검은색 알갱이가 군데군데 있어요"
 },
 {
  "t": 55.07,
  "end": 61.47,
  "section": "관찰해요",
  "sub": "암석 ②: 알갱이가 아주 작아요. 구멍이 많아요"
 },
 {
  "t": 61.47,
  "end": 63.87,
  "section": "관찰해요",
  "sub": "암석 ③: 알갱이가 크고, 연한 분홍빛이에요"
 },
 {
  "t": 63.87,
  "end": 69.6,
  "section": "관찰해요",
  "sub": "암석 ④: 알갱이가 아주 작아요. 구멍이 조금 있어요"
 },
 {
  "t": 69.6,
  "end": 75.13,
  "section": "분류해요",
  "sub": "기준 1: 색깔이 밝은가?"
 },
 {
  "t": 75.13,
  "end": 80.33,
  "section": "분류해요",
  "sub": "밝은 암석은 ①, ③, 어두운 암석은 ②, ④예요"
 },
 {
  "t": 80.33,
  "end": 83.73,
  "section": "분류해요",
  "sub": "기준 2: 알갱이의 크기가 큰가?"
 },
 {
  "t": 83.73,
  "end": 91.13,
  "section": "분류해요",
  "sub": "알갱이가 큰 암석도 ①, ③! 나눈 무리가 같아요"
 },
 {
  "t": 91.13,
  "end": 99.53,
  "section": "분류해요",
  "sub": "①, ③은 화강암, ②, ④는 현무암이에요"
 },
 {
  "t": 99.53,
  "end": 108.8,
  "section": "분류해요",
  "sub": "현무암에는 구멍이 있기도 하지만, 구멍이 없는 현무암도 있어요"
 },
 {
  "t": 108.8,
  "end": 117.87,
  "section": "왜 다를까요?",
