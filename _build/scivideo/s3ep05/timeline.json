[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 5화: 동물을 어떻게 분류할까?"
 },
 {
  "t": 5.5,
  "end": 10.73,
  "section": "궁금해요",
  "sub": "빨래를 개다가 양말이 뒤죽박죽 섞였어요"
 },
 {
  "t": 10.73,
  "end": 13.8,
  "section": "궁금해요",
  "sub": "색깔을 기준으로 나누어 봐요"
 },
 {
  "t": 13.8,
  "end": 17.2,
  "section": "궁금해요",
  "sub": "이번에는 모양을 기준으로 나누어 봐요"
 },
 {
  "t": 17.2,
  "end": 21.4,
  "section": "궁금해요",
  "sub": "같은 양말도 기준에 따라 다르게 나눌 수 있어요"
 },
 {
  "t": 21.4,
  "end": 29.13,
  "section": "궁금해요",
  "sub": "분류: 공통점이 있는 것끼리 묶는 활동"
 },
 {
  "t": 29.13,
  "end": 33.0,
  "section": "관찰해요",
  "sub": "동물 카드 12장을 관찰해요"
 },
 {
  "t": 33.0,
  "end": 38.4,
  "section": "관찰해요",
  "sub": "날개·다리·더듬이·지느러미가 있는지 살펴봐요"
 },
 {
  "t": 38.4,
  "end": 42.97,
  "section": "관찰해요",
  "sub": "토끼의 긴 귀는 더듬이가 아니에요"
 },
 {
  "t": 42.97,
  "end": 50.2,
  "section": "관찰해요",
  "sub": "달팽이의 뿔은 더듬이, 문어의 길쭉한 여덟 개는 다리"
 },
 {
  "t": 50.2,
  "end": 53.77,
  "section": "관찰해요",
  "sub": "공통점 — 개미와 나비는 다리와 더듬이가 모두 있어요"
 },
 {
  "t": 53.77,
  "end": 56.93,
  "section": "관찰해요",
  "sub": "공통점 — 제비와 나비는 날개가 있어요"
 },
 {
  "t": 56.93,
  "end": 60.5,
  "section": "분류해요",
  "sub": "분류 기준을 날개가 있는가?로 정해요"
 },
 {
  "t": 60.5,
  "end": 68.2,
  "section": "분류해요",
  "sub": "날개가 있는 동물은 어느 것일까요?"
 },
 {
  "t": 68.2,
  "end": 74.2,
  "section": "분류해요",
  "sub": "날개가 있는 동물은 제비와 나비예요"
 },
 {
  "t": 74.2,
  "end": 77.77,
  "section": "분류해요",
  "sub": "이번에는 다리가 있는가?로 나누어 봐요"
 },
 {
  "t": 77.77,
  "end": 87.33,
  "section": "분류해요",
  "sub": "다리가 있는 동물 7마리, 없는 동물 5마리"
 },
 {
  "t": 87.33,
  "end": 93.6,
  "section": "분류해요",
  "sub": "같은 동물도 기준에 따라 다르게 분류돼요"
 },
 {
  "t": 93.6,
  "end": 99.67,
  "section": "생각해요",
  "sub": "세 친구가 같은 기준으로 동물 6마리를 분류했어요"
 },
 {
  "t": 99.67,
  "end": 102.9,
  "section": "생각해요",
  "sub": "먼저 생김새가 귀여운가?로 분류해요"
 },
 {
  "t": 102.9,
  "end": 108.5,
  "section": "생각해요",
  "sub": "세 친구의 결과가 같을까요?"
 },
 {
  "t": 108.5,
  "end": 114.4,
  "section": "생각해요",
  "sub": "세 친구의 결과가 모두 달라요"
 },
 {
  "t": 114.4,
  "end": 117.8,
  "section": "생각해요",
  "sub": "이번에는 다리가 있는가?로 분류해요"
 },
 {
  "t": 117.8,
  "end": 121.8,
  "section": "생각해요",
  "sub": "누가 분류해도 같은 결과가 나와요"
 },
 {
  "t": 121.8,
  "end": 127.37,
  "section": "생각해요",
  "sub": "'예쁘다' 같은 주관적인 표현은 기준이 될 수 없어요"
 },
 {
  "t": 127.37,
  "end": 136.13,
  "section": "생각해요",
  "sub": "'짧다' 같은 상대적인 표현도 마찬가지예요"
 },
 {
  "t": 136.13,
  "end": 141.2,
  "section": "정리해요",
  "sub": "나비·문어·제비·뱀을 날개가 있는가?로 나누면?"
 },
 {
  "t": 141.2,
  "end": 147.03,
  "section": "정리해요",
  "sub": "날개가 있는 것은 나비, 제비, 없는 것은 뱀, 문어예요"
 },
 {
  "t": 147.03,
  "end": 155.27,
  "section": "정리해요",
  "sub": "동물은 특징에 따라 기준을 정해 분류할 수 있어요"
 },
 {
  "t": 155.27,
  "end": 161.2,
  "section": "정리해요",
  "sub": "이렇게 분류하면 동물을 이해하는 데 도움이 돼요"
 },
 {
  "t": 161.2,
  "end": 165.6,
  "section": "확인해요",
  "sub": "동물을 분류하는 기준으로 옳지 않은 것은?"
 },
 {
  "t": 165.6,
  "end": 171.6,
  "section": "확인해요",
  "sub": "옳지 않은 기준은 몇 번일까요?"
 },
 {
  "t": 171.6,
  "end": 179.1,
  "section": "확인해요",
  "sub": "정답은 ④ — 무서운지는 사람마다 달라요"
 },
 {
  "t": 179.1,
  "end": 183.6,
  "section": "마무리",
  "sub": "동물은 날개·다리처럼 특징에 따라 분류해요 분류 기준은 누가 분류해도 같은 결과가 나와야 해요"
 },
 {
  "t": 183.6,
  "end": 189.6,
  "section": "마무리",
  "sub": "다음 영상: 3학년 6화 · 우리 주변·땅속에 사는 동물"
 }
]