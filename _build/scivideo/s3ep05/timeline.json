[
 {
  "t": 0.0,
  "end": 6.67,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 5화: 동물을 어떻게 분류할까?"
 },
 {
  "t": 6.67,
  "end": 12.77,
  "section": "궁금해요",
  "sub": "빨래를 개다가 양말이 뒤죽박죽 섞였어요"
 },
 {
  "t": 12.77,
  "end": 15.7,
  "section": "궁금해요",
  "sub": "색깔을 기준으로 나누어 봐요"
 },
 {
  "t": 15.7,
  "end": 18.87,
  "section": "궁금해요",
  "sub": "이번에는 모양을 기준으로 나누어 봐요"
 },
 {
  "t": 18.87,
  "end": 23.13,
  "section": "궁금해요",
  "sub": "같은 양말도 기준에 따라 다르게 나눌 수 있어요"
 },
 {
  "t": 23.13,
  "end": 31.27,
  "section": "궁금해요",
  "sub": "분류: 공통점이 있는 것끼리 묶는 활동"
 },
 {
  "t": 31.27,
  "end": 35.07,
  "section": "관찰해요",
  "sub": "동물 카드 12장을 관찰해요"
 },
 {
  "t": 35.07,
  "end": 41.47,
  "section": "관찰해요",
  "sub": "날개·다리·더듬이·지느러미가 있는지 살펴봐요"
 },
 {
  "t": 41.47,
  "end": 46.47,
  "section": "관찰해요",
  "sub": "토끼의 긴 귀는 더듬이가 아니에요"
 },
 {
  "t": 46.47,
  "end": 54.17,
  "section": "관찰해요",
  "sub": "달팽이의 뿔은 더듬이, 문어의 길쭉한 여덟 개는 다리"
 },
 {
  "t": 54.17,
  "end": 57.5,
  "section": "관찰해요",
  "sub": "공통점 — 개미와 나비는 다리와 더듬이가 모두 있어요"
 },
 {
  "t": 57.5,
  "end": 60.57,
  "section": "관찰해요",
  "sub": "공통점 — 제비와 나비는 날개가 있어요"
 },
 {
  "t": 60.57,
  "end": 64.97,
  "section": "분류해요",
  "sub": "분류 기준을 날개가 있는가?로 정해요"
 },
 {
  "t": 64.97,
  "end": 72.67,
  "section": "분류해요",
  "sub": "날개가 있는 동물은 어느 것일까요?"
 },
 {
  "t": 72.67,
  "end": 79.33,
  "section": "분류해요",
  "sub": "날개가 있는 동물은 제비와 나비예요"
 },
 {
  "t": 79.33,
  "end": 83.57,
  "section": "분류해요",
  "sub": "이번에는 다리가 있는가?로 나누어 봐요"
 },
 {
  "t": 83.57,
  "end": 97.17,
  "section": "분류해요",
  "sub": "다리가 있는 동물 7마리, 없는 동물 5마리"
 },
 {
  "t": 97.17,
  "end": 103.13,
  "section": "분류해요",
  "sub": "같은 동물도 기준에 따라 다르게 분류돼요"
 },
 {
  "t": 103.13,
  "end": 109.83,
  "section": "생각해요",
  "sub": "세 친구가 같은 기준으로 동물 6마리를 분류했어요"
 },
 {
  "t": 109.83,
  "end": 112.93,
  "section": "생각해요",
  "sub": "먼저 생김새가 귀여운가?로 분류해요"
 },
 {
  "t": 112.93,
  "end": 119.2,
  "section": "생각해요",
  "sub": "세 친구의 결과가 같을까요?"
 },
 {
  "t": 119.2,
  "end": 125.6,
  "section": "생각해요",
  "sub": "세 친구의 결과가 모두 달라요"
 },
 {
  "t": 125.6,
  "end": 128.8,
  "section": "생각해요",
  "sub": "이번에는 다리가 있는가?로 분류해요"
 },
 {
  "t": 128.8,
  "end": 132.73,
  "section": "생각해요",
  "sub": "누가 분류해도 같은 결과가 나와요"
 },
 {
  "t": 132.73,
  "end": 138.27,
  "section": "생각해요",
  "sub": "'예쁘다' 같은 주관적인 표현은 기준이 될 수 없어요"
 },
 {
  "t": 138.27,
  "end": 147.47,
  "section": "생각해요",
  "sub": "'짧다' 같은 상대적인 표현도 마찬가지예요"
 },
 {
  "t": 147.47,
  "end": 153.23,
  "section": "정리해요",
  "sub": "나비·문어·제비·뱀을 날개가 있는가?로 나누면?"
 },
 {
  "t": 153.23,
  "end": 159.73,
  "section": "정리해요",
  "sub": "날개가 있는 것은 나비, 제비, 없는 것은 뱀, 문어예요"
 },
 {
  "t": 159.73,
  "end": 168.53,
  "section": "정리해요",
  "sub": "동물은 특징에 따라 기준을 정해 분류할 수 있어요"
 },
 {
  "t": 168.53,
  "end": 174.13,
  "section": "정리해요",
  "sub": "이렇게 분류하면 동물을 이해하는 데 도움이 돼요"
 },
 {
  "t": 174.13,
  "end": 178.3,
  "section": "확인해요",
  "sub": "동물을 분류하는 기준으로 옳지 않은 것은?"
 },
 {
  "t": 178.3,
  "end": 184.3,
  "section": "확인해요",
  "sub": "옳지 않은 기준은 몇 번일까요?"
 },
 {
  "t": 184.3,
  "end": 192.1,
  "section": "확인해요",
  "sub": "정답은 ④ — 무서운지는 사람마다 달라요"
 },
 {
  "t": 192.1,
  "end": 199.34,
  "section": "마무리",
  "sub": "동물은 날개·다리처럼 특징에 따라 분류해요 분류 기준은 누가 분류해도 같은 결과가 나와야 해요"
 },
 {
  "t": 199.34,
  "end": 206.5,
  "section": "마무리",
  "sub": "다음 영상: 3학년 6화 · 우리 주변·땅속에 사는 동물"
 }
]