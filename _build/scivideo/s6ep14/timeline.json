[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 14화: 뿌리의 생김새와 하는 일"
 },
 {
  "t": 5.5,
  "end": 9.9,
  "section": "궁금해요",
  "sub": "우리가 먹는 당근은 식물의 어느 부분일까요?"
 },
 {
  "t": 9.9,
  "end": 16.83,
  "section": "궁금해요",
  "sub": "흙 속에서 자라는 당근은 뿌리예요 — 뿌리에 양분을 저장해요"
 },
 {
  "t": 16.83,
  "end": 20.87,
  "section": "관찰해요",
  "sub": "파 뿌리를 검은색 종이 위에 놓고 돋보기로 봐요"
 },
 {
  "t": 20.87,
  "end": 27.77,
  "section": "관찰해요",
  "sub": "비슷한 굵기의 뿌리가 수염처럼 나 있어요"
 },
 {
  "t": 27.77,
  "end": 34.63,
  "section": "실험 계획",
  "sub": "한 개는 잎과 뿌리를, 다른 한 개는 잎만 잘라요"
 },
 {
  "t": 34.63,
  "end": 45.57,
  "section": "실험 계획",
  "sub": "뿌리만 다르게 하고 나머지 조건은 모두 같게 해요"
 },
 {
  "t": 45.57,
  "end": 52.8,
  "section": "실험해요",
  "sub": "탈지면으로 감싸 같은 양의 물에 넣고 물 높이를 표시해요"
 },
 {
  "t": 52.8,
  "end": 58.53,
  "section": "실험해요",
  "sub": "햇빛이 잘 드는 곳에 3일 동안 놓아두어요"
 },
 {
  "t": 58.53,
  "end": 63.53,
  "section": "실험해요",
  "sub": "어느 쪽 물이 더 많이 줄어들까요?"
 },
 {
  "t": 63.53,
  "end": 69.6,
  "section": "실험해요",
  "sub": "뿌리를 자르지 않은 파 쪽의 물이 더 많이 줄었어요"
 },
 {
  "t": 69.6,
  "end": 76.5,
  "section": "실험해요",
  "sub": "뿌리가 물을 흡수한다는 것을 알 수 있어요"
 },
 {
  "t": 76.5,
  "end": 85.4,
  "section": "실험해요",
  "sub": "자른 쪽도 조금 줄어든 것은 단면 흡수와 증발 때문이에요"
 },
 {
  "t": 85.4,
  "end": 93.5,
  "section": "실험해요",
  "sub": "예상과 달라도 결과는 사실대로 기록해요"
 },
 {
  "t": 93.5,
  "end": 97.57,
  "section": "여러 가지 뿌리",
  "sub": "식물의 뿌리를 생김새에 따라 나누어 봐요"
 },
 {
  "t": 97.57,
  "end": 108.5,
  "section": "여러 가지 뿌리",
  "sub": "백합·강아지풀은 수염처럼, 민들레·사과나무는 굵고 곧은 뿌리"
 },
 {
  "t": 108.5,
  "end": 114.73,
  "section": "뿌리가 하는 일",
  "sub": "뿌리에는 솜털처럼 가는 뿌리털이 있어요"
 },
 {
  "t": 114.73,
  "end": 117.47,
  "section": "뿌리가 하는 일",
  "sub": "뿌리가 하는 일을 모두 골라 봐요"
 },
 {
  "t": 117.47,
  "end": 122.47,
  "section": "뿌리가 하는 일",
  "sub": "뿌리가 하는 일은 무엇일까요?"
 },
 {
  "t": 122.47,
  "end": 130.47,
  "section": "뿌리가 하는 일",
  "sub": "흡수 · 지지 · 저장 — 양분을 만들지는 않아요"
 },
 {
  "t": 130.47,
  "end": 136.87,
  "section": "뿌리가 하는 일",
  "sub": "‘뿌리 깊은 나무는 바람에 흔들리지 않는다’"
 },
 {
  "t": 136.87,
  "end": 145.13,
  "section": "뿌리가 하는 일",
  "sub": "뿌리가 땅속 깊이 뻗어 식물을 지지하기 때문이에요"
 },
 {
  "t": 145.13,
  "end": 153.8,
  "section": "한눈에 쏙",
  "sub": "식물은 뿌리로 물을 흡수해요"
 },
 {
  "t": 153.8,
  "end": 158.3,
  "section": "마무리",
  "sub": "뿌리는 물을 흡수하고, 식물을 지지하며, 양분을 저장하기도 해요"
 },
 {
  "t": 158.3,
  "end": 164.3,
