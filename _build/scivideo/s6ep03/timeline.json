  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 3화: 산성 용액과 염기성 용액의 성질"
 },
 {
  "t": 5.5,
  "end": 9.4,
  "section": "궁금해요",
  "sub": "달걀을 식초에 넣으면 어떻게 될까요?"
 },
 {
  "t": 9.4,
  "end": 22.5,
  "section": "궁금해요",
  "sub": "산성 용액과 염기성 용액은 서로 다른 성질이 있어요"
 },
 {
  "t": 22.5,
  "end": 29.7,
  "section": "실험해요",
  "sub": "묽은 염산과 묽은 수산화 나트륨 용액에 네 가지 물질을 넣어요"
 },
 {
  "t": 29.7,
  "end": 37.73,
  "section": "실험해요",
  "sub": "이번 실험은 용액이 조금 더 진해서 더 조심해요"
 },
 {
  "t": 37.73,
  "end": 45.3,
  "section": "실험해요",
  "sub": "넣은 직후: 묽은 염산 속 껍데기에서 기포가 발생해요"
 },
 {
  "t": 45.3,
  "end": 50.3,
  "section": "실험해요",
  "sub": "시간이 지나면 어떻게 될까요?"
 },
 {
  "t": 50.3,
  "end": 55.37,
  "section": "실험해요",
  "sub": "하루 뒤: 껍데기들이 기포를 내며 점점 작아져요"
 },
 {
  "t": 55.37,
  "end": 64.1,
  "section": "실험해요",
  "sub": "사흘 뒤: 묽은 수산화 나트륨 용액 속 흰자·닭 가슴살이 흐물흐물"
 },
 {
  "t": 64.1,
  "end": 73.37,
  "section": "실험해요",
  "sub": "일주일 뒤: 산성은 껍데기를, 염기성은 흰자·닭 가슴살을 녹였어요"
 },
 {
  "t": 73.37,
  "end": 75.93,
  "section": "정리해요",
  "sub": "관찰한 결과를 정리해요"
 },
 {
  "t": 75.93,
  "end": 84.33,
  "section": "정리해요",
  "sub": "껍데기는 탄산 칼슘, 흰자·닭 가슴살은 단백질"
 },
 {
  "t": 84.33,
  "end": 91.6,
  "section": "정리해요",
  "sub": "산성 용액은 탄산 칼슘을, 염기성 용액은 단백질을 녹여요"
 },
 {
  "t": 91.6,
  "end": 101.5,
  "section": "더 알아봐요",
  "sub": "대리암 조각과 두부를 넣으면 어떻게 될까요?"
 },
 {
  "t": 101.5,
  "end": 106.5,
  "section": "더 알아봐요",
  "sub": "어느 용액에서 변화가 나타날까요?"
