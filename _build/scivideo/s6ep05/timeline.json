[
 {
  "t": 0.0,
  "end": 6.33,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 5화: 생활 속 산과 염기"
 },
 {
  "t": 6.33,
  "end": 10.3,
  "section": "궁금해요",
  "sub": "생선 요리에 레몬이 같이 나오는 까닭은?"
 },
 {
  "t": 10.3,
  "end": 14.97,
  "section": "궁금해요",
  "sub": "레몬은 왜 함께 나올까요?"
 },
 {
  "t": 14.97,
  "end": 24.4,
  "section": "궁금해요",
  "sub": "산성인 레몬즙이 생선의 비린내를 줄여 줘요"
 },
 {
  "t": 24.4,
  "end": 29.87,
  "section": "조사해요",
  "sub": "우리 주변의 산성 용액과 염기성 용액"
 },
 {
  "t": 29.87,
  "end": 34.87,
  "section": "조사해요",
  "sub": "어느 칸에 넣을까요?"
 },
 {
  "t": 34.87,
  "end": 50.13,
  "section": "조사해요",
  "sub": "레몬즙·식초·변기 청소용 세제·구연산 용액은 산성"
 },
 {
  "t": 50.13,
  "end": 57.7,
  "section": "조사해요",
  "sub": "제산제·제빵 소다 용액·표백제·하수구 세정제는 염기성"
 },
 {
  "t": 57.7,
  "end": 64.47,
  "section": "집 안에서 찾기",
  "sub": "부엌에서는 어떤 용액을 이용할까요?"
 },
 {
  "t": 64.47,
  "end": 73.83,
  "section": "집 안에서 찾기",
  "sub": "샐러드에는 레몬즙, 비린내 나는 도마는 식초로"
 },
 {
  "t": 73.83,
  "end": 83.47,
  "section": "집 안에서 찾기",
  "sub": "과일 껍질은 제빵 소다 용액, 속이 쓰릴 땐 제산제"
 },
 {
  "t": 83.47,
  "end": 85.53,
  "section": "집 안에서 찾기",
  "sub": "욕실에서는 어떤 용액을 이용할까요?"
 },
 {
  "t": 85.53,
  "end": 90.2,
  "section": "집 안에서 찾기",
  "sub": "어떤 용액을 이용할까요?"
 },
 {
  "t": 90.2,
  "end": 95.73,
  "section": "집 안에서 찾기",
  "sub": "변기의 때와 냄새는 변기 청소용 세제로"
 },
 {
  "t": 95.73,
  "end": 106.87,
  "section": "집 안에서 찾기",
  "sub": "욕실 벽은 표백제, 막힌 하수구는 하수구 세정제"
 },
 {
  "t": 106.87,
  "end": 110.27,
  "section": "성질과 이어 보기",
  "sub": "왜 그 용액을 이용할까요?"
 },
 {
  "t": 110.27,
  "end": 118.47,
  "section": "성질과 이어 보기",
  "sub": "위액은 산성, 제산제는 염기성 — 산성을 약하게 해요"
 },
 {
  "t": 118.47,
  "end": 125.03,
  "section": "성질과 이어 보기",
  "sub": "하수구 세정제는 염기성 — 머리카락의 단백질을 녹여요"
 },
 {
  "t": 125.03,
  "end": 131.7,
  "section": "성질과 이어 보기",
  "sub": "염기성인 비린내를 산성인 식초로 줄여요"
 },
 {
  "t": 131.7,
  "end": 141.2,
  "section": "성질과 이어 보기",
  "sub": "각각의 성질도, 섞을 때 성질이 변하는 것도 이용해요"
 },
 {
  "t": 141.2,
  "end": 146.03,
  "section": "한눈에 쏙",
  "sub": "제산제에는 염기성 물질이 들어 있어요"
 },
 {
  "t": 146.03,
  "end": 154.07,
  "section": "한눈에 쏙",
  "sub": "변기 세제 대신 콜라·탄산수·구연산 용액 같은 산성 용액"
 },
 {
  "t": 154.07,
  "end": 159.81,
  "section": "마무리",
  "sub": "산성·염기성 용액의 성질을 알면 생활에서 알맞게 이용할 수 있어요"
 },
 {
  "t": 159.81,
  "end": 166.67,
  "section": "마무리",
  "sub": "다음 영상: 6학년 6화 · 산성화가 환경에 주는 영향"
 }
]