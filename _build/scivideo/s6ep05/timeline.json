[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 5화: 생활 속 산과 염기"
 },
 {
  "t": 5.5,
  "end": 9.57,
  "section": "궁금해요",
  "sub": "생선 요리에 레몬이 같이 나오는 까닭은?"
 },
 {
  "t": 9.57,
  "end": 13.57,
  "section": "궁금해요",
  "sub": "레몬은 왜 함께 나올까요?"
 },
 {
  "t": 13.57,
  "end": 22.83,
  "section": "궁금해요",
  "sub": "산성인 레몬즙이 생선의 비린내를 줄여 줘요"
 },
 {
  "t": 22.83,
  "end": 28.53,
  "section": "조사해요",
  "sub": "우리 주변의 산성 용액과 염기성 용액"
 },
 {
  "t": 28.53,
  "end": 33.53,
  "section": "조사해요",
  "sub": "어느 칸에 넣을까요?"
 },
 {
  "t": 33.53,
  "end": 44.6,
  "section": "조사해요",
  "sub": "레몬즙·식초·변기 청소용 세제·구연산 용액은 산성"
 },
 {
  "t": 44.6,
  "end": 50.37,
  "section": "조사해요",
  "sub": "제산제·제빵 소다 용액·표백제·하수구 세정제는 염기성"
 },
 {
  "t": 50.37,
  "end": 56.43,
  "section": "집 안에서 찾기",
  "sub": "부엌에서는 어떤 용액을 이용할까요?"
 },
 {
  "t": 56.43,
  "end": 65.33,
  "section": "집 안에서 찾기",
  "sub": "샐러드에는 레몬즙, 비린내 나는 도마는 식초로"
 },
 {
  "t": 65.33,
  "end": 74.33,
  "section": "집 안에서 찾기",
  "sub": "과일 껍질은 제빵 소다 용액, 속이 쓰릴 땐 제산제"
 },
 {
  "t": 74.33,
  "end": 76.4,
  "section": "집 안에서 찾기",
  "sub": "욕실에서는 어떤 용액을 이용할까요?"
 },
 {
  "t": 76.4,
  "end": 80.4,
  "section": "집 안에서 찾기",
  "sub": "어떤 용액을 이용할까요?"
 },
 {
  "t": 80.4,
  "end": 85.97,
  "section": "집 안에서 찾기",
  "sub": "변기의 때와 냄새는 변기 청소용 세제로"
 },
 {
  "t": 85.97,
  "end": 96.57,
  "section": "집 안에서 찾기",
  "sub": "욕실 벽은 표백제, 막힌 하수구는 하수구 세정제"
 },
 {
  "t": 96.57,
  "end": 100.13,
  "section": "성질과 이어 보기",
  "sub": "왜 그 용액을 이용할까요?"
 },
 {
  "t": 100.13,
  "end": 107.9,
  "section": "성질과 이어 보기",
  "sub": "위액은 산성, 제산제는 염기성 — 산성을 약하게 해요"
 },
 {
  "t": 107.9,
  "end": 114.83,
  "section": "성질과 이어 보기",
  "sub": "하수구 세정제는 염기성 — 머리카락의 단백질을 녹여요"
 },
 {
  "t": 114.83,
  "end": 121.0,
  "section": "성질과 이어 보기",
  "sub": "염기성인 비린내를 산성인 식초로 줄여요"
 },
 {
  "t": 121.0,
  "end": 130.1,
  "section": "성질과 이어 보기",
  "sub": "각각의 성질도, 섞을 때 성질이 변하는 것도 이용해요"
 },
 {
  "t": 130.1,
  "end": 135.17,
  "section": "한눈에 쏙",
  "sub": "제산제에는 염기성 물질이 들어 있어요"
 },
 {
  "t": 135.17,
  "end": 142.17,
  "section": "한눈에 쏙",
  "sub": "변기 세제 대신 콜라·탄산수·구연산 용액 같은 산성 용액"
 },
 {
  "t": 142.17,
  "end": 146.67,
  "section": "마무리",
  "sub": "산성·염기성 용액의 성질을 알면 생활에서 알맞게 이용할 수 있어요"
 },
 {
