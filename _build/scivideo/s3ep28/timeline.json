[
 {
  "t": 0.0,
  "end": 6.17,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 28화: 밀물과 썰물"
 },
 {
  "t": 6.17,
  "end": 11.03,
  "section": "궁금해요",
  "sub": "같은 바닷가를 서로 다른 때에 본 모습이에요"
 },
 {
  "t": 11.03,
  "end": 15.93,
  "section": "궁금해요",
  "sub": "바위와 물을 비교해 보세요. 무엇이 달라졌나요?"
 },
 {
  "t": 15.93,
  "end": 20.6,
  "section": "궁금해요",
  "sub": "무엇이 달라졌을까요?"
 },
 {
  "t": 20.6,
  "end": 32.27,
  "section": "궁금해요",
  "sub": "바위는 그대로! 바닷물의 높이가 달라졌어요"
 },
 {
  "t": 32.27,
  "end": 42.5,
  "section": "관찰해요",
  "sub": "하루 동안 같은 바닷가를 지켜봐요"
 },
 {
  "t": 42.5,
  "end": 56.73,
  "section": "관찰해요",
  "sub": "9시쯤: 바닷물이 가장 낮아요 — 바닷길이 드러나고 배가 땅에 얹혀요"
 },
 {
  "t": 56.73,
  "end": 68.47,
  "section": "관찰해요",
  "sub": "오후 3시쯤: 바닷물이 가장 높아요 — 바닷길이 잠기고 배가 떠요"
 },
 {
  "t": 68.47,
  "end": 77.27,
  "section": "관찰해요",
  "sub": "같은 곳이라도 바닷물의 높이는 높아졌다 낮아졌다 해요"
 },
 {
  "t": 77.27,
  "end": 81.77,
  "section": "기록해요",
  "sub": "시각마다 물에 잠긴 빨간 눈금의 수를 기록해요"
 },
 {
  "t": 81.77,
  "end": 86.33,
  "section": "기록해요",
  "sub": "그래프를 보면 바닷물의 높이는 어떻게 변했나요?"
 },
 {
  "t": 86.33,
  "end": 91.0,
  "section": "기록해요",
  "sub": "그래프에서 무엇을 알 수 있나요?"
 },
 {
  "t": 91.0,
  "end": 99.23,
  "section": "기록해요",
  "sub": "낮아졌다가 높아지고, 다시 낮아져요 — 되풀이해요"
 },
 {
  "t": 99.23,
  "end": 105.47,
  "section": "밀물과 썰물",
  "sub": "바닷물이 육지 쪽으로 밀려 들어오는 현상 = 밀물"
 },
 {
  "t": 105.47,
  "end": 111.57,
  "section": "밀물과 썰물",
  "sub": "바닷물이 바다 쪽으로 빠져나가는 현상 = 썰물"
 },
 {
  "t": 111.57,
  "end": 120.1,
  "section": "밀물과 썰물",
  "sub": "밀물 때는 바닷길이 잠기고 배가 떠올라요, 썰물 때는?"
 },
 {
  "t": 120.1,
  "end": 129.47,
  "section": "생활 속으로",
  "sub": "배들이 물 위가 아니라 땅 위에 얹혀 있어요. 언제일까요?"
 },
 {
  "t": 129.47,
  "end": 138.8,
  "section": "생활 속으로",
  "sub": "썰물이 되어 바닷물이 낮아지면 배가 땅에 얹혀요"
 },
 {
  "t": 138.8,
  "end": 145.07,
  "section": "생활 속으로",
  "sub": "갯벌에서 “갯벌 밖으로 나오세요!” 방송이 나와요. 왜일까요?"
 },
 {
  "t": 145.07,
  "end": 149.73,
  "section": "생활 속으로",
  "sub": "왜 나오라고 할까요?"
 },
 {
  "t": 149.73,
  "end": 158.4,
  "section": "생활 속으로",
  "sub": "밀물이 되면 갯벌이 다시 물에 잠기기 때문이에요"
 },
 {
  "t": 158.4,
  "end": 163.87,
  "section": "생활 속으로",
  "sub": "바닷가 바위나 기둥에 따개비가 붙어 사는 까닭은?"
 },
 {
  "t": 163.87,
  "end": 170.37,
  "section": "생활 속으로",
  "sub": "그곳이 밀물 때 바닷물에 잠기는 곳이라서 살 수 있어요"
 },
 {
  "t": 170.37,
  "end": 177.43,
  "section": "생활 속으로",
  "sub": "안전: 꼭 어른과 함께, 정해진 시각보다 일찍 나와요"
 },
 {
  "t": 177.43,
  "end": 183.48,
  "section": "마무리",
  "sub": "바닷물이 육지 쪽으로 밀려 들어오는 것은 밀물 바다 쪽으로 빠져나가는 것은 썰물이에요"
 },
 {
  "t": 183.48,
  "end": 189.93,
  "section": "마무리",
  "sub": "다음 영상: 3학년 29화 · 살아 숨 쉬는 갯벌"
 }
]