[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 28화: 밀물과 썰물"
 },
 {
  "t": 5.5,
  "end": 10.73,
  "section": "궁금해요",
  "sub": "같은 바닷가를 서로 다른 때에 본 모습이에요"
 },
 {
  "t": 10.73,
  "end": 14.8,
  "section": "궁금해요",
  "sub": "바위와 물을 비교해 보세요. 무엇이 달라졌나요?"
 },
 {
  "t": 14.8,
  "end": 18.8,
  "section": "궁금해요",
  "sub": "무엇이 달라졌을까요?"
 },
 {
  "t": 18.8,
  "end": 29.37,
  "section": "궁금해요",
  "sub": "바위는 그대로! 바닷물의 높이가 달라졌어요"
 },
 {
  "t": 29.37,
  "end": 37.4,
  "section": "관찰해요",
  "sub": "하루 동안 같은 바닷가를 지켜봐요"
 },
 {
  "t": 37.4,
  "end": 50.27,
  "section": "관찰해요",
  "sub": "9시쯤: 바닷물이 가장 낮아요 — 바닷길이 드러나고 배가 땅에 얹혀요"
 },
 {
  "t": 50.27,
  "end": 60.5,
  "section": "관찰해요",
  "sub": "오후 3시쯤: 바닷물이 가장 높아요 — 바닷길이 잠기고 배가 떠요"
 },
 {
  "t": 60.5,
  "end": 68.6,
  "section": "관찰해요",
  "sub": "같은 곳이라도 바닷물의 높이는 높아졌다 낮아졌다 해요"
 },
 {
  "t": 68.6,
  "end": 73.33,
  "section": "기록해요",
  "sub": "시각마다 물에 잠긴 빨간 눈금의 수를 기록해요"
 },
 {
  "t": 73.33,
  "end": 77.9,
  "section": "기록해요",
  "sub": "그래프를 보면 바닷물의 높이는 어떻게 변했나요?"
 },
 {
  "t": 77.9,
  "end": 81.9,
  "section": "기록해요",
  "sub": "그래프에서 무엇을 알 수 있나요?"
 },
 {
  "t": 81.9,
  "end": 89.5,
  "section": "기록해요",
  "sub": "낮아졌다가 높아지고, 다시 낮아져요 — 되풀이해요"
 },
 {
  "t": 89.5,
  "end": 96.23,
  "section": "밀물과 썰물",
  "sub": "바닷물이 육지 쪽으로 밀려 들어오는 현상 = 밀물"
 },
 {
  "t": 96.23,
  "end": 102.8,
  "section": "밀물과 썰물",
  "sub": "바닷물이 바다 쪽으로 빠져나가는 현상 = 썰물"
 },
 {
  "t": 102.8,
  "end": 110.57,
  "section": "밀물과 썰물",
  "sub": "밀물 때는 바닷길이 잠기고 배가 떠올라요, 썰물 때는?"
 },
 {
  "t": 110.57,
  "end": 118.63,
  "section": "생활 속으로",
  "sub": "배들이 물 위가 아니라 땅 위에 얹혀 있어요. 언제일까요?"
 },
 {
  "t": 118.63,
  "end": 126.53,
  "section": "생활 속으로",
  "sub": "썰물이 되어 바닷물이 낮아지면 배가 땅에 얹혀요"
 },
 {
  "t": 126.53,
  "end": 132.27,
  "section": "생활 속으로",
  "sub": "갯벌에서 “갯벌 밖으로 나오세요!” 방송이 나와요. 왜일까요?"
 },
 {
  "t": 132.27,
  "end": 136.27,
  "section": "생활 속으로",
  "sub": "왜 나오라고 할까요?"
 },
 {
  "t": 136.27,
  "end": 144.77,
  "section": "생활 속으로",
  "sub": "밀물이 되면 갯벌이 다시 물에 잠기기 때문이에요"
 },
 {
  "t": 144.77,
  "end": 150.5,
  "section": "생활 속으로",
  "sub": "바닷가 바위나 기둥에 따개비가 붙어 사는 까닭은?"
 },
 {
  "t": 150.5,
  "end": 156.4,
  "section": "생활 속으로",
  "sub": "그곳이 밀물 때 바닷물에 잠기는 곳이라서 살 수 있어요"
 },
 {
  "t": 156.4,
  "end": 162.57,
  "section": "생활 속으로",
  "sub": "안전: 꼭 어른과 함께, 정해진 시각보다 일찍 나와요"
 },
 {
  "t": 162.57,
  "end": 167.07,
  "section": "마무리",
  "sub": "바닷물이 육지 쪽으로 밀려 들어오는 것은 밀물 바다 쪽으로 빠져나가는 것은 썰물이에요"
 },
 {
  "t": 167.07,
  "end": 173.07,
  "section": "마무리",
  "sub": "다음 영상: 3학년 29화 · 살아 숨 쉬는 갯벌"
 }
]