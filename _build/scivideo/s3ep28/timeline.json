[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 28화: 밀물과 썰물"
 },
 {
  "t": 5.47,
  "end": 12.87,
  "section": "궁금해요",
  "sub": "같은 바닷가를 서로 다른 때에 본 모습이에요"
 },
 {
  "t": 12.87,
  "end": 16.93,
  "section": "궁금해요",
  "sub": "바위와 물을 비교해 보세요. 무엇이 달라졌나요?"
 },
 {
  "t": 16.93,
  "end": 20.93,
  "section": "궁금해요",
  "sub": "무엇이 달라졌을까요?"
 },
 {
  "t": 20.93,
  "end": 31.53,
  "section": "궁금해요",
  "sub": "바위는 그대로! 바닷물의 높이가 달라졌어요"
 },
 {
  "t": 31.53,
  "end": 39.2,
  "section": "관찰해요",
  "sub": "하루 동안 같은 바닷가를 지켜봐요"
 },
 {
  "t": 39.2,
  "end": 44.87,
  "section": "관찰해요",
  "sub": "시간이 흐르면 바닷물의 높이는 어떻게 될까요?"
 },
 {
  "t": 44.87,
  "end": 57.73,
  "section": "관찰해요",
  "sub": "9시쯤: 바닷물이 가장 낮아요 — 바닷길이 드러나고 배가 땅에 얹혀요"
 },
 {
  "t": 57.73,
  "end": 67.93,
  "section": "관찰해요",
  "sub": "오후 3시쯤: 바닷물이 가장 높아요 — 바닷길이 잠기고 배가 떠요"
 },
 {
  "t": 67.93,
  "end": 76.0,
  "section": "관찰해요",
  "sub": "같은 곳이라도 바닷물의 높이는 높아졌다 낮아졌다 해요"
 },
 {
  "t": 76.0,
  "end": 82.53,
  "section": "기록해요",
  "sub": "시각마다 물에 잠긴 빨간 눈금의 수를 기록해요"
 },
 {
  "t": 82.53,
  "end": 87.07,
  "section": "기록해요",
  "sub": "그래프를 보면 바닷물의 높이는 어떻게 변했나요?"
 },
 {
  "t": 87.07,
  "end": 91.07,
  "section": "기록해요",
  "sub": "그래프에서 무엇을 알 수 있나요?"
 },
 {
  "t": 91.07,
  "end": 98.67,
  "section": "기록해요",
  "sub": "낮아졌다가 높아지고, 다시 낮아져요 — 되풀이해요"
 },
 {
  "t": 98.67,
  "end": 105.4,
  "section": "밀물과 썰물",
  "sub": "바닷물이 육지 쪽으로 밀려 들어오는 현상 = 밀물"
 },
 {
  "t": 105.4,
  "end": 111.93,
  "section": "밀물과 썰물",
  "sub": "바닷물이 바다 쪽으로 빠져나가는 현상 = 썰물"
 },
 {
  "t": 111.93,
  "end": 120.67,
  "section": "밀물과 썰물",
  "sub": "밀물 때는 바닷길이 잠기고 배가 떠올라요, 썰물 때는?"
 },
 {
  "t": 120.67,
  "end": 128.73,
  "section": "생활 속으로",
  "sub": "배들이 물 위가 아니라 땅 위에 얹혀 있어요. 언제일까요?"
 },
 {
  "t": 128.73,
  "end": 136.6,
  "section": "생활 속으로",
  "sub": "썰물이 되어 바닷물이 낮아지면 배가 땅에 얹혀요"
 },
 {
  "t": 136.6,
  "end": 142.33,
  "section": "생활 속으로",
  "sub": "갯벌에서 “갯벌 밖으로 나오세요!” 방송이 나와요. 왜일까요?"
 },
 {
  "t": 142.33,
  "end": 146.33,
  "section": "생활 속으로",
  "sub": "왜 나오라고 할까요?"
 },
 {
  "t": 146.33,
  "end": 154.8,
  "section": "생활 속으로",
  "sub": "밀물이 되면 갯벌이 다시 물에 잠기기 때문이에요"
 },
 {
  "t": 154.8,
  "end": 160.53,
  "section": "생활 속으로",
  "sub": "바닷가 바위나 기둥에 따개비가 붙어 사는 까닭은?"
 },
 {
  "t": 160.53,
  "end": 166.4,
  "section": "생활 속으로",
  "sub": "그곳이 밀물 때 바닷물에 잠기는 곳이라서 살 수 있어요"
 },
 {
  "t": 166.4,
  "end": 175.53,
  "section": "생활 속으로",
  "sub": "안전: 꼭 어른과 함께, 정해진 시각보다 일찍 나와요"
 },
 {
  "t": 175.53,
  "end": 180.03,
  "section": "마무리",
  "sub": "바닷물이 육지 쪽으로 밀려 들어오는 것은 밀물 바다 쪽으로 빠져나가는 것은 썰물이에요"
 },
 {
  "t": 180.03,
  "end": 186.0,
  "section": "마무리",
  "sub": "다음 영상: 3학년 29화 · 살아 숨 쉬는 갯벌"
 }
]