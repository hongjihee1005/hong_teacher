 },
 {
  "t": 112.53,
  "end": 122.93,
  "section": "결과",
  "sub": "바닷물에는 어떤 물질이 녹아 있어요"
 },
 {
  "t": 122.93,
  "end": 125.8,
  "section": "생각 바로잡기",
