 },
 {
  "t": 37.4,
  "end": 44.6,
  "section": "실험해요",
  "sub": "비커에 담아 색깔과 냄새를 관찰해요"
 },
 {
  "t": 44.6,
  "end": 49.53,
  "section": "실험해요",
