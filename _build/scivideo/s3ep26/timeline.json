  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 26화: 바닷물은 육지의 물과 어떻게 다를까?"
 },
 {
  "t": 7.87,
  "end": 16.23,
  "section": "궁금해요",
  "sub": "무인도에서 목이 말라요!"
 },
 {
  "t": 16.23,
  "end": 21.4,
  "section": "궁금해요",
  "sub": "왜 바닷물을 마시지 않을까요?"
 },
 {
  "t": 21.4,
  "end": 26.07,
  "section": "궁금해요",
  "sub": "왜 바닷물을 마시지 않을까요?"
 },
 {
  "t": 26.07,
  "end": 36.47,
  "section": "궁금해요",
  "sub": "바닷물은 짜고 여러 가지 물질이 녹아 있어요"
 },
 {
  "t": 36.47,
  "end": 44.87,
  "section": "실험해요",
  "sub": "실험 전에 실험복·보안경·장갑을 착용해요"
 },
 {
  "t": 44.87,
  "end": 53.77,
  "section": "실험해요",
  "sub": "비커에 담아 색깔과 냄새를 관찰해요"
 },
 {
  "t": 53.77,
  "end": 59.4,
  "section": "실험해요",
  "sub": "맛보거나 마시지 않아요"
 },
 {
  "t": 59.4,
  "end": 66.07,
  "section": "실험해요",
  "sub": "가열하기 전에는 비슷해 보여요. 어떻게 알아낼까요?"
 },
 {
  "t": 66.07,
  "end": 75.13,
  "section": "실험해요",
  "sub": "비교하려는 물의 종류만 다르게, 나머지는 같게"
 },
 {
  "t": 75.13,
  "end": 83.0,
  "section": "실험해요",
  "sub": "증발 접시에 스포이트로 1 mL씩 같은 양을 넣어요"
 },
 {
  "t": 83.0,
  "end": 90.2,
  "section": "실험해요",
  "sub": "끓임쪽을 같은 개수만큼 넣어요"
 },
 {
  "t": 90.2,
  "end": 96.23,
  "section": "실험해요",
  "sub": "핫플레이트에 올려 두 접시를 동시에 가열해요"
 },
 {
  "t": 96.23,
  "end": 105.93,
  "section": "실험해요",
  "sub": "멀리서 관찰하고, 뜨거운 접시는 만지지 않아요"
 },
 {
  "t": 105.93,
  "end": 112.13,
  "section": "실험해요",
  "sub": "물이 모두 없어지면 접시 안에 무엇이 남을까요?"
 },
 {
  "t": 112.13,
  "end": 118.53,
  "section": "실험해요",
  "sub": "무엇이 남았을까요?"
 },
 {
  "t": 118.53,
  "end": 127.0,
  "section": "결과",
  "sub": "바닷물 접시에만 흰색 가루 물질이 남았어요"
 },
 {
  "t": 127.0,
  "end": 138.67,
  "section": "결과",
  "sub": "바닷물에는 어떤 물질이 녹아 있어요"
 },
 {
  "t": 138.67,
  "end": 141.5,
  "section": "생각 바로잡기",
  "sub": "바닷물에는 소금만 들어 있을까요?"
 },
 {
  "t": 141.5,
  "end": 153.37,
  "section": "생각 바로잡기",
  "sub": "소금이 가장 많지만 여러 가지 물질이 녹아 있어요"
 },
 {
  "t": 153.37,
  "end": 160.37,
  "section": "지구의 물",
  "sub": "지구의 물을 모두 모아 100컵에 나누어 담는다면?"
 },
 {
  "t": 160.37,
  "end": 166.83,
  "section": "지구의 물",
  "sub": "몇 컵이 바닷물일까요?"
 },
 {
  "t": 166.83,
  "end": 173.33,
  "section": "지구의 물",
  "sub": "100컵 가운데 약 97컵이 바닷물이에요"
 },
 {
  "t": 173.33,
  "end": 181.1,
  "section": "지구의 물",
  "sub": "육지의 물은 빙하가 가장 많고, 지하수·강·호수에도 있어요"
 },
 {
  "t": 181.1,
  "end": 186.32,
  "section": "마무리",
  "sub": "육지의 물과 달리 바닷물에는 소금과 같은 여러 가지 물질이 녹아 있어요"
 },
 {
  "t": 186.32,
  "end": 193.57,
  "section": "마무리",
  "sub": "다음 영상: 3학년 27화 · 바닷가에는 어떤 지형이 있을까?"
 }
