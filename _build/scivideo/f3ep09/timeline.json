[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「처음 배우는 과학」 3학년 9화: 동물의 특징을 본뜬 생활용품"
 },
 {
  "t": 5.47,
  "end": 10.2,
  "section": "궁금해요",
  "sub": "동물의 특징을 하나 가질 수 있다면?"
 },
 {
  "t": 10.2,
  "end": 14.2,
  "section": "궁금해요",
  "sub": "나라면 어떤 특징을 고를까요?"
 },
 {
  "t": 14.2,
  "end": 23.6,
  "section": "궁금해요",
  "sub": "우리는 동물의 특징을 이용한 생활용품을 써요"
 },
 {
  "t": 23.6,
  "end": 26.33,
  "section": "새 낱말",
  "sub": "이것은 흡착판이에요"
 },
 {
  "t": 26.33,
  "end": 29.4,
  "section": "새 낱말",
  "sub": "흡착판은 둥글고 오목한 모양이에요"
 },
 {
  "t": 29.4,
  "end": 33.27,
  "section": "관찰해요",
  "sub": "거울에 눌러 붙였다가 잡아당겨 봐요"
 },
 {
  "t": 33.27,
  "end": 37.27,
  "section": "관찰해요",
  "sub": "어떻게 될까요?"
 },
 {
  "t": 37.27,
  "end": 43.07,
  "section": "관찰해요",
  "sub": "잡아당겨도 잘 떨어지지 않아요 — 거울이나 벽에 잘 붙어요"
 },
 {
  "t": 43.07,
  "end": 46.27,
  "section": "관찰해요",
  "sub": "손에 끼는 물놀이용 물갈퀴예요"
 },
 {
  "t": 46.27,
  "end": 49.87,
  "section": "관찰해요",
  "sub": "손가락 사이가 막으로 이어져 있어요"
 },
 {
  "t": 49.87,
  "end": 56.2,
  "section": "관찰해요",
  "sub": "같은 힘으로 물을 저어 헤엄쳐 봐요"
 },
 {
  "t": 56.2,
  "end": 62.4,
  "section": "관찰해요",
  "sub": "어느 손이 먼저 도착할까요?"
 },
 {
  "t": 62.4,
  "end": 65.27,
  "section": "관찰해요",
  "sub": "물갈퀴를 낀 손이 먼저 도착했어요"
 },
 {
  "t": 65.27,
  "end": 75.0,
  "section": "관찰해요",
  "sub": "물을 더 많이 밀어 내 빠르게 헤엄칠 때 써요"
 },
 {
  "t": 75.0,
  "end": 79.87,
  "section": "생각해요",
  "sub": "흡착판과 물갈퀴는 어떤 동물의 특징을 이용했을까요?"
 },
 {
  "t": 79.87,
  "end": 84.87,
  "section": "생각해요",
  "sub": "어떤 동물의 특징을 이용했을까요?"
 },
 {
  "t": 84.87,
  "end": 91.2,
  "section": "생각해요",
  "sub": "흡착판은 문어의 빨판을 이용했어요"
 },
 {
  "t": 91.2,
  "end": 99.93,
  "section": "생각해요",
  "sub": "물놀이용 물갈퀴는 개구리의 발을 이용했어요"
 },
 {
  "t": 99.93,
  "end": 106.0,
  "section": "조사해요",
  "sub": "동물의 생김새를 이용한 다른 생활용품도 조사해요"
 },
 {
  "t": 106.0,
  "end": 113.07,
  "section": "조사해요",
  "sub": "먹이를 놓치지 않는 수리 발 → 집게 차"
 },
 {
  "t": 113.07,
  "end": 120.93,
  "section": "조사해요",
  "sub": "벽에 잘 붙는 도마뱀부치 발 → 접착테이프"
 },
 {
  "t": 120.93,
  "end": 128.0,
  "section": "조사해요",
  "sub": "미끄러지지 않는 산양 발굽 → 등산화"
 },
 {
  "t": 128.0,
  "end": 133.67,
  "section": "교과서 속 예",
  "sub": "땅을 잘 파는 두더지 앞다리 → 굴착기"
 },
 {
  "t": 133.67,
  "end": 141.47,
  "section": "교과서 속 예",
  "sub": "부드러운 곡선 모양의 산천어 → 고속 열차"
 },
 {
  "t": 141.47,
  "end": 153.07,
  "section": "교과서 속 예",
  "sub": "가늘고 긴 뱀 → 탐색구조 로봇"
 },
 {
  "t": 153.07,
  "end": 156.6,
  "section": "생각해요",
  "sub": "동물의 특징을 이용하면 어떤 점이 좋을까요?"
 },
 {
  "t": 156.6,
  "end": 160.6,
  "section": "생각해요",
  "sub": "알맞은 것은 어느 것일까요?"
 },
 {
  "t": 160.6,
  "end": 165.47,
  "section": "생각해요",
  "sub": "우리 생활을 편리하게 해 줘요"
 },
 {
  "t": 165.47,
  "end": 171.2,
  "section": "생각해요",
  "sub": "동물을 잡는 것이 아니라 생김새를 본떠 만들어요"
 },
 {
  "t": 171.2,
  "end": 176.4,
  "section": "정리해요",
  "sub": "동물의 특징과 그 특징을 이용한 생활용품을 정리해요"
 },
 {
  "t": 176.4,
  "end": 185.53,
  "section": "정리해요",
  "sub": "짝을 하나씩 읽어 봐요"
 },
 {
  "t": 185.53,
  "end": 191.0,
  "section": "정리해요",
  "sub": "흡착판은 문어 빨판의 특징을 이용했어요"
 },
 {
  "t": 191.0,
  "end": 196.4,
  "section": "정리해요",
  "sub": "하늘을 나는 로봇에는 어떤 동물의 특징을 이용할까요?"
 },
 {
  "t": 196.4,
  "end": 201.4,
  "section": "정리해요",
  "sub": "어떤 동물의 특징을 이용할까요?"
 },
 {
  "t": 201.4,
  "end": 209.67,
  "section": "정리해요",
  "sub": "예) 하늘을 날아다니는 새 날개의 특징을 이용해요"
 },
 {
  "t": 209.67,
  "end": 215.2,
  "section": "확인해요",
  "sub": "문어 빨판의 특징을 이용한 생활용품은?"
 },
 {
  "t": 215.2,
  "end": 221.2,
  "section": "확인해요",
  "sub": "몇 번일까요?"
 },
 {
  "t": 221.2,
  "end": 228.53,
  "section": "확인해요",
  "sub": "정답은 ② 흡착판이에요"
 },
 {
  "t": 228.53,
  "end": 233.27,
  "section": "확인해요",
  "sub": "굴착기를 만드는 데 이용한 동물의 이름과 특징은?"
 },
 {
  "t": 233.27,
  "end": 238.27,
  "section": "확인해요",
  "sub": "동물의 이름과 특징을 말해 봐요"
 },
 {
  "t": 238.27,
  "end": 244.93,
  "section": "확인해요",
  "sub": "두더지의 땅을 잘 파는 앞다리를 이용했어요"
 },
 {
  "t": 244.93,
  "end": 251.67,
  "section": "확인해요",
  "sub": "맞으면 ○, 틀리면 ×를 골라요"
 },
 {
  "t": 251.67,
  "end": 256.2,
  "section": "확인해요",
  "sub": "○일까요, ×일까요?"
 },
 {
  "t": 256.2,
  "end": 263.0,
  "section": "확인해요",
  "sub": "× — 고속 열차는 산천어의 생김새를 이용했어요"
 },
 {
  "t": 263.0,
  "end": 267.5,
  "section": "마무리",
  "sub": "사람들은 동물의 특징을 이용해 생활용품을 만들어 우리 생활을 편리하게 해요"
 },
 {
  "t": 267.5,
  "end": 273.47,
  "section": "마무리",
  "sub": "다음 영상: 처음 배우는 과학 3학년 10화 · 잎으로 식물을 분류해요"
 }
