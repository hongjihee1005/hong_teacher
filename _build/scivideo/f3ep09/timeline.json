[
 {
  "t": 0.0,
  "end": 7.0,
  "section": "오프닝",
  "sub": "「처음 배우는 과학」 3학년 9화: 동물의 특징을 본뜬 생활용품"
 },
 {
  "t": 7.0,
  "end": 12.7,
  "section": "궁금해요",
  "sub": "동물의 특징을 하나 가질 수 있다면?"
 },
 {
  "t": 12.7,
  "end": 17.67,
  "section": "궁금해요",
  "sub": "나라면 어떤 특징을 고를까요?"
 },
 {
  "t": 17.67,
  "end": 28.1,
  "section": "궁금해요",
  "sub": "우리는 동물의 특징을 이용한 생활용품을 써요"
 },
 {
  "t": 28.1,
  "end": 32.13,
  "section": "새 낱말",
  "sub": "이것은 흡착판이에요"
 },
 {
  "t": 32.13,
  "end": 35.4,
  "section": "새 낱말",
  "sub": "흡착판은 둥글고 오목한 모양이에요"
 },
 {
  "t": 35.4,
  "end": 40.4,
  "section": "관찰해요",
  "sub": "거울에 눌러 붙였다가 잡아당겨 봐요"
 },
 {
  "t": 40.4,
  "end": 45.37,
  "section": "관찰해요",
  "sub": "어떻게 될까요?"
 },
 {
  "t": 45.37,
  "end": 52.4,
  "section": "관찰해요",
  "sub": "잡아당겨도 잘 떨어지지 않아요 — 거울이나 벽에 잘 붙어요"
 },
 {
  "t": 52.4,
  "end": 55.8,
  "section": "관찰해요",
  "sub": "손에 끼는 물놀이용 물갈퀴예요"
 },
 {
  "t": 55.8,
  "end": 59.43,
  "section": "관찰해요",
  "sub": "손가락 사이가 막으로 이어져 있어요"
 },
 {
  "t": 59.43,
  "end": 68.0,
  "section": "관찰해요",
  "sub": "같은 힘으로 물을 저어 헤엄쳐 봐요"
 },
 {
  "t": 68.0,
  "end": 75.17,
  "section": "관찰해요",
  "sub": "어느 손이 먼저 도착할까요?"
 },
 {
  "t": 75.17,
  "end": 78.37,
  "section": "관찰해요",
  "sub": "물갈퀴를 낀 손이 먼저 도착했어요"
 },
 {
  "t": 78.37,
  "end": 88.87,
  "section": "관찰해요",
  "sub": "물을 더 많이 밀어 내 빠르게 헤엄칠 때 써요"
 },
 {
  "t": 88.87,
  "end": 94.17,
  "section": "생각해요",
  "sub": "흡착판과 물갈퀴는 어떤 동물의 특징을 이용했을까요?"
 },
 {
  "t": 94.17,
  "end": 99.17,
  "section": "생각해요",
  "sub": "어떤 동물의 특징을 이용했을까요?"
 },
 {
  "t": 99.17,
  "end": 106.97,
  "section": "생각해요",
  "sub": "흡착판은 문어의 빨판을 이용했어요"
 },
 {
  "t": 106.97,
  "end": 115.73,
  "section": "생각해요",
  "sub": "물놀이용 물갈퀴는 개구리의 발을 이용했어요"
 },
 {
  "t": 115.73,
  "end": 122.73,
  "section": "조사해요",
  "sub": "동물의 생김새를 이용한 다른 생활용품도 조사해요"
 },
 {
  "t": 122.73,
  "end": 130.7,
  "section": "조사해요",
  "sub": "먹이를 놓치지 않는 수리 발 → 집게 차"
 },
 {
  "t": 130.7,
  "end": 140.0,
  "section": "조사해요",
  "sub": "벽에 잘 붙는 도마뱀부치 발 → 접착테이프"
 },
 {
  "t": 140.0,
  "end": 147.13,
  "section": "조사해요",
  "sub": "미끄러지지 않는 산양 발굽 → 등산화"
 },
 {
  "t": 147.13,
  "end": 152.97,
  "section": "교과서 속 예",
  "sub": "땅을 잘 파는 두더지 앞다리 → 굴착기"
 },
 {
  "t": 152.97,
  "end": 161.83,
  "section": "교과서 속 예",
  "sub": "부드러운 곡선 모양의 산천어 → 고속 열차"
 },
 {
  "t": 161.83,
  "end": 174.33,
  "section": "교과서 속 예",
  "sub": "가늘고 긴 뱀 → 탐색구조 로봇"
 },
 {
  "t": 174.33,
  "end": 178.1,
  "section": "생각해요",
  "sub": "동물의 특징을 이용하면 어떤 점이 좋을까요?"
 },
 {
  "t": 178.1,
  "end": 183.07,
  "section": "생각해요",
  "sub": "알맞은 것은 어느 것일까요?"
 },
 {
  "t": 183.07,
  "end": 187.93,
  "section": "생각해요",
  "sub": "우리 생활을 편리하게 해 줘요"
 },
 {
  "t": 187.93,
  "end": 194.57,
  "section": "생각해요",
  "sub": "동물을 잡는 것이 아니라 생김새를 본떠 만들어요"
 },
 {
  "t": 194.57,
  "end": 200.2,
  "section": "정리해요",
  "sub": "동물의 특징과 그 특징을 이용한 생활용품을 정리해요"
 },
 {
  "t": 200.2,
  "end": 212.9,
  "section": "정리해요",
  "sub": "짝을 하나씩 읽어 봐요"
 },
 {
  "t": 212.9,
  "end": 219.33,
  "section": "정리해요",
  "sub": "흡착판은 문어 빨판의 특징을 이용했어요"
 },
 {
  "t": 219.33,
  "end": 224.73,
  "section": "정리해요",
  "sub": "하늘을 나는 로봇에는 어떤 동물의 특징을 이용할까요?"
 },
 {
  "t": 224.73,
  "end": 229.73,
  "section": "정리해요",
  "sub": "어떤 동물의 특징을 이용할까요?"
 },
 {
  "t": 229.73,
  "end": 238.63,
  "section": "정리해요",
  "sub": "예) 하늘을 날아다니는 새 날개의 특징을 이용해요"
 },
 {
  "t": 238.63,
  "end": 244.33,
  "section": "확인해요",
  "sub": "문어 빨판의 특징을 이용한 생활용품은?"
 },
 {
  "t": 244.33,
  "end": 250.33,
  "section": "확인해요",
  "sub": "몇 번일까요?"
 },
 {
  "t": 250.33,
  "end": 259.23,
  "section": "확인해요",
  "sub": "정답은 ② 흡착판이에요"
 },
 {
  "t": 259.23,
  "end": 264.2,
  "section": "확인해요",
  "sub": "굴착기를 만드는 데 이용한 동물의 이름과 특징은?"
 },
 {
  "t": 264.2,
  "end": 269.2,
  "section": "확인해요",
  "sub": "동물의 이름과 특징을 말해 봐요"
 },
 {
  "t": 269.2,
  "end": 276.63,
  "section": "확인해요",
  "sub": "두더지의 땅을 잘 파는 앞다리를 이용했어요"
 },
 {
  "t": 276.63,
  "end": 285.03,
  "section": "확인해요",
  "sub": "맞으면 ○, 틀리면 ×를 골라요"
 },
 {
  "t": 285.03,
  "end": 290.5,
  "section": "확인해요",
  "sub": "○일까요, ×일까요?"
 },
 {
  "t": 290.5,
  "end": 298.23,
  "section": "확인해요",
  "sub": "× — 고속 열차는 산천어의 생김새를 이용했어요"
 },
 {
  "t": 298.23,
  "end": 304.27,
  "section": "마무리",
  "sub": "사람들은 동물의 특징을 이용해 생활용품을 만들어 우리 생활을 편리하게 해요"
 },
 {
  "t": 304.27,
  "end": 312.1,
  "section": "마무리",
  "sub": "다음 영상: 처음 배우는 과학 3학년 10화 · 잎으로 식물을 분류해요"
