[
 {
  "t": 0.0,
  "end": 6.73,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 7화: 물에 사는 동물과 물갈퀴"
 },
 {
  "t": 6.73,
  "end": 10.87,
  "section": "궁금해요",
  "sub": "물고기는 어떻게 물속에서 빠르게 움직일까요?"
 },
 {
  "t": 10.87,
  "end": 15.87,
  "section": "궁금해요",
  "sub": "물고기가 빠르게 움직이는 까닭은?"
 },
 {
  "t": 15.87,
  "end": 18.13,
  "section": "궁금해요",
  "sub": "몸에 지느러미가 있어서요"
 },
 {
  "t": 18.13,
  "end": 22.77,
  "section": "궁금해요",
  "sub": "몸이 부드러운 곡선 모양이라서요"
 },
 {
  "t": 22.77,
  "end": 31.03,
  "section": "궁금해요",
  "sub": "그럼 물갈퀴가 있는 발은 어떤 점이 좋을까요?"
 },
 {
  "t": 31.03,
  "end": 38.03,
  "section": "실험해요",
  "sub": "물이 담긴 수조에 페트병 뚜껑을 띄워요"
 },
 {
  "t": 38.03,
  "end": 47.07,
  "section": "실험해요",
  "sub": "㈎ 부챗살을 펼쳐 물속에서 저어요"
 },
 {
  "t": 47.07,
  "end": 52.27,
  "section": "실험해요",
  "sub": "물이 조금 출렁이고 뚜껑이 조금 움직여요"
 },
 {
  "t": 52.27,
  "end": 61.77,
  "section": "실험해요",
  "sub": "㈏ 부챗살에 테이프를 붙여 물갈퀴처럼 만들어요"
 },
 {
  "t": 61.77,
  "end": 66.9,
  "section": "실험해요",
  "sub": "같은 힘으로 저으면 어떻게 될까요?"
 },
 {
  "t": 66.9,
  "end": 74.4,
  "section": "실험해요",
  "sub": "뚜껑이 더 많이 움직이는 것은 ㈎? ㈏?"
 },
 {
  "t": 74.4,
  "end": 82.13,
  "section": "실험해요",
  "sub": "물이 많이 출렁이고 뚜껑이 훨씬 많이 움직여요"
 },
 {
  "t": 82.13,
  "end": 90.27,
  "section": "실험해요",
  "sub": "너무 세게 저으면 물이 튀어요 — 튄 물은 닦아요"
 },
 {
  "t": 90.27,
  "end": 92.77,
  "section": "정리해요",
  "sub": "실험 결과를 정리해요"
 },
 {
  "t": 92.77,
  "end": 98.87,
  "section": "정리해요",
  "sub": "물갈퀴가 있으면 물을 더 많이 밀어 내 빠르게 움직여요"
 },
 {
  "t": 98.87,
  "end": 112.1,
  "section": "정리해요",
  "sub": "개구리·오리·수달·바다거북도 발로 헤엄쳐요"
 },
 {
  "t": 112.1,
  "end": 116.77,
  "section": "조사해요",
  "sub": "강·호수와 갯벌·바다에 사는 동물을 조사해요"
 },
 {
  "t": 116.77,
  "end": 125.4,
  "section": "조사해요",
  "sub": "붕어는 지느러미, 수달은 물갈퀴 발로 헤엄쳐요"
 },
 {
  "t": 125.4,
  "end": 132.53,
  "section": "조사해요",
  "sub": "물방개는 다리로 헤엄치고, 다슬기는 기어다녀요"
 },
 {
  "t": 132.53,
  "end": 145.3,
  "section": "조사해요",
  "sub": "농게는 걷고, 돌고래는 헤엄치고, 조개는 기어다니고, 따개비는 붙어 살아요"
 },
 {
  "t": 145.3,
  "end": 155.2,
  "section": "정리해요",
  "sub": "물에 사는 동물은 물에서 살기에 알맞은 생김새를 가졌어요"
 },
 {
  "t": 155.2,
  "end": 159.8,
  "section": "정리해요",
  "sub": "개구리·수달은 물갈퀴가 있는 발로 헤엄쳐요"
 },
 {
  "t": 159.8,
  "end": 167.57,
  "section": "정리해요",
  "sub": "고등어·돌고래는 곡선 모양 몸과 지느러미가 있어요"
 },
 {
  "t": 167.57,
  "end": 175.1,
  "section": "확인해요",
  "sub": "땅과 물을 오가며, 물갈퀴 발로 헤엄치는 동물은?"
 },
 {
  "t": 175.1,
  "end": 181.1,
  "section": "확인해요",
  "sub": "어느 동물일까요?"
 },
 {
  "t": 181.1,
  "end": 184.0,
  "section": "확인해요",
  "sub": "정답은 ③ 수달이에요"
 },
 {
  "t": 184.0,
  "end": 189.39,
  "section": "마무리",
  "sub": "물갈퀴가 있는 발은 물을 더 많이 밀어 내 물속에서 빠르게 움직일 수 있어요"
 },
 {
  "t": 189.39,
  "end": 196.23,
  "section": "마무리",
  "sub": "다음 영상: 3학년 8화 · 극지방과 사막에 사는 동물"
 }
