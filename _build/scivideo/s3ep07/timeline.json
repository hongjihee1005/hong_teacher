[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 7화: 물에 사는 동물과 물갈퀴"
 },
 {
  "t": 5.5,
  "end": 9.73,
  "section": "궁금해요",
  "sub": "물고기는 어떻게 물속에서 빠르게 움직일까요?"
 },
 {
  "t": 9.73,
  "end": 14.73,
  "section": "궁금해요",
  "sub": "물고기가 빠르게 움직이는 까닭은?"
 },
 {
  "t": 14.73,
  "end": 17.13,
  "section": "궁금해요",
  "sub": "몸에 지느러미가 있어서요"
 },
 {
  "t": 17.13,
  "end": 22.0,
  "section": "궁금해요",
  "sub": "몸이 부드러운 곡선 모양이라서요"
 },
 {
  "t": 22.0,
  "end": 29.73,
  "section": "궁금해요",
  "sub": "그럼 물갈퀴가 있는 발은 어떤 점이 좋을까요?"
 },
 {
  "t": 29.73,
  "end": 36.27,
  "section": "실험해요",
  "sub": "물이 담긴 수조에 페트병 뚜껑을 띄워요"
 },
 {
  "t": 36.27,
  "end": 44.0,
  "section": "실험해요",
  "sub": "㈎ 부챗살을 펼쳐 물속에서 저어요"
 },
 {
  "t": 44.0,
  "end": 48.4,
  "section": "실험해요",
  "sub": "물이 조금 출렁이고 뚜껑이 조금 움직여요"
 },
 {
  "t": 48.4,
  "end": 56.8,
  "section": "실험해요",
  "sub": "㈏ 부챗살에 테이프를 붙여 물갈퀴처럼 만들어요"
 },
 {
  "t": 56.8,
  "end": 61.87,
  "section": "실험해요",
  "sub": "같은 힘으로 저으면 어떻게 될까요?"
 },
 {
  "t": 61.87,
  "end": 69.37,
  "section": "실험해요",
  "sub": "뚜껑이 더 많이 움직이는 것은 ㈎? ㈏?"
 },
 {
  "t": 69.37,
  "end": 75.6,
  "section": "실험해요",
  "sub": "물이 많이 출렁이고 뚜껑이 훨씬 많이 움직여요"
 },
 {
  "t": 75.6,
  "end": 83.37,
  "section": "실험해요",
  "sub": "너무 세게 저으면 물이 튀어요 — 튄 물은 닦아요"
 },
 {
  "t": 83.37,
  "end": 85.77,
  "section": "정리해요",
  "sub": "실험 결과를 정리해요"
 },
 {
  "t": 85.77,
  "end": 92.17,
  "section": "정리해요",
  "sub": "물갈퀴가 있으면 물을 더 많이 밀어 내 빠르게 움직여요"
 },
 {
  "t": 92.17,
  "end": 104.27,
  "section": "정리해요",
  "sub": "개구리·오리·수달·바다거북도 발로 헤엄쳐요"
 },
 {
  "t": 104.27,
  "end": 108.67,
  "section": "조사해요",
  "sub": "강·호수와 갯벌·바다에 사는 동물을 조사해요"
 },
 {
  "t": 108.67,
  "end": 117.07,
  "section": "조사해요",
  "sub": "붕어는 지느러미, 수달은 물갈퀴 발로 헤엄쳐요"
 },
 {
  "t": 117.07,
  "end": 123.8,
  "section": "조사해요",
  "sub": "물방개는 다리로 헤엄치고, 다슬기는 기어다녀요"
 },
 {
  "t": 123.8,
  "end": 135.07,
  "section": "조사해요",
  "sub": "농게는 걷고, 돌고래는 헤엄치고, 조개는 기어다니고, 따개비는 붙어 살아요"
 },
 {
  "t": 135.07,
  "end": 144.63,
  "section": "정리해요",
  "sub": "물에 사는 동물은 물에서 살기에 알맞은 생김새를 가졌어요"
 },
 {
  "t": 144.63,
  "end": 149.5,
  "section": "정리해요",
  "sub": "개구리·수달은 물갈퀴가 있는 발로 헤엄쳐요"
 },
 {
  "t": 149.5,
  "end": 157.77,
  "section": "정리해요",
  "sub": "고등어·돌고래는 곡선 모양 몸과 지느러미가 있어요"
 },
 {
  "t": 157.77,
  "end": 164.67,
  "section": "확인해요",
  "sub": "땅과 물을 오가며, 물갈퀴 발로 헤엄치는 동물은?"
 },
 {
  "t": 164.67,
  "end": 170.67,
  "section": "확인해요",
  "sub": "어느 동물일까요?"
 },
 {
  "t": 170.67,
  "end": 173.5,
  "section": "확인해요",
  "sub": "정답은 ③ 수달이에요"
 },
 {
  "t": 173.5,
  "end": 178.0,
  "section": "마무리",
  "sub": "물갈퀴가 있는 발은 물을 더 많이 밀어 내 물속에서 빠르게 움직일 수 있어요"
 },
 {
  "t": 178.0,
  "end": 184.0,
