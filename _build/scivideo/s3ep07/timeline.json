[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 7화: 물에 사는 동물과 물갈퀴"
 },
 {
  "t": 5.47,
  "end": 9.67,
  "section": "궁금해요",
  "sub": "물고기는 어떻게 물속에서 빠르게 움직일까요?"
 },
 {
  "t": 9.67,
  "end": 14.67,
  "section": "궁금해요",
  "sub": "물고기가 빠르게 움직이는 까닭은?"
 },
 {
  "t": 14.67,
  "end": 17.07,
  "section": "궁금해요",
  "sub": "몸에 지느러미가 있어서요"
 },
 {
  "t": 17.07,
  "end": 21.93,
  "section": "궁금해요",
  "sub": "몸이 부드러운 곡선 모양이라서요"
 },
 {
  "t": 21.93,
  "end": 29.67,
  "section": "궁금해요",
  "sub": "그럼 물갈퀴가 있는 발은 어떤 점이 좋을까요?"
 },
 {
  "t": 29.67,
  "end": 36.2,
  "section": "실험해요",
  "sub": "물이 담긴 수조에 페트병 뚜껑을 띄워요"
 },
 {
  "t": 36.2,
  "end": 43.87,
  "section": "실험해요",
  "sub": "㈎ 부챗살을 펼쳐 물속에서 저어요"
 },
 {
  "t": 43.87,
  "end": 48.27,
  "section": "실험해요",
  "sub": "물이 조금 출렁이고 뚜껑이 조금 움직여요"
 },
 {
  "t": 48.27,
  "end": 56.6,
  "section": "실험해요",
  "sub": "㈏ 부챗살에 테이프를 붙여 물갈퀴처럼 만들어요"
 },
 {
  "t": 56.6,
  "end": 61.6,
  "section": "실험해요",
  "sub": "같은 힘으로 저으면 어떻게 될까요?"
 },
 {
  "t": 61.6,
  "end": 69.13,
  "section": "실험해요",
  "sub": "뚜껑이 더 많이 움직이는 것은 ㈎? ㈏?"
 },
 {
  "t": 69.13,
  "end": 75.33,
  "section": "실험해요",
  "sub": "물이 많이 출렁이고 뚜껑이 훨씬 많이 움직여요"
 },
 {
  "t": 75.33,
  "end": 83.07,
  "section": "실험해요",
  "sub": "너무 세게 저으면 물이 튀어요 — 튄 물은 닦아요"
 },
 {
  "t": 83.07,
  "end": 85.47,
  "section": "정리해요",
  "sub": "실험 결과를 정리해요"
 },
 {
  "t": 85.47,
  "end": 91.87,
  "section": "정리해요",
  "sub": "물갈퀴가 있으면 물을 더 많이 밀어 내 빠르게 움직여요"
 },
 {
  "t": 91.87,
  "end": 103.93,
  "section": "정리해요",
  "sub": "개구리·오리·수달·바다거북도 발로 헤엄쳐요"
 },
 {
  "t": 103.93,
  "end": 108.33,
  "section": "조사해요",
  "sub": "강·호수와 갯벌·바다에 사는 동물을 조사해요"
 },
 {
  "t": 108.33,
  "end": 116.73,
  "section": "조사해요",
  "sub": "붕어는 지느러미, 수달은 물갈퀴 발로 헤엄쳐요"
 },
 {
  "t": 116.73,
  "end": 123.47,
  "section": "조사해요",
  "sub": "물방개는 다리로 헤엄치고, 다슬기는 기어다녀요"
 },
 {
  "t": 123.47,
  "end": 134.73,
  "section": "조사해요",
  "sub": "농게는 걷고, 돌고래는 헤엄치고, 조개는 기어다니고, 따개비는 붙어 살아요"
 },
 {
  "t": 134.73,
  "end": 144.27,
  "section": "정리해요",
  "sub": "물에 사는 동물은 물에서 살기에 알맞은 생김새를 가졌어요"
 },
 {
  "t": 144.27,
  "end": 149.13,
  "section": "정리해요",
  "sub": "개구리·수달은 물갈퀴가 있는 발로 헤엄쳐요"
 },
 {
  "t": 149.13,
  "end": 157.4,
  "section": "정리해요",
  "sub": "고등어·돌고래는 곡선 모양 몸과 지느러미가 있어요"
 },
 {
  "t": 157.4,
  "end": 164.27,
  "section": "확인해요",
  "sub": "땅과 물을 오가며, 물갈퀴 발로 헤엄치는 동물은?"
 },
 {
  "t": 164.27,
  "end": 170.27,
  "section": "확인해요",
  "sub": "어느 동물일까요?"
 },
 {
  "t": 170.27,
  "end": 173.07,
  "section": "확인해요",
  "sub": "정답은 ③ 수달이에요"
 },
 {
  "t": 173.07,
  "end": 177.57,
  "section": "마무리",
  "sub": "물갈퀴가 있는 발은 물을 더 많이 밀어 내 물속에서 빠르게 움직일 수 있어요"
 },
 {
  "t": 177.57,
  "end": 183.53,
  "section": "마무리",
  "sub": "다음 영상: 3학년 8화 · 극지방과 사막에 사는 동물"
 }
