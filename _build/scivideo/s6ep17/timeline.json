[
 {
  "t": 0.0,
  "end": 5.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 17화: 잎에 도달한 물은?"
 },
 {
  "t": 5.5,
  "end": 10.4,
  "section": "궁금해요",
  "sub": "식물이 많은 온실 안은 밖보다 습할까요, 건조할까요?"
 },
 {
  "t": 10.4,
  "end": 20.67,
  "section": "궁금해요",
  "sub": "온실 안이 더 습해요 — 식물에서 수증기가 나오는 것 같아요"
 },
 {
  "t": 20.67,
  "end": 24.87,
  "section": "염화 코발트 종이",
  "sub": "푸른색 염화 코발트 종이에 물을 한 방울 떨어뜨려요"
 },
 {
  "t": 24.87,
  "end": 34.77,
  "section": "염화 코발트 종이",
  "sub": "물을 흡수하면 붉은색으로 변해요"
 },
 {
  "t": 34.77,
  "end": 42.83,
  "section": "실험해요",
  "sub": "페트리 접시와 잎 뒷면에 종이를 붙이고 햇빛에 10분"
 },
 {
  "t": 42.83,
  "end": 47.83,
  "section": "실험해요",
  "sub": "10분 뒤 두 종이의 색깔은?"
 },
 {
  "t": 47.83,
  "end": 55.57,
  "section": "실험해요",
  "sub": "접시의 종이는 그대로 푸른색, 잎 뒷면의 종이는 붉은색"
 },
 {
  "t": 55.57,
  "end": 64.63,
  "section": "실험해요",
  "sub": "접시 종이는 비교용 — 공기 중의 물 때문이 아니에요"
 },
 {
  "t": 64.63,
  "end": 72.23,
  "section": "실험해요",
  "sub": "잎을 통해 물이 식물 밖으로 빠져나가요"
 },
 {
  "t": 72.23,
  "end": 80.13,
  "section": "기공",
  "sub": "사철나무잎 표피세포에서 본 강낭콩 모양 세포 두 개를 떠올려요"
 },
 {
  "t": 80.13,
  "end": 84.37,
  "section": "기공",
  "sub": "두 세포 사이의 아주 작은 구멍이 기공이에요"
 },
 {
  "t": 84.37,
  "end": 92.47,
  "section": "기공",
  "sub": "기공은 대부분 잎의 뒷면에 있어요 — 그래서 뒷면에 붙였어요"
 },
 {
  "t": 92.47,
  "end": 97.53,
  "section": "증산 작용",
  "sub": "뿌리에서 흡수한 물은 줄기를 거쳐 잎에 도달해요"
 },
 {
  "t": 97.53,
  "end": 105.77,
  "section": "증산 작용",
  "sub": "물의 일부는 수증기가 되어 기공으로 나가요 — 증산 작용"
 },
 {
  "t": 105.77,
  "end": 117.03,
  "section": "증산 작용",
  "sub": "물을 잎까지 끌어올리고, 식물의 온도를 조절해요"
 },
 {
  "t": 117.03,
  "end": 126.43,
  "section": "더 알아보기",
  "sub": "봉선화 세 개에 투명한 비닐봉지를 씌워 햇빛에 두어요"
 },
 {
  "t": 126.43,
  "end": 131.43,
  "section": "더 알아보기",
  "sub": "물방울이 가장 많이 맺힌 것은?"
 },
 {
  "t": 131.43,
  "end": 141.2,
  "section": "더 알아보기",
  "sub": "잎을 그대로 둔 봉선화에 물방울이 가장 많아요"
 },
 {
  "t": 141.2,
  "end": 145.43,
  "section": "생각해요",
  "sub": "사막에 사는 식물의 잎이 좁으면 어떤 점이 좋을까요?"
 },
 {
  "t": 145.43,
  "end": 156.87,
  "section": "생각해요",
  "sub": "잎이 좁으면 빠져나가는 물이 적어 물을 아낄 수 있어요"
 },
 {
  "t": 156.87,
  "end": 164.7,
  "section": "한눈에 쏙",
  "sub": "잎의 물이 수증기로 빠져나가는 것을 증산 작용이라고 해요"
 },
 {
  "t": 164.7,
  "end": 169.2,
  "section": "마무리",
  "sub": "잎에 도달한 물의 일부는 기공을 통해 수증기로 빠져나가요 — 증산 작용"
 },
 {
  "t": 169.2,
  "end": 175.2,
  "section": "마무리",
  "sub": "다음 영상: 6학년 18화 · 꽃의 생김새와 하는 일"
 }
]