[
 {
  "t": 0.0,
  "end": 6.5,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 6학년 22화: 낮과 밤이 생기는 까닭"
 },
 {
  "t": 6.5,
  "end": 11.23,
  "section": "궁금해요",
  "sub": "두 친구가 통화하고 있어요. 다른 점은 무엇일까요?"
 },
 {
  "t": 11.23,
  "end": 17.3,
  "section": "궁금해요",
  "sub": "한 친구가 있는 곳은 낮, 다른 친구가 있는 곳은 밤이에요"
 },
 {
  "t": 17.3,
  "end": 28.4,
  "section": "궁금해요",
  "sub": "낮과 밤은 태양이 뜨고 지는 것으로 구분해요"
 },
 {
  "t": 28.4,
  "end": 35.07,
  "section": "실험 준비",
  "sub": "지구본·소형 카메라·갓 없는 전등·자·스마트 기기를 준비해요"
 },
 {
  "t": 35.07,
  "end": 42.9,
  "section": "실험 준비",
  "sub": "우리나라에 붙인 카메라는 지구에 있는 관측자 역할"
 },
 {
  "t": 42.9,
  "end": 52.0,
  "section": "실험 준비",
  "sub": "전등의 중심 높이를 지구본의 중심 높이와 같게 맞춰요"
 },
 {
  "t": 52.0,
  "end": 60.17,
  "section": "실험해요",
  "sub": "주변을 어둡게 하고 지구본을 서쪽에서 동쪽으로 돌려요"
 },
 {
  "t": 60.17,
  "end": 65.7,
  "section": "실험해요",
  "sub": "카메라가 전등 반대편을 향할 때: 어두워요"
 },
 {
  "t": 65.7,
  "end": 69.77,
  "section": "실험해요",
  "sub": "30°씩 돌려 한 바퀴 돌려요"
 },
 {
  "t": 69.77,
  "end": 77.5,
  "section": "실험해요",
  "sub": "카메라가 전등을 향할 때: 밝아요"
 },
 {
  "t": 77.5,
  "end": 81.87,
  "section": "실험해요",
  "sub": "다시 전등 반대편을 향하면: 어두워요"
 },
 {
  "t": 81.87,
  "end": 88.07,
  "section": "실험해요",
  "sub": "언제 밝고 언제 어두웠나요?"
 },
 {
  "t": 88.07,
  "end": 97.07,
  "section": "결과 정리",
  "sub": "전등 빛을 받으면 밝아서 낮, 받지 못하면 어두워서 밤"
 },
 {
  "t": 97.07,
  "end": 106.07,
  "section": "결과 정리",
  "sub": "태양이 지구 주위를 도는 게 아니라 지구가 자전하기 때문이에요"
 },
 {
  "t": 106.07,
  "end": 110.0,
  "section": "낮과 밤",
  "sub": "우리나라가 태양을 향하면 태양 빛을 받아 낮"
 },
 {
  "t": 110.0,
  "end": 117.77,
  "section": "낮과 밤",
  "sub": "자전하며 태양 반대편으로 돌아가면 밤"
 },
 {
  "t": 117.77,
  "end": 129.77,
  "section": "낮과 밤",
  "sub": "다시 태양 쪽으로 오면 낮 — 하루에 한 번씩 번갈아요"
 },
 {
  "t": 129.77,
  "end": 133.17,
  "section": "생각해요",
  "sub": "우리나라에서 가장 먼저 낮이 시작되는 곳은?"
 },
 {
  "t": 133.17,
  "end": 141.17,
  "section": "생각해요",
  "sub": "가장 동쪽에 있는 곳 — 태양은 동쪽에서 떠요"
 },
 {
  "t": 141.17,
  "end": 145.73,
  "section": "생각해요",
  "sub": "만약 지구가 자전하지 않는다면?"
 },
 {
  "t": 145.73,
  "end": 155.13,
  "section": "생각해요",
  "sub": "낮과 밤이 번갈아 나타나지 않아요"
 },
 {
  "t": 155.13,
  "end": 162.43,
  "section": "한눈에 쏙",
  "sub": "태양을 향하면 낮, 반대편을 향하면 밤"
 },
 {
  "t": 162.43,
  "end": 166.87,
  "section": "확인해요",
  "sub": "옳지 않게 말한 친구는 누구일까요?"
 },
 {
  "t": 166.87,
  "end": 171.53,
  "section": "확인해요",
  "sub": "옳지 않게 말한 친구는?"
 },
 {
  "t": 171.53,
  "end": 179.73,
  "section": "확인해요",
  "sub": "친구 3 — 지구는 하루에 한 바퀴 자전하니 하루에 한 번씩"
 },
 {
  "t": 179.73,
  "end": 185.96,
  "section": "마무리",
  "sub": "지구가 자전하면서 태양 빛을 받는 곳은 낮, 받지 못하는 곳은 밤이 돼요"
 },
 {
  "t": 185.96,
  "end": 192.23,
  "section": "마무리",
  "sub": "다음 영상: 6학년 23화 · 지구의 공전"
 }
]