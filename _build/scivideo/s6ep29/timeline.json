 {
  "t": 81.1,
  "end": 92.17,
  "section": "공전시키며 재기",
  "sub": "자전축이 기울어진 채 공전해야 모두 달라져요"
 },
 {
  "t": 92.17,
  "end": 96.1,
  "section": "계절 변화의 원인",
