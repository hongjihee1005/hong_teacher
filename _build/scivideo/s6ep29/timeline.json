 {
  "t": 96.1,
  "end": 101.93,
  "section": "계절 변화의 원인",
  "sub": "남중 고도가 달라지지 않아 계절 변화가 없어요"
 },
 {
  "t": 101.93,
  "end": 106.67,
  "section": "계절 변화의 원인",
