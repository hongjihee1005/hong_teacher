 },
 {
  "t": 132.3,
  "end": 137.57,
  "section": "생각 바로잡기",
  "sub": "이 말은 옳을까요?"
 },
 {
  "t": 137.57,
  "end": 147.07,
  "section": "생각 바로잡기",
  "sub": "옳지 않아요. 여름에 거리는 오히려 조금 더 멀어요"
 },
 {
  "t": 147.07,
  "end": 153.07,
