[
 {
  "t": 0.0,
  "end": 7.37,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 27화: 바닷가에는 어떤 지형이 있을까?"
 },
 {
  "t": 7.37,
  "end": 16.8,
  "section": "궁금해요",
  "sub": "바닷가에서 본 것 중에 기억나는 것이 있나요?"
 },
 {
  "t": 16.8,
  "end": 23.57,
  "section": "궁금해요",
  "sub": "지형은 땅의 생김새예요"
 },
 {
  "t": 23.57,
  "end": 29.17,
  "section": "계획해요",
  "sub": "바닷가 지형을 조사하려면 어떤 검색어가 좋을까요?"
 },
 {
  "t": 29.17,
  "end": 33.83,
  "section": "계획해요",
  "sub": "알맞은 검색어는 무엇일까요?"
 },
 {
  "t": 33.83,
  "end": 47.83,
  "section": "계획해요",
  "sub": "바닷가 지형, 해변, 바닷가 동굴, 바닷가 절벽 같은 검색어가 좋아요"
 },
 {
  "t": 47.83,
  "end": 52.03,
  "section": "조사해요",
  "sub": "바닷가에는 어떤 지형이 있는지 살펴봐요"
 },
 {
  "t": 52.03,
  "end": 57.93,
  "section": "조사해요",
  "sub": "넓은 모래 해변: 고운 모래가 넓고 평평하게 펼쳐져 있어요"
 },
 {
  "t": 57.93,
  "end": 65.83,
  "section": "조사해요",
  "sub": "가파른 절벽: 바위가 벽처럼 가파르고 높게 서 있어요"
 },
 {
  "t": 65.83,
  "end": 71.67,
  "section": "조사해요",
  "sub": "바닷가 동굴: 바위에 굴이 뚫려 바닷물이 드나들어요"
 },
 {
  "t": 71.67,
  "end": 76.63,
  "section": "조사해요",
  "sub": "구멍 뚫린 바위: 가운데에 큰 구멍이 뚫려 건너편이 보여요"
 },
 {
  "t": 76.63,
  "end": 80.93,
  "section": "조사해요",
  "sub": "바위 기둥: 바다 위에 바위가 기둥처럼 우뚝 솟아 있어요"
 },
 {
  "t": 80.93,
  "end": 88.27,
  "section": "조사해요",
  "sub": "갯벌: 썰물 때 드러나는 편평한 땅, 게가 살아요"
 },
 {
  "t": 88.27,
  "end": 95.0,
  "section": "지형 탐정",
  "sub": "파도가 부딪히며 하얀 물보라가 튀는 곳은?"
 },
 {
  "t": 95.0,
  "end": 99.67,
  "section": "지형 탐정",
  "sub": "어떤 지형일까요?"
 },
 {
  "t": 99.67,
  "end": 102.13,
  "section": "지형 탐정",
  "sub": "정답은 가파른 절벽"
 },
 {
  "t": 102.13,
  "end": 108.97,
  "section": "지형 탐정",
  "sub": "바닷물이 굴 안으로 들어갔다가 다시 나오는 곳은?"
 },
 {
  "t": 108.97,
  "end": 115.57,
  "section": "지형 탐정",
  "sub": "물이 빠지자 편평한 땅이 드러나고 게가 나온 곳은?"
 },
 {
  "t": 115.57,
  "end": 124.03,
  "section": "지형 탐정",
  "sub": "가운데가 뚫려 건너편으로 지나가는 배가 보이는 곳은?"
 },
 {
  "t": 124.03,
  "end": 128.73,
  "section": "어디에 있을까?",
  "sub": "교과서 사진 속 지형은 우리나라 어디에 있을까요?"
 },
 {
  "t": 128.73,
  "end": 142.33,
  "section": "어디에 있을까?",
  "sub": "신안군 · 옹진군 · 제주시 · 울릉군"
 },
 {
  "t": 142.33,
  "end": 146.67,
  "section": "확인해요",
  "sub": "바닷가에서 볼 수 있는 모습으로 옳은 것은?"
 },
 {
  "t": 146.67,
  "end": 151.67,
  "section": "확인해요",
  "sub": "옳은 것을 모두 골라요"
 },
 {
  "t": 151.67,
  "end": 156.77,
  "section": "확인해요",
  "sub": "정답은 ㉠, ㉢ — 바닷가 지형은 곳에 따라 모습이 서로 달라요"
 },
 {
  "t": 156.77,
  "end": 164.57,
  "section": "확인해요",
