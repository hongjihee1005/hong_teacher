  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 31화: 큰 소리와 작은 소리"
 },
 {
  "t": 6.43,
  "end": 12.37,
  "section": "궁금해요",
  "sub": "큰 소리와 작은 소리는 언제 낼까요?"
 },
 {
  "t": 12.37,
  "end": 17.37,
  "section": "궁금해요",
  "sub": "큰 소리일까요, 작은 소리일까요?"
 },
 {
  "t": 17.37,
  "end": 25.7,
  "section": "궁금해요",
  "sub": "응원할 때·멀리 부를 때는 큰 소리, 도서관·아기 곁에서는 작은 소리"
 },
 {
  "t": 25.7,
  "end": 34.27,
  "section": "궁금해요",
  "sub": "큰 소리와 작은 소리를 낼 때 떨림은 어떻게 다를까요?"
 },
 {
  "t": 34.27,
  "end": 42.0,
  "section": "글로켄슈필",
  "sub": "글로켄슈필 음판을 채로 쳐서 소리를 내요"
 },
 {
  "t": 42.0,
  "end": 45.03,
  "section": "글로켄슈필",
  "sub": "채를 높이 들어 세게 쳐요"
 },
 {
  "t": 45.03,
  "end": 52.23,
  "section": "글로켄슈필",
  "sub": "측정기 바늘이 많이 움직이고, 음판이 크게 떨려요"
 },
 {
  "t": 52.23,
  "end": 55.87,
  "section": "글로켄슈필",
  "sub": "이번에는 채를 낮게 들어 약하게 쳐요"
 },
 {
  "t": 55.87,
  "end": 61.23,
  "section": "글로켄슈필",
  "sub": "약하게 치면 어떻게 될까요?"
 },
 {
  "t": 61.23,
  "end": 68.87,
  "section": "글로켄슈필",
  "sub": "바늘이 조금 움직이고, 음판이 작게 떨려요"
 },
 {
  "t": 68.87,
  "end": 78.03,
  "section": "글로켄슈필",
  "sub": "음판을 세게 칠수록 크게 떨리고 큰 소리가 나요"
 },
 {
  "t": 78.03,
  "end": 82.6,
  "section": "고무줄",
  "sub": "고무줄을 당기는 높이를 바꾸며 튕겨 봐요"
 },
 {
  "t": 82.6,
  "end": 88.93,
  "section": "고무줄",
  "sub": "세게 튕기면 고무줄이 크게 떨리고 큰 소리가 나요"
 },
 {
  "t": 88.93,
  "end": 96.53,
  "section": "고무줄",
  "sub": "약하게 튕기면 작게 떨리고 작은 소리가 나요"
 },
 {
  "t": 96.53,
  "end": 101.87,
  "section": "공통점",
  "sub": "글로켄슈필과 고무줄, 두 실험의 공통점은?"
 },
 {
  "t": 101.87,
  "end": 106.87,
  "section": "공통점",
  "sub": "두 실험의 공통점은?"
 },
 {
  "t": 106.87,
  "end": 114.77,
  "section": "공통점",
  "sub": "큰 소리 → 크게 떨림, 작은 소리 → 작게 떨림"
 },
 {
  "t": 114.77,
  "end": 120.83,
  "section": "다른 탐구",
  "sub": "작은북 위에 스타이로폼 공을 올리고 쳐 봐요"
 },
 {
  "t": 120.83,
  "end": 128.33,
  "section": "다른 탐구",
  "sub": "세게 치면 큰 소리, 공이 높이 튀어 올라요"
 },
 {
  "t": 128.33,
  "end": 135.37,
  "section": "다른 탐구",
  "sub": "약하게 치면 작은 소리, 공이 조금만 튀어요"
 },
 {
  "t": 135.37,
  "end": 143.67,
  "section": "다른 탐구",
  "sub": "스피커의 음량을 크게, 작게 바꿔 봐요"
 },
 {
  "t": 143.67,
  "end": 151.33,
  "section": "다른 탐구",
  "sub": "북도 스피커도 큰 소리가 날 때 크게 떨려요"
 },
 {
  "t": 151.33,
  "end": 154.8,
  "section": "한눈에 쏙",
  "sub": "소리의 크고 작은 정도 = 소리의 세기"
 },
 {
  "t": 154.8,
  "end": 159.37,
  "section": "한눈에 쏙",
  "sub": "생각+ 트라이앵글로 큰 소리와 작은 소리를 내려면?"
 },
 {
  "t": 159.37,
  "end": 164.03,
  "section": "한눈에 쏙",
  "sub": "어떻게 쳐야 할까요?"
 },
 {
  "t": 164.03,
  "end": 172.63,
  "section": "한눈에 쏙",
  "sub": "큰 소리는 세게, 작은 소리는 약하게 쳐요"
 },
 {
  "t": 172.63,
  "end": 180.37,
  "section": "마무리",
  "sub": "소리의 크고 작은 정도를 소리의 세기라고 해요 세게 치면 큰 소리, 약하게 치면 작은 소리가 나요"
 },
 {
