[
 {
  "t": 0.0,
  "end": 7.2,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 20화: 물체와 물질은 무엇이 다를까?"
 },
 {
  "t": 7.2,
  "end": 12.0,
  "section": "궁금해요",
  "sub": "유리로 만든 어항이에요"
 },
 {
  "t": 12.0,
  "end": 16.33,
  "section": "궁금해요",
  "sub": "어항을 나무로 만들면 어떤 점이 불편할까요?"
 },
 {
  "t": 16.33,
  "end": 21.33,
  "section": "궁금해요",
  "sub": "나무 어항은 무엇이 불편할까요?"
 },
 {
  "t": 21.33,
  "end": 27.23,
  "section": "궁금해요",
  "sub": "안이 보이지 않고, 오래 쓰면 젖어 썩을 수 있어요"
 },
 {
  "t": 27.23,
  "end": 35.5,
  "section": "궁금해요",
  "sub": "그래서 어항은 투명하고 물에 젖지 않는 유리로 만들어요"
 },
 {
  "t": 35.5,
  "end": 38.6,
  "section": "물체와 물질",
  "sub": "물체는 쓰임새와 모양이 있는 것이에요"
 },
 {
  "t": 38.6,
  "end": 41.53,
  "section": "물체와 물질",
  "sub": "물질은 물체를 만드는 재료예요"
 },
 {
  "t": 41.53,
  "end": 47.8,
  "section": "물체와 물질",
  "sub": "캔은 금속, 주걱은 나무로 만들었어요"
 },
 {
  "t": 47.8,
  "end": 54.4,
  "section": "물체와 물질",
  "sub": "블록은 플라스틱, 주전자는 유리로 만들었어요"
 },
 {
  "t": 54.4,
  "end": 65.27,
  "section": "실험해요",
  "sub": "모양과 크기는 같고 물질만 다른 막대 네 개"
 },
 {
  "t": 65.27,
  "end": 69.33,
  "section": "실험해요",
  "sub": "종이 위에 막대를 올리면 글씨가 보일까요?"
 },
 {
  "t": 69.33,
  "end": 74.33,
  "section": "실험해요",
  "sub": "글씨가 보이는 막대는?"
 },
 {
  "t": 74.33,
  "end": 82.67,
  "section": "실험해요",
  "sub": "유리 막대만 글씨가 보여요 — 투명해요"
 },
 {
  "t": 82.67,
  "end": 88.23,
  "section": "실험해요",
  "sub": "사포로 막대 표면을 같은 힘으로 5번 긁어요"
 },
 {
  "t": 88.23,
  "end": 93.23,
  "section": "실험해요",
  "sub": "긁히지 않는 막대는?"
 },
 {
  "t": 93.23,
  "end": 97.9,
  "section": "실험해요",
  "sub": "나무·유리·플라스틱은 긁힌 자국이 생겼어요"
 },
 {
  "t": 97.9,
  "end": 103.9,
  "section": "실험해요",
  "sub": "철 막대는 긁히지 않아요 — 단단해요"
 },
 {
  "t": 103.9,
  "end": 110.17,
  "section": "실험해요",
  "sub": "물에 넣으면 뜰까요, 가라앉을까요?"
 },
 {
  "t": 110.17,
  "end": 115.17,
  "section": "실험해요",
  "sub": "물에 뜨는 막대는?"
 },
 {
  "t": 115.17,
  "end": 122.03,
  "section": "실험해요",
  "sub": "나무·플라스틱은 물에 뜨고, 철·유리는 가라앉아요"
 },
 {
  "t": 122.03,
  "end": 125.33,
  "section": "실험해요",
  "sub": "실험 결과를 표로 정리해요"
 },
 {
  "t": 125.33,
  "end": 131.8,
  "section": "실험해요",
  "sub": "모양과 크기가 같아도 물질마다 성질이 달라요"
 },
 {
  "t": 131.8,
  "end": 135.5,
  "section": "정리해요",
  "sub": "우리 주변의 여러 가지 물질과 그 성질"
 },
 {
  "t": 135.5,
  "end": 142.33,
  "section": "정리해요",
  "sub": "금속은 단단해서 망치를, 유리는 투명해서 창문을 만들어요"
 },
 {
  "t": 142.33,
  "end": 149.23,
  "section": "정리해요",
  "sub": "물체를 이루는 재료를 물질이라 하고, 성질이 다양해요"
 },
 {
  "t": 149.23,
  "end": 155.83,
  "section": "생각 바로잡기",
  "sub": "투명한 것은 모두 유리일까요? 아니에요"
 },
 {
  "t": 155.83,
  "end": 163.97,
  "section": "생각 바로잡기",
  "sub": "플라스틱은 모두 물에 뜰까요? 아니에요"
 },
 {
  "t": 163.97,
  "end": 171.53,
  "section": "확인해요",
  "sub": "㈎ 망치와 집게는 어떤 물질로 만들었을까요?"
 },
 {
  "t": 171.53,
  "end": 176.53,
  "section": "확인해요",
  "sub": "망치를 금속으로 만들면 좋은 점은?"
 },
 {
  "t": 176.53,
  "end": 184.33,
  "section": "확인해요",
  "sub": "금속은 단단해서 못을 박아도 잘 부러지지 않아요"
 },
 {
  "t": 184.33,
  "end": 190.21,
  "section": "마무리",
  "sub": "물체를 이루는 재료를 물질이라고 하고, 물질마다 성질이 서로 달라요"
 },
 {
  "t": 190.21,
  "end": 197.43,
  "section": "마무리",
  "sub": "다음 영상: 3학년 21화 · 같은 물질로 된 물체를 찾아라"
 }
]