[
 {
  "t": 0.0,
  "end": 5.47,
  "section": "오프닝",
  "sub": "「과학 원리 돋보기」 3학년 20화: 물체와 물질은 무엇이 다를까?"
 },
 {
  "t": 5.47,
  "end": 9.87,
  "section": "궁금해요",
  "sub": "유리로 만든 어항이에요"
 },
 {
  "t": 9.87,
  "end": 14.07,
  "section": "궁금해요",
  "sub": "어항을 나무로 만들면 어떤 점이 불편할까요?"
 },
 {
  "t": 14.07,
  "end": 19.07,
  "section": "궁금해요",
  "sub": "나무 어항은 무엇이 불편할까요?"
 },
 {
  "t": 19.07,
  "end": 24.47,
  "section": "궁금해요",
  "sub": "안이 보이지 않고, 오래 쓰면 젖어 썩을 수 있어요"
 },
 {
  "t": 24.47,
  "end": 32.53,
  "section": "궁금해요",
  "sub": "그래서 어항은 투명하고 물에 젖지 않는 유리로 만들어요"
 },
 {
  "t": 32.53,
  "end": 35.73,
  "section": "물체와 물질",
  "sub": "물체는 쓰임새와 모양이 있는 것이에요"
 },
 {
  "t": 35.73,
  "end": 38.6,
  "section": "물체와 물질",
  "sub": "물질은 물체를 만드는 재료예요"
 },
 {
  "t": 38.6,
  "end": 44.13,
  "section": "물체와 물질",
  "sub": "캔은 금속, 주걱은 나무로 만들었어요"
 },
 {
  "t": 44.13,
  "end": 50.0,
  "section": "물체와 물질",
  "sub": "블록은 플라스틱, 주전자는 유리로 만들었어요"
 },
 {
  "t": 50.0,
  "end": 58.67,
  "section": "실험해요",
  "sub": "모양과 크기는 같고 물질만 다른 막대 네 개"
 },
 {
  "t": 58.67,
  "end": 62.87,
  "section": "실험해요",
  "sub": "종이 위에 막대를 올리면 글씨가 보일까요?"
 },
 {
  "t": 62.87,
  "end": 67.87,
  "section": "실험해요",
  "sub": "글씨가 보이는 막대는?"
 },
 {
  "t": 67.87,
  "end": 75.2,
  "section": "실험해요",
  "sub": "유리 막대만 글씨가 보여요 — 투명해요"
 },
 {
  "t": 75.2,
  "end": 79.93,
  "section": "실험해요",
  "sub": "사포로 막대 표면을 같은 힘으로 5번 긁어요"
 },
 {
  "t": 79.93,
  "end": 84.93,
  "section": "실험해요",
  "sub": "긁히지 않는 막대는?"
 },
 {
  "t": 84.93,
  "end": 89.33,
  "section": "실험해요",
  "sub": "나무·유리·플라스틱은 긁힌 자국이 생겼어요"
 },
 {
  "t": 89.33,
  "end": 94.33,
  "section": "실험해요",
  "sub": "철 막대는 긁히지 않아요 — 단단해요"
 },
 {
  "t": 94.33,
  "end": 99.87,
  "section": "실험해요",
  "sub": "물에 넣으면 뜰까요, 가라앉을까요?"
 },
 {
  "t": 99.87,
  "end": 104.87,
  "section": "실험해요",
  "sub": "물에 뜨는 막대는?"
 },
 {
  "t": 104.87,
  "end": 111.13,
  "section": "실험해요",
  "sub": "나무·플라스틱은 물에 뜨고, 철·유리는 가라앉아요"
 },
 {
  "t": 111.13,
  "end": 114.53,
  "section": "실험해요",
  "sub": "실험 결과를 표로 정리해요"
 },
 {
  "t": 114.53,
  "end": 120.47,
  "section": "실험해요",
  "sub": "모양과 크기가 같아도 물질마다 성질이 달라요"
 },
 {
  "t": 120.47,
  "end": 124.33,
  "section": "정리해요",
  "sub": "우리 주변의 여러 가지 물질과 그 성질"
 },
 {
  "t": 124.33,
  "end": 130.53,
  "section": "정리해요",
  "sub": "금속은 단단해서 망치를, 유리는 투명해서 창문을 만들어요"
 },
 {
  "t": 130.53,
  "end": 136.93,
  "section": "정리해요",
  "sub": "물체를 이루는 재료를 물질이라 하고, 성질이 다양해요"
 },
 {
  "t": 136.93,
  "end": 142.33,
  "section": "생각 바로잡기",
  "sub": "투명한 것은 모두 유리일까요? 아니에요"
 },
 {
  "t": 142.33,
  "end": 149.4,
  "section": "생각 바로잡기",
  "sub": "플라스틱은 모두 물에 뜰까요? 아니에요"
 },
 {
  "t": 149.4,
  "end": 155.93,
  "section": "확인해요",
  "sub": "㈎ 망치와 집게는 어떤 물질로 만들었을까요?"
 },
 {
  "t": 155.93,
  "end": 160.93,
  "section": "확인해요",
  "sub": "망치를 금속으로 만들면 좋은 점은?"
 },
 {
  "t": 160.93,
  "end": 168.07,
  "section": "확인해요",
  "sub": "금속은 단단해서 못을 박아도 잘 부러지지 않아요"
 },
 {
  "t": 168.07,
  "end": 172.57,
  "section": "마무리",
  "sub": "물체를 이루는 재료를 물질이라고 하고, 물질마다 성질이 서로 달라요"
 },
 {
  "t": 172.57,
  "end": 178.53,
  "section": "마무리",
  "sub": "다음 영상: 3학년 21화 · 같은 물질로 된 물체를 찾아라"
 }
]